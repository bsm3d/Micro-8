

//complex sound example synthesis (no filter)
synInit(0);

poke(0x111c,peek(0x111c) | 0b00000001);//lfo0 modulated by inverse envelope0
poke(0x1110,peek(0x1110) | 0b00000100);//sync on

synEnv(0,10,12,13,15);//id, A, D, S, R
synLFO(0,3,6,7);//id, waveform, freq, amp

synVoice(0,1,3,0b11,15);//triangle

synNoteOn(0,69,128);

nat start=_time;
while( (_time-start)<2 ){} //wait a few sec

synNoteOff(0);


