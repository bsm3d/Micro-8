
//drum box example using the built-in mini synth

synInit(0);

synVoice(0,3,0,0b11,15);//dpcm
synVoice(1,3,0,0b11,15);//dpcm

byte track0[16]={	0,0, 0, 0, 5, 0, 0, 0,0,0, 0, 0, 8, 8, 0, 8};
byte track1[16]={	2,10,10,10,10,10,10,2,2,10,10,10,10,10,10,12};

void play(byte voice, byte note)
{
	if(note != 0)
	{
		synNoteOff(voice);
		synNoteOn(voice, note-1,128);
	}
}

byte frame;//we use the frame as a time reference
byte tick;
while(_keyDwn != 12)
{
	if(frame%8==0)
	{
		play(0,track0[tick]);
		play(1,track1[tick]);
		tick++;
		if(tick==16) tick=0;
	}
	vSync();
	frame++;
}


