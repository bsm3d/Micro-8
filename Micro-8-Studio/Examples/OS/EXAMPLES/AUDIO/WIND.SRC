

//producing wind with the built-in synth and a hi-pass filter

synInit(0);

synEnv(0,15,15,15,15);//voice, A, D, S, R
synLFO(0,3,0,7);//id, waveform, freq, amp
synFilter(true,1,3);//filter on, mode:hi-pass, cutoff control:LFO0
poke(0x111e,128);//filter resonance
synVoice(0,2,5,0b11,15);//voice, waveform, octave, pan, volume

synNoteOn(0,69,128);//voice, note, velocity

nat start=_time;
while( (_time-start)<6 ){} //wait a few secs

synNoteOff(0);
