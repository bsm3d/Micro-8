
//Passing array(s) to function

//Arrays are passed as references, modifying the array in the function
//will modify the original array.

memSet(0x1200,3200,' ');//clear text


int a[2]={3,4};
int b[2]={5,6};

void f(int i[], int j[])
{
	j[0]+=i[0];
	j[1]+=i[1];
}

f(a,b);

print(b[0],",",b[1]);//8,10





