// navegame.cpt by ROSOGON 2025
//
// This is a reimplementation of a simple game for two players
// that my cousin and me made in AMSTRAD's BASIC when we were kids.
//
// You must kill you opponent 10 times. But beware of overloading your 
// laser or you will explode!
//
// B button: Shoot
// A button: Turbo (disables laser)
//
// For more fun, set SHOW_LASER to false
//
//
// Sprites are organized the following way:
// Ship (starting from SHIP_REF):
// 0: normal left 1
// 1: normal left 2
// 2: normal up 1
// 3: normal up 2
// 4: fire left (on top of normal)
// 5: fire up   (on top of normal)
//
// Boom (starting from BOOM_REF), 8 sprites
// 
// Sprite IDs are:
// 0: ship player 0
// 1: ship player 1
// 2: fire ship player 0
// 3: fire ship player 1
//

bool DEBUG = false;
bool SHOW_LASER = true;
bool SHOW_FIRE_SHIP = true;

// Status
byte ST_DEAD  = 0;
byte ST_ALIVE = 0b01;
byte ST_SHOT  = 0b10;  // player has shot

// Sides in player_t.dir
byte LEFT	= 0;
byte RIGHT	= 1;
byte UP		= 2;
byte DOWN	= 3;

// Sprite sizes
byte SPR_W = 24;
byte SPR_H = 21;

// Refs to sprites
byte SHIP_REF = 0; // Ref of first ship sprite
byte FIRE_REF = 4; // Ref of first fire ship sprite
byte BOOM_REF = 7; // Ref of first boom sprite

// Lenghts of animations.
// The shown ref depends on players' spr_seq
// and we want the ref to increase after n cycles.
// I.e. ref = start_ref + (spr_seq) / n
// Management of this is hardcoded below.
// ship animation: n = 4
// boom animation: n = 16
byte SHIP_LEN = 2; // Len of ship animation
byte BOOM_LEN = 8; // Len of boom animation

// Screen coords
int MINX = 48;
int MAXX = 824;
int MINY = 42;
int MAXY = 500;

// Deltas
int DX = 5;
int DY = 5;
int DSHOT = 12;
int DLOAD = 2;

byte MAX_LIVES    = 10;
byte MAX_OVERLOAD = 40;

// Pad masks
byte PAD_RIGHT	= 0x80;
byte PAD_LEFT	= 0x40;
byte PAD_DOWN	= 0x20;
byte PAD_UP		= 0x10;
byte PAD_B		= 0x02;
byte PAD_A		= 0x01;

// Memory stuff
nat cpuWindow = 0x3000;
nat gfxReg = 0x2f00;
nat sprPLA = 0x11d0;
nat sprPLB =  0x2fa0;
byte sprPage = 0x20;


// game mode: 0=playing round, 1=round end, 2=game end
byte mode;

type player_t {
	byte id;      // player id: 0, 1
	int x;        // x coord
	int y;        // y coord
	byte dir;     // direction: LEFT, RIGHT, UP, DOWN
	byte lives;   // lives counter: 0..MAX_LIVES
	int overload; // overload counter: 0..MAX_OVERLOAD
	byte status;  // players status: ST_DEAD, ST_ALIVE, ST_SHOT
	byte spr_seq; // sequence counter: shown sprite is function of this
};


player_t players[2];

type line_t {
	int x1; 
	int y1;
	int x2;
	int y2;
};

line_t lasers[2];  // keep lasers so can be removed in next cycle


void cls() {
	memSet(0x1200,3200,' ');
	memSet(cpuWindow, 48000, 0, 0x60);
	for (byte i; i < 32; i++)
		sprPos(i, 0, 0);
	sprUpdt();
}

void init() {
	import("sprites/navegame.spr",cpuWindow, 0, sprPage);
	import("sprites/navegame.pla", sprPLA, 48);
	import("sprites/navegame.plb", sprPLB, 48);

	poke(gfxReg,peek(gfxReg)|0b00000101);

	synInit(0);
	poke(0x111c, peek(0x111c) | 0b00000001);
	poke(0x1110, peek(0x1110) | 0b00000100);
	synEnv(0, 10, 12, 13, 15);
	synLFO(0, 3, 6, 7);
	synVoice(0, 2, 3, 0b11, 15);
	
	players[0].id = 0;
	players[1].id = 1;
	players[0].lives = MAX_LIVES;
	players[1].lives = MAX_LIVES;
}

void new_round() {
	players[0].x = MINX + 50;
	players[0].y = MINY + 50;
	players[1].x = MAXX - 50;
	players[1].y = MAXY - 50;
	for (byte i; i < 2; i++) {
		players[i].status = ST_ALIVE;
		players[i].overload = 0;
		players[i].spr_seq = 0;
		players[i].dir = 1 - i;

		// normal sprite
		sprRef(i, SHIP_REF);
		sprPal(i, i);
		sprPos(i, players[i].x, players[i].y);
		
		// fire-ship sprite
		sprRef(2 + i, FIRE_REF);
		sprPal(2 + i, i);
		sprPos(2 + i, 0, 0);
	}
	vSync();
	sprUpdt();
}

int clampx(int x) {
	return clamp(x, MINX, MAXX - SPR_W);
}

int clampy(int y) {
	return clamp(y, MINY, MAXY - SPR_H);
}

void handle_dead(byte id)
{
	if (players[id].spr_seq == 0x20)
		synNoteOff(0);
	players[id].spr_seq = (players[id].spr_seq + 1) & 0x7F;
}


void handle_alive(byte id) {

	byte pad;
	if (id == 0) { pad = _padLft; } else { pad = _padRght; }

	players[id].status = (players[id].status & ~ST_SHOT);
	int dx;
	int dy;
	int speed = (pad & PAD_A) + 1;

	if (pad & PAD_LEFT) {
		dx = -DX;
		players[id].dir = LEFT;
	} else if (pad & PAD_RIGHT) {
		dx = DX;
		players[id].dir = RIGHT;
	} else if (pad & PAD_UP) {
		dy = -DY;
		players[id].dir = UP;
	} else if (pad & PAD_DOWN) {
		dy = DY;
		players[id].dir = DOWN;
	}

	if (mode == 0 && (pad & PAD_B) && speed == 1) {
		players[id].status = players[id].status | ST_SHOT;
		players[id].overload += DLOAD;
	} else {
		int overload = clamp(players[id].overload - 1, 0, MAX_OVERLOAD);
		players[id].overload = overload;
	}
	int x = clampx(players[id].x + dx * speed);
	int y = clampy(players[id].y + dy * speed);
	players[id].x = x;
	players[id].y = y;

	players[id].spr_seq = (players[id].spr_seq + 1) & 0x07;
}

void die(byte id)
{
	if (players[id].status != ST_DEAD) {
		players[id].status = ST_DEAD;
		players[id].lives -= 1;
		players[id].spr_seq = 0;
	}
}

bool check_line(int p[], int q[], byte axis, byte side)
{
	byte orth = axis ^ 0b1;
	int d_axis = q[axis] - p[axis];
	int d_orth = q[orth] - p[orth];
	
	int f = ((side & 1) << 1) - 1;  // L|U:-1 R|D:1
	
	return abs(d_orth) <= DSHOT && f * d_axis > 0;
}

int check_dead(byte id)
{
	return (players[id].spr_seq == 0x7F);
}


int check_alive(byte id)
{
	byte other = id ^ 0b1;
	bool other_alive = (bool)(players[other].status & ST_ALIVE);

	if (players[id].overload > MAX_OVERLOAD) {
		die(id);
		return 1;
	} else if (other_alive && isSprSpr(0, 1)) {
		die(id);
		die(other);
		return 1;
	} else if (players[id].status & ST_SHOT) {
		int p[2] = { players[id].x, players[id].y };
		int q[2] = { players[other].x, players[other].y };

		byte axis = players[id].dir >> 1;
		if (check_line(p, q, axis, players[id].dir)) {
			die(other);
			return 1;
		}
	}
	return 0;
}

void line_from(byte id)
{
	int len[2] = {400, 240};

	player_t p = players[id];
	byte axis = p.dir >> 1;
	byte face = p.dir & 1;
	byte orth = axis ^ 1;
	
	int start[2] = {(p.x - SPR_W) >> 1, (p.y - SPR_H) >> 1};
	int end[2];
	end[axis] = len[axis] * face;
	end[orth] = start[orth];
	
	line_t result = {start[0], start[1], end[0], end[1]};
	lasers[p.id] = result;
}

void draw_laser(line_t l, byte color)
{
	line(l.x1, l.y1, l.x2, l.y2, color);
}

void refresh(player_t p)
{
	byte ref = 0;
	bool flip = false;
	bool alive = (bool)(p.status & ST_ALIVE);
	byte axis = p.dir >> 1;
	
	if (alive) {
		ref = SHIP_REF + (axis << 1) + (p.spr_seq >> 2);
		flip = (bool) (p.dir & 1);
	} else {
		ref = BOOM_REF + (p.spr_seq >> 4);
	}

	sprRef(p.id, ref);
	sprFlip(p.id, flip, flip);
	sprPos(p.id, p.x, p.y);

	if (SHOW_LASER) {
		draw_laser(lasers[p.id], 0);
		if (p.status & ST_SHOT) {
 			line_from(p.id);
			draw_laser(lasers[p.id], 2);
		}
	}
	
	if (SHOW_FIRE_SHIP) {
		byte id = (2 | p.id);
		sprRef(id, SHIP_REF + (FIRE_REF | axis));
		sprFlip(id, flip, flip);
		if (alive && (p.status & ST_SHOT))
			sprPos(id, p.x, p.y);
		else
			sprPos(id, 0, 0);
	}
}

void debug()
{
	curPos(35, 0);
	print(mode);
	for (byte id; id < 2; id++) {
		curPos(id * 70, 0);
		print(id);
		curPos(id * 70, 1);
		print(players[id].status);
		curPos(id * 70, 2);
		print(players[id].overload, "  ");
		curPos(id * 70, 3);
		print(players[id].lives, " ");
		curPos(id * 70, 4);
		print(players[id].spr_seq, "   ");
	}
}

// Dispatches the appropriate handling logic based on player status.
void handle(byte id)
{
	if (players[id].status & ST_ALIVE)
		handle_alive(id);
	else
		handle_dead(id);
}

// Dispatches the appropriate check logic based on player status.
int check(byte id)
{
	int result;
	if (players[id].status & ST_ALIVE)
		result = check_alive(id);
	else
		result = check_dead(id);
	return result;
}

// The main game frame logic.
// Updates player states, checks for round/game end transitions, 
// and refreshes visuals.
void loop() {
	handle(0);
	handle(1);
	
	if (check(0) | check(1)) {
		if (mode == 0) {
			synNoteOn(0, 70, 128);
			mode = 1;
		} else if (players[0].lives == 0 || players[1].lives == 0) {
			mode = 2;
		} else {
			mode = 0;
			new_round();
		}
	}
	if (DEBUG) debug();
	refresh(players[0]);
	refresh(players[1]);
}

init();
cls();

mode = 0;
new_round();

while (_keyDwn != 12 && mode != 2) {
	loop();
	vSync();
	sprUpdt();
}
