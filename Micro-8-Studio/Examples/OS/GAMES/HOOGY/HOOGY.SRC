// Params for the setTiles function
// Ugly but to avoid stack use for speed optimization
byte st_band;
byte st_origX;
byte st_origY;
byte st_dstWidth;
byte st_dstHeight;
nat st_contentAdr;
byte st_srcHeight;
// Draw tiles in drawing tiles buffer for band st_band
void setTiles() {
	nat tileAdr;

	if (tileDisplayBuf[st_band]==tilBufA)
		tileAdr=tilBufB;
	else
	tileAdr=tilBufA;

	nat baseDst = tileAdr + st_origX + (st_origY<<5);
	byte x;
	nat src=st_contentAdr;

	for(x=0;x<st_dstWidth;x++) {      
		nat dst = baseDst + x;
		byte y;
		nat src2=src;
		for(y=0;y<st_dstHeight;y++) {
			poke(dst,peek(src2),tilPage);
			src2++;
			dst+=32;
		}
		src+=st_srcHeight;
	}
}


// Swap the tiles buffer for this band
// Set offset to 0
void swapBufferTiles(byte band) {	

	nat status;
	nat offs;
	
	if (rasterlistAddr == &rasterlistA) {
		status = statusAddrA[band];
		offs = offsAddrA[band];
	} else {
		status = statusAddrB[band];
		offs = offsAddrB[band];
	}

	tileHOfs[band]=0;
	poke(offs,0); // Reset the offset
	if (tileDisplayBuf[band]==tilBufA) {
		// This should work, but don't !

		//poke(status-3,OR);
		//poke(status,0b00000100);
		
		poke(status,4);
		
		tileDisplayBuf[band]=tilBufB;
	} else {
		// This should work, but don't !

		//poke(status-3,AND);
		//poke(status,0b11111011);		
		
		poke(status,0);
		
		tileDisplayBuf[band]=tilBufA;
	}
}


// Scroll tiles of one band
byte mt_band;
nat mt_speed;

bool moveTiles() {
	nat offs;
	
	// Return true if h scroll has ended

	if (rasterlistAddr == &rasterlistA) 
		offs = offsAddrA[mt_band];
	else offs = offsAddrB[mt_band];

	tileHOfs[mt_band]+=mt_speed;
	poke(offs,(byte)(tileHOfs[mt_band]/100));
	if ((tileHOfs[mt_band]+mt_speed)>3100) 
		return true;
	return false;
}


/////// NOTIFY FUNCTIONS //////
// Used in path functions and anim functions
/////////////////////////////

nat sprNotifyAdr[32];

void sprNInit() {
	memSet(&sprNotifyAdr[0],64,0);
}

void sprNActivate(byte spId,nat adr) {
	sprNotifyAdr[spId]=adr;
	if (adr>0)
		poke(adr,0);
}

void sprNSet(byte spId,byte v) {
	if (sprNotifyAdr[spId]>0)
		poke(sprNotifyAdr[spId],v);
}


