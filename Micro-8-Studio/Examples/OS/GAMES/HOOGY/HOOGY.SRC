/////////// MISC FUNCTIONS //////////////////


void cls() {
	memSet(0x1200,3200,32); //clear screen content
	memSet(0x1e80,3200,1); //clear screen colors
}

void sleep(nat msec) {
	clkSet();
	while(_mSec<msec){}
}

void pause(bool enable) {
	if (enable==true || _keyDwn == 66) {
		nat sec=_time;
		sleep(300);
		while(_keyDwn==0) {}
		sleep(150);
	}
}


void int2Txt(nat val,byte n) {
byte index;
byte i;

nat div=10;

	for(i=0;i<(n-2);i++) 
		div=div*10;
	for(i=0;i<n;i++) {
		index = 48+(byte)((val/div)%10);
		poke(&i2t+i,index);
		div/=10;
	}
	poke(&i2t+i,0);
}


void scorePrint() {
	for(byte i;i<6;i++) {
		print(sco[i]);
	}
}


void scoreAdd(nat value) {
    byte d[5];
    nat t;

    t=value;

    d[4]=(byte)(t%10);
    t=t/10;
    d[3]=(byte)(t%10);
    t=t/10;
    d[2]=(byte)(t%10);
    t=t/10;
    d[1]=(byte)(t%10);
    t=t/10;
    d[0]=(byte)(t);

    sco[5]=sco[5]+d[4];
    sco[4]=sco[4]+d[3];
    sco[3]=sco[3]+d[2];
    sco[2]=sco[2]+d[1];
    sco[1]=sco[1]+d[0];

    if (sco[5]>=10) {
        sco[5]=sco[5]-10;
        sco[4]=sco[4]+1;
    }

    if (sco[4]>=10) {
        sco[4]=sco[4]-10;
        sco[3]=sco[3]+1;
    }

    if (sco[3]>=10) {
        sco[3]=sco[3]-10;
        sco[2]=sco[2]+1;
    }

    if (sco[2]>=10) {
        sco[2]=sco[2]-10;
        sco[1]=sco[1]+1;
    }

    if (sco[1]>=10) {
        sco[1]=sco[1]-10;
        sco[0]=sco[0]+1;
    }

    if (sco[0]>=10) {
        sco[0]=9;  
	}		
}


void clearSprites() {
	for (byte i=0;i<32;i++) {
		sprPos(i,0,0);
		sprFlip(i,false,false);
		sprPrio(i,0);
	}
	sprUpdt();
}

void clearTiles(){
	memSet(tilBufA,512,0);//Clear tiles buffer A
	memSet(tilBufB,512,0);//Clear tiles buffer B
}

void clearTileSet(){
	memSet(cpuWindow,32768,0,0);//Clear tileset
}


void clearBitMap(){
	memSet(cpuWindow,48000,0,bmpPageA);
	memSet(cpuWindow,48000,0,bmpPageB);
}


