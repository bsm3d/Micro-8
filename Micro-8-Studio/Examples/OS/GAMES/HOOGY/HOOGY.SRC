type _pm_tSprite {
	int X;
	int Y;
	int origX;
	int origY;
	int minX;
	int minY;
	int maxX;
	int maxY;
	byte speed;
	int speedX;
	int speedY;
	nat pathAddr;
	nat pathLength;
	int cnt;
	byte repeatCnt;
	byte repeatDirection;
	byte loop; // 0:no loop, 1:return 2:infinite 3:restart 4:restart from current pos
	int inc;
	bool removeAtEnd;
	bool running;
	bool altAnimAtEnd;
};

_pm_tSprite PMpath[32]; // 32 paths max

type tSprAnim {
	byte alt;
	
	nat nWait;
	nat cnt;
	nat refArrayAdr;
	byte nElem;
	byte currElem;

	nat nWaitAlt;
	nat cntAlt;
	nat refArrayAdrAlt;
	byte nElemAlt;
	byte currElemAlt;
	bool altRemove;

};

tSprAnim sprAnim[32];

byte sprRefs1[2]={0,1};
byte sprRefs2[2]={2,3};
byte sprRefs3[2]={5,6};
byte sprRefs4[2]={7,8};
