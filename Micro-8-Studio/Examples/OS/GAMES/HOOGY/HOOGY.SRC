void talk(text filename) {
	vSync();
	import(filename,0x3000,0,bmpPageA);
	ymInit(0);
	ymVol(127);
	ymSetReg(0,0x2b,128);
	for(nn=0;nn<_fSize;nn++) {
		ymSetReg(0,0x2a,peek(0x3000+nn,bmpPageA));
	}
	ymSetReg(0,0x2b,0);
}
////////////////////////////////////////
////// MAIN FUNCTION
////////////////////////////////////////

void main() {
	
	nat timer;
	nat timerDiff;
	bool collide;
		
	// Starting
	bool stop=false;
	import("/system/reginit.dat",0x1100,0);
	poke(gfxModes,0);
	cls();
	clearSprites();
	clearTiles();
	clearTileSet();
	clearBitMap();	

	// Black background
	byte oldR=peek(0x2f13);
	byte oldG=peek(0x2f14);
	byte oldB=peek(0x2f15);
	poke(0x2f13,0);
	poke(0x2f14,0);
	poke(0x2f15,0);
	poke(statusReg,peek(0x2f0b)&0b01111111);// No mouse


	ymInit(0);
	ymVol(127);
	ymLoad("res/laser1.ins",0);
	ymVoice(0,0,3,0b11,127); // Player's laser
	ymVoice(1,0,1,0b11,127); // Alien shooting
	ymVoice(2,0,5,0b11,127); // Bonus
	
	synInit(0);
	synEnv(0,2,12,0,15);
	synVoice(0,2,1,0b11,15);
	

	// Started


	// Load sprites
	import("res/spr.spr",cpuWindow,0,sprPage);
	import("res/spr.pla",sprPlaA,48);

	// "Text" sprites. Will use second palette
	import("res/sprtxt.pal",sprPlaB,48);
	import("res/sprtxt.bmp",cpuWindow,48000,bmpPageA);
	bmpToSpr(0,0,9,4,40);
	sprPal(0,1);
	sprPal(1,1);
	sprPal(2,1);
	sprPal(3,1);
	sprPal(28,1);
	sprPal(29,1);


	// Initialize path manager
	import("res/pathC1.pth",&pathCircle1,150);
	import("res/pathC2.pth",&pathCircle2,98);
	import("res/pathE1.pth",&pathElliptic1,381);
	import("res/pathE2.pth",&pathElliptic2,523);
	import("res/pathE3.pth",&pathElliptic3,687);
	import("res/pathE4.pth",&pathElliptic4,481);
	import("res/pathE5.pth",&pathElliptic5,589);
	import("res/pathE6.pth",&pathElliptic6,524);
	import("res/pathH1.pth",&pathH1,163);
	import("res/pathH2.pth",&pathH2,70);
	import("res/pathH3.pth",&pathH3,156);
	

	while(true) {

		// Initialize sprite pattern animation
		sprAInit();

		// Sprites:
		// 31:player
		// 30: guy to rescue
		// 0-3: text sprites 
		// 4-6: alien's bullets
		// 8-12: points
		// 13-15: aliens type 1 (3)
		// 16-18: aliens type 2 (3)
		// 19-21: aliens type 3 (3)
		// 22: square 1 fuel
		// 23: square 2
		// 24: square 3
		// 25: heart
		// 26: clover
		// 27: trophy
		// 28-29: text sprites
	
		sprAStart(31,5,&sprRefs1,2,1,&sprRefs12,3);//player
		sprAStart(30,1,&sprRefs13,2,0,0,0);//guy to rescue
		sprAStart(4,2,&sprRefs2,2,1,&sprRefs12,2);//alien's bullet
		sprAStart(5,2,&sprRefs2,2,1,&sprRefs12,2);//alien's bullet
		sprAStart(6,2,&sprRefs2,2,1,&sprRefs12,2);//alien's bullet
		sprAStart(13,1,&sprRefs7,2,1,&sprRefs12,2);//alien type 1
		sprAStart(14,1,&sprRefs7,2,1,&sprRefs12,2);//alien type 1
		sprAStart(15,1,&sprRefs7,2,1,&sprRefs12,2);//alien type 1
		sprAStart(16,1,&sprRefs8,2,1,&sprRefs12,2);//alien type 2
		sprAStart(17,1,&sprRefs8,2,1,&sprRefs12,2);//alien type 2
		sprAStart(18,1,&sprRefs8,2,1,&sprRefs12,2);//alien type 2
		sprAStart(19,1,&sprRefs9,2,1,&sprRefs12,2);//alien type 3
		sprAStart(20,1,&sprRefs9,2,1,&sprRefs12,2);//alien type 3
		sprAStart(21,1,&sprRefs9,2,1,&sprRefs12,2);//alien type 3
		sprAStart(22,2,&sprRefs3,2,0,0,0);//square 1
		sprAStart(23,2,&sprRefs4,2,0,0,0);//square 2
		sprAStart(24,2,&sprRefs5,2,0,0,0);//square 5
		sprAStart(25,2,&sprRefs6,2,0,0,0);//heart
		sprAStart(26,2,&sprRefs10,2,0,0,0);//clover
		sprAStart(27,2,&sprRefs11,2,0,0,0);//ice
	

		cls();
		clearSprites();
		poke(gfxModes,0b00011100); // text tiles sprites

		sprPInit();

		while (true) {
			ii=showIntro();
			if (ii!=2) break;
		}

		clearSprites();

		// ESC was pressed : exit
		if (ii==1)
			break;


		// Load game tiles
		import("res/floor.tls",cpuWindow,0,tilPage);
		import("res/bg.tls",cpuWindow+1536,0,tilPage);
		import("res/tiles.pal",tilPal,48);

		// Init game parameters
		initLevel();

		// Initialize sprite notifications
		sprNInit();

		// Set floor/tunnel
		floorInit(tilesFull,2);
		floorGenerateInit();
		floorGenerate(tilesEmpty,3,tilesFull,2,tilesFullU,1,tilesFullD,1);

		// Tunnel tiles
		st_band=0;
		st_origX=0;
		st_origY=10;
		st_dstWidth=26;
		st_dstHeight=5;
		st_contentAdr=&_floor;
		st_srcHeight=5;
		setTiles();

		// Background tiles
		st_band=1;
		st_origX=0;
		st_origY=0;
		st_dstWidth=26;
		st_dstHeight=4;
		st_contentAdr=&bgTilesBand1;
		st_srcHeight=4;
		setTiles();

		st_band=2;
		st_origX=0;
		st_origY=4;
		st_dstWidth=26;
		st_dstHeight=3;
		st_contentAdr=&bgTilesBand2;
		st_srcHeight=3;
		setTiles();

		st_band=3;
		st_origX=0;
		st_origY=7;
		st_dstWidth=26;
		st_dstHeight=3;
		st_contentAdr=&bgTilesBand3;
		st_srcHeight=3;
		setTiles();

		
		// At start, tiles buffer A is displayed
		for(byte i;i<4;i++){
			poke(statusAddrA[i],peek(statusReg) & 0b11111011);


		}


		swapBufferTiles(0);
		swapBufferTiles(1);
		swapBufferTiles(2);
		swapBufferTiles(3);

		// For each scrolling "band", next step will be moving offset and start preparing the new buffer
		scrollStep[0]=2;
		scrollStep[1]=2;
		scrollStep[2]=2;
		scrollStep[3]=2;


		//poke(gfxModes,0b00011100); // text tiles  sprites
		//cls();

//curPos(0,37);
//print("2secfuel=",secFuel," secEntry=",secEntry);

		displayScore(true);

		playerInit();
		
		sprNActivate(31,&pl+6);//pl.notify

		rasterTunnel=0;
		cntVblank=0;

		rstrCmp(1,rasterlistAddr);

		rstrInt(true);
		stop=false;
		collide=false;
		timer=0;
		
		/////////////////////////
		////// Main Loop
		/////////////////////////
		
		//sleep(1000);
		vSync();
		talk("res/getready.raw");
		showSprReady();
		while(!stop) {
			if (cntVblank<2) {continue;}
			cntVblank=0;

			clkSet();
			if (_keyDwn==12)
				stop=true;

			if (timer==1) {
				displayScore(false);
				sprARun();
			} else if(timer==2) {
				if (rnd(0,1000)>rndShowAlien) 
					alienStart(rnd(1,3));
				if (rndFireAlien!=2000 && rnd(0,1000)>rndFireAlien) 
					alienFire();
			} else if(timer==3) {
				displayETime();
				pause(false);
			}

			timer++;				
			if (timer==5) timer=0;
			
			sprPRun();
			
			
			// Checks for player's laser collisions
			if (pl.fired==1) {
				int minY = pl.Y-10;
				int maxY = pl.Y+10;
				// sprID 13-15: aliens type 1 (3)
				// sprID 16-18: aliens type 2 (3)
				// sprID 19-21: aliens type 3 (3)
				for(ii=13;ii<22;ii++) {
					if (PMpath[ii].running && PMpath[ii].X>=pl.X && PMpath[ii].Y>=minY && (PMpath[ii].Y<=maxY || (PMpath[ii].Y>=320 && maxY>=320)) ) {
						PMpath[ii].running=false;
						sprAStartAlt(ii,true);
						if (ii>=13 && ii<=15) {
							showPoints(100,(nat)PMpath[ii].X,(nat)PMpath[ii].Y);
							scoreAdd(100);
						} else  if (ii>=16 && ii<=18) {
							showPoints(200,(nat)PMpath[ii].X,(nat)PMpath[ii].Y);
							scoreAdd(200);
						} else {
							showPoints(500,(nat)PMpath[ii].X,(nat)PMpath[ii].Y);
							scoreAdd(500);
						}
						synNoteOff(0);
						synNoteOn(0,110,127);
					}					
				}
			}
			
			// Check for player collision
			// With aliens

			for(ii=13;ii<22;ii++) {
				if (PMpath[ii].running && isSprSpr(31,ii)) {
					fuel-=decFuelCol;
					if (fuel<0) fuel=0;
					poke(0x2f13,7);
					synEnv(1,55,100,0,10);
					synVoice(1,1,3,0b11,15);
					synNoteOff(1);
					synNoteOn(1,60,127);

				}
			}

			// Check for player collision with alien bullet
			for(ii=4;ii<7;ii++) {
				if (PMpath[ii].running && isSprSpr(31,ii)) {
					showSprKilled();
					collide=true;
				}
			} 

			// Check for player collision with "gifts"
			if (PMpath[23].running && isSprSpr(31,23)) {
				showPoints(1000,(nat)PMpath[23].X,(nat)PMpath[23].Y);
				scoreAdd(100);
				PMpath[23].running=false;
				sprPos(23,0,0);
				ymNoteOn(2,20,127);

			}
			if (PMpath[24].running && isSprSpr(31,24)) {
				showPoints(1500,(nat)PMpath[24].X,(nat)PMpath[24].Y);
				scoreAdd(1500);
				PMpath[24].running=false;
				sprPos(24,0,0);
				ymNoteOn(2,20,127);

			}

			// Check for heart collision with guy
			if (PMpath[25].running && PMpath[30].running && isSprSpr(25,30)) {
				showPoints(3000,(nat)PMpath[30].X,(nat)PMpath[30].Y);
				scoreAdd(3000);
				PMpath[25].running=false;
				sprPos(25,0,0);
				PMpath[30].running=false;
				sprPos(30,0,0);
				ymNoteOn(2,10,127);

			}
			
			// Check for collision player-clover (+1 life)
			if (PMpath[26].running && isSprSpr(31,26)) {
				showPoints(10000,(nat)PMpath[26].X,(nat)PMpath[26].Y);
				lives+=1;
				PMpath[26].running=false;
				sprPos(26,0,0);
				ymNoteOn(2,25,127);
			}

			// Check for collision player-ice (no overheat)
			if (PMpath[27].running && isSprSpr(31,27)) {
				noOverheat=20;
				heat=0;
				PMpath[27].running=false;
				sprPos(27,0,0);
				ymNoteOn(2,27,127);
				curPos(58,35);
				print("7‰Š");
				curPos(58,36);
				print("7€2Overheat protection7€");
				curPos(58,37);
				print("7€       2sec left    7€");
				curPos(58,38);
				print("7ˆ‡");
			}
			
			removeLaser();

			if (pl.notify==0) {
				fuel=fuel-decFuel;
				if(fuel<0) fuel=0;
				displayScore(false);

				if (_padLft>=16) {
					if (_padLft & 0b00100000) { playerGoD();}
					else if (_padLft & 0b00010000) { playerGoU();}	
					if (_padLft & 0b10000000) { playerGoR();}
					else if (_padLft & 0b01000000) { playerGoL();}
					if (accl<12) accl++;
				} else accl=1;
				if (pl.Y<340 && pl.fired==0 && _padLft & 0b00000001) playerFire();
				else if ((_padLft & 0b00000001)==0) {
					heat-=decHeat;
					if (heat<0) heat=0;
					pl.fired=0;
				}
				if (pl.Y<340 &&  _padLft & 0b00000010) playerHeart();

				//Player get fuel ?
				if (isSprSpr(31,22)==true) {
					fuel+=5000;
					if (fuel>10000) fuel=10000;
					PMpath[22].running=false;
					sprPos(22,0,0);
					ymNoteOn(2,10,127);

				}

				if (fuel==0 || heat>=10000 || collide==true)
				{
					// player explode
					curPos(58,35);
					print("                     ");
					curPos(58,36);
					print("                     ");
					curPos(58,37);
					print("                     ");
					curPos(58,38);
					print("                     ");

					removeLaser();

					sprNSet(31,2);// notif 2:explode
					sprAStartAlt(31,true);
					
					if (fuel==0)
						showSprOutoffuel();
					else if (heat>=10000)
						showSprOverheat();
					
					lives--;
					if (lives==0) {
						// Game over
						break;
					}
					for(ii=4;ii<22;ii++) {
						PMpath[ii].running=false;
						sprPos(ii,0,0);
					}
					fuel=10000;
					heat=0;
					noOverheat=0;
					collide=false;
					synNoteOff(1);
					synEnv(1,2,12,0,15);
					synVoice(1,2,1,0b11,15);
					synNoteOn(1,98,127);

					}

			} else if (pl.notify==1) {
				playerInit();
			}
			



			
			//curPos(0,38);
			//print("52X=",pl.X," Y=",pl.Y,"    ");
							
		
			vSync();
			
			// Display list swap
			rstrCmp(1,rasterlistAddr);
			if (rasterlistAddr == &rasterlistA) {
				rasterlistAddr=&rasterlistB;
				rasterlistB[4].val = rasterlistA[4].val;
				rasterlistB[5].val = rasterlistA[5].val;
				rasterlistB[9].val = rasterlistA[9].val;
				rasterlistB[10].val = rasterlistA[10].val;
				rasterlistB[14].val = rasterlistA[14].val;
				rasterlistB[15].val = rasterlistA[15].val;
				rasterlistB[19].val = rasterlistA[19].val;
				rasterlistB[20].val = rasterlistA[20].val;
			} else {
				rasterlistAddr=&rasterlistA;
				rasterlistA[4].val = rasterlistB[4].val;
				rasterlistA[5].val = rasterlistB[5].val;
				rasterlistA[9].val = rasterlistB[9].val;
				rasterlistA[10].val = rasterlistB[10].val;
				rasterlistA[14].val = rasterlistB[14].val;
				rasterlistA[15].val = rasterlistB[15].val;
				rasterlistA[19].val = rasterlistB[19].val;
				rasterlistA[20].val = rasterlistB[20].val;
			}
			if (rasterTunnel==1 && pl.notify==0 && pl.Y>340) {
				// We check if player collide with tunnel
				// Check occurs only when "tunnel band" is being draw
				// to be sure that tiles offset and draw buffer are correctly setup
				
				rstrInt(false); 

				byte i;
				if (isSprTile(pl.spId,4,false)==true) {
					collide=true;
				} else if (isSprTile(pl.spId,5,false)==true) {
					collide=true;
				} else if (isSprTile(pl.spId,6,false)==true) {
					collide=true;
				} else if (isSprTile(pl.spId,7,false)==true) {
					collide=true;
				} else if (_flDoorCycle>0 && isSprTile(pl.spId,11,false)==true) {
					collide=true;

				}

				rstrInt(true);
				if (collide)
					showSprCrashed();
			}
			
			

			sprUpdt();

	
			poke(0x2f13,1);

			// Tiles scrolling
			// We proceed by steps to try to save time at each loop
			
			// Floor
			if (scrollStep[0]==0) {
				// Just moving tiles
				mt_band=0;
				mt_speed=220;
				bb=moveTiles();
				if (bb==true) {
					// next step will be swapping buffer
					scrollStep[0]=1;
				}
			} else if (scrollStep[0]==1) {
				// We swap the buffer for this step. Offset will be set to 0
				swapBufferTiles(0);
				// next step will be moving tile and prepare new tile buffer
				scrollStep[0]=2;
			} else if (scrollStep[0]==2) {
				floorGenerateInit();
				scrollStep[0]=3;			
			} else if (scrollStep[0]==3) {
				mt_band=0;
				mt_speed=220;
				moveTiles();
				floorGenerate(tilesEmpty,3,tilesFull,2,tilesFullU,1,tilesFullD,1);
				// next step will be moving tiles and set prepared tiles in the drawing buffer
				scrollStep[0]=4;
			} else {
				mt_band=0;
				mt_speed=220;
				moveTiles();
				st_band=0;
				st_origX=0;
				st_origY=10;
				st_dstWidth=26;
				st_dstHeight=5;
				st_contentAdr=&_floor;
				st_srcHeight=5;
				setTiles();
				// next we just move tiles
				scrollStep[0]=0;
			}
				
			// Sky
			if (scrollStep[1]==0) {
				// Just moving tiles
				mt_band=1;
				mt_speed=100;			
				bb=moveTiles();
				if (bb==true) {
					// next step will be swapping buffer
					scrollStep[1]=1;
				}
			} else if (scrollStep[1]==1) {
				// We swap the buffer for this step. Offset will be set to 0
				swapBufferTiles(1);
				// next step will be moving tile and prepare new tile buffer
				scrollStep[1]=2;
			} else if (scrollStep[1]==2) {
				mt_band=1;
				mt_speed=100;
				moveTiles();
				memCpy(&bgTilesBand1,&scratchPad,4);
				scrollStep[1]=3;
			} else if (scrollStep[1]==3) {
				mt_band=1;
				mt_speed=100;
				moveTiles();
				memCpy(&bgTilesBand1+4,&bgTilesBand1,100);			
				scrollStep[1]=4;
			} else if (scrollStep[1]==4) {
				mt_band=1;
				mt_speed=100;
				moveTiles();
				memCpy(&scratchPad,&bgTilesBand1+100,4);
				scrollStep[1]=5;
				// next step will be moving tiles and set prepared tiles in the drawing buffer
			} else {
				mt_band=1;
				mt_speed=100;			
				moveTiles();
				st_band=1;
				st_origX=0;
				st_origY=0;
				st_dstWidth=26;
				st_dstHeight=4;
				st_contentAdr=&bgTilesBand1;
				st_srcHeight=4;
				setTiles();			
				// next we just move tiles
				scrollStep[1]=0;
			}
				
			// Mountains
			if (scrollStep[2]==0) {
				// Just moving tiles
				mt_band=2;
				mt_speed=130;
				bb=moveTiles();
				if (bb==true) {
					// next step will be swapping buffer
					scrollStep[2]=1;
				}
			} else if (scrollStep[2]==1) {
				// We swap the buffer for this step. Offset will be set to 0
				swapBufferTiles(2);
				// next step will be moving tile and prepare new tile buffer
				scrollStep[2]=2;
			} else if (scrollStep[2]==2) {
				mt_band=2;
				mt_speed=130;
				moveTiles();
				memCpy(&bgTilesBand2,&scratchPad+4,3);
				scrollStep[2]=3;
			} else if (scrollStep[2]==3) {
				mt_band=2;
				mt_speed=130;
				moveTiles();
				memCpy(&bgTilesBand2+3,&bgTilesBand2,75);			
				scrollStep[2]=4;
			} else if (scrollStep[2]==4) {
				mt_band=2;
				mt_speed=130;
				moveTiles();
				memCpy(&scratchPad+4,&bgTilesBand2+75,3);
				scrollStep[2]=5;
				// next step will be moving tiles and set prepared tiles in the drawing buffer
			} else {
				mt_band=2;
				mt_speed=130;
				moveTiles();
				st_band=2;
				st_origX=0;
				st_origY=4;
				st_dstWidth=26;
				st_dstHeight=3;
				st_contentAdr=&bgTilesBand2;
				st_srcHeight=3;
				setTiles();
				// next we just move tiles
				scrollStep[2]=0;
			}

			// Country
			if (scrollStep[3]==0) {
				// Just moving tiles
				mt_band=3;
				mt_speed=180;
				bb=moveTiles();
				if (bb==true) {
					// next step will be swapping buffer
					scrollStep[3]=1;
				}
			} else if (scrollStep[3]==1) {
				// We swap the buffer for this step. Offset will be set to 0
				swapBufferTiles(3);
				// next step will be moving tile and prepare new tile buffer
				scrollStep[3]=2;
			} else if (scrollStep[3]==2) {
				mt_band=3;
				mt_speed=180;
				moveTiles();
				memCpy(&bgTilesBand3,&scratchPad+8,3);
				scrollStep[3]=3;
			} else if (scrollStep[3]==3) {
				mt_band=3;
				mt_speed=180;
				moveTiles();
				memCpy(&bgTilesBand3+3,&bgTilesBand3,75);			
				scrollStep[3]=4;
			} else if (scrollStep[3]==4) {
				mt_band=3;
				mt_speed=180;
				moveTiles();
				memCpy(&scratchPad+8,&bgTilesBand3+75,3);
				scrollStep[3]=5;
				// next step will be moving tiles and set prepared tiles in the drawing buffer
			} else {
				mt_band=3;
				mt_speed=180;
				moveTiles();
				st_band=3;
				st_origX=0;
				st_origY=7;
				st_dstWidth=26;
				st_dstHeight=3;
				st_contentAdr=&bgTilesBand3;
				st_srcHeight=3;
				setTiles();
				// next we just move tiles
				scrollStep[3]=0;
			}
		}
		rstrInt(false);
		poke(0x2f13,1);

		talk("res/gameover.raw");		

		showSprGameover();
		while(PMpath[29].running){
			sprPRun();
			sprARun();
			vSync();
			sprUpdt();
		}
	}
	
	
	
	
	// Exiting

	clearSprites();
	clearTiles();
	clearTileSet();
	clearBitMap();	
	cls();
			
	import("/system/reginit.dat",0x1100,0);
	
	poke(0x2f13,oldR);
	poke(0x2f14,oldG);
	poke(0x2f15,oldB);
	
	print("d                  e6e7e8e9eaebec93eeef");
	print("1Thanks for using  df6f7f8f9fafbfcfdfeff 1computer!");
}

// Start
main();







