///////// FLOOR (TUNNEL) ///////////
// Generate the floor and tunnel in memory
////////////////////////////////////////

// 5 levels of 32 positions (tiles)
byte _floor[160]; 
//idx=pos*5+level[0-4]
byte _flNumLevels=5;
byte _flEntryCnt=0;
byte _flTurnWidth;
byte _flTurnCnt=0;
byte _flTurnDir;
byte _flTunnelCnt=0;
byte _flPosY; // last posy of empty tile
byte _flMaxLengthTunnel;
byte _flMinLengthTunnel;
byte _flDoorCycle=0;
byte _flDoorCycleInc=0;

void floorInit(byte FullRef[],byte numFull){ 
	for(byte i;i<160;i++) {
		_floor[i]=FullRef[rnd(0,numFull-1)];
	}
	_flPosY=255;
	_flTurnCnt=0;
	_flTurnDir=255;//0:straight 1:up 2:down
	_flTunnelCnt=0;
}


void floorAddEntry(byte entryWidth) {
	if (_flEntryCnt==0)
		_flEntryCnt=entryWidth;
}


void floorDoorCycle() {
	if (_flDoorCycleInc==0) {
		if (_flDoorCycle==3) {
			_flDoorCycle=2;
			_flDoorCycleInc=1;
		} else _flDoorCycle++;
	} else {
		if (_flDoorCycle==0) {
			_flDoorCycle=1;
			_flDoorCycleInc=0;
		} else _flDoorCycle--;
	}

	if (_flDoorCycle==0) { // No door
	 memCpy(cpuWindow+128,cpuWindow+1408,128,tilPage);
	} else if (_flDoorCycle==1) { // closing 1
		memCpy(cpuWindow+1280,cpuWindow+1408,128,tilPage);
	} else if (_flDoorCycle==2) { // closing 2
		memCpy(cpuWindow+1152,cpuWindow+1408,128,tilPage);
	} else if (_flDoorCycle==3) { // closing 3 (closed)
		memCpy(cpuWindow+1024,cpuWindow+1408,128,tilPage);
	}
	
}

// Generate the floor band in memory (_floor)
// Each call "scrolls" the floor one element to the left

void floorGenerateInit() {
	memCpy(&_floor+_flNumLevels,&_floor,155); //160-5	
}

void floorGenerate(byte tilesE[],byte numE,byte tilesF[],byte numF,byte tilesFU[],byte numFU,byte tilesFD[],byte numFD) {
	byte i;
	byte flTileEmptyRef;
	byte flTileFullRef;
	
	// floorGenerateInit() must have been called before !!
	
	if (_flEntryCnt>0) {
		for(i=0;i<5;i++) {
			flTileEmptyRef=tilesE[rnd(0,numE-1)];
			poke(&_floor+155+i,flTileEmptyRef);
		}
		_flEntryCnt--;
		if (_flEntryCnt==0) {
			_flPosY=rnd(1,4);
			_flTunnelCnt=0;
			_flTurnCnt=0;
			_flTurnDir=255;//0:straight 1:up 2:down
			_flTunnelCnt=0;		
		}
	} else {
		nat floorLastC=&_floor+155;
		if (_flPosY!=255) {
			for(i=0;i<5;i++) {
				flTileFullRef=tilesF[rnd(0,numF-1)];
				poke(floorLastC+i,flTileFullRef);
			}
			flTileEmptyRef=tilesE[rnd(0,numE-1)];
			poke(floorLastC+_flPosY,flTileEmptyRef);
			
			if (_flPosY<4) {
				flTileFullRef=tilesFD[rnd(0,numFD-1)];
				poke(floorLastC+_flPosY+1,flTileFullRef);
			}
			if (_flPosY>0) {
				flTileFullRef=tilesFU[rnd(0,numFU-1)];
				poke(floorLastC+_flPosY-1,flTileFullRef);
			}
			
			
			if (_flTurnCnt==0 && _flTunnelCnt>0) {
				_flTunnelCnt--;
				if (rnd(0,10)==5) {
					poke(floorLastC+_flPosY,11); // Door
				}
			} else {
				if (_flTurnDir==255) {
					if (_flPosY>0 && _flPosY<4) {
						_flTurnDir=rnd(1,2); // 0:straight ; 1:down; 2:up
					} else {
						if (_flPosY==4) 
							_flTurnDir=2;
						else _flTurnDir=1;
					}
					if (_flTurnDir==1) {
						_flPosY++;
						if (_flPosY<4) {
							flTileFullRef=tilesFD[rnd(0,numFD-1)];
							poke(floorLastC+_flPosY+1,flTileFullRef);
						}
						
					} else if (_flTurnDir==2) {
						_flPosY--;
						if (_flPosY>0) {
	 						flTileFullRef=tilesFU[rnd(0,numFU-1)];
							poke(floorLastC+_flPosY-1,flTileFullRef);
						}

					}
					flTileEmptyRef=tilesE[rnd(0,numE-1)];
					poke(floorLastC+_flPosY,flTileEmptyRef);
					_flTurnCnt=_flTurnWidth;
					_flTunnelCnt=rnd(_flMinLengthTunnel,_flMaxLengthTunnel);
				} else {
					
					if (_flTurnDir==1) { //Went down: open up
						flTileEmptyRef=tilesE[rnd(0,numE-1)];
						poke(floorLastC+_flPosY-1,flTileEmptyRef);
						if ((_flPosY-1)>0) {
							flTileFullRef=tilesFU[rnd(0,numFU-1)];
							poke(floorLastC+_flPosY-2,flTileFullRef);
						}
					} else if (_flTurnDir==2) { //Went up open down
						flTileEmptyRef=tilesE[rnd(0,numE-1)];
						poke(floorLastC+_flPosY+1,flTileEmptyRef);
						if ((_flPosY+1)<4) {
							flTileFullRef=tilesFD[rnd(0,numFD-1)];
							poke(floorLastC+_flPosY+2,flTileFullRef);
						}

 					}
					_flTurnCnt--;
					if (_flTurnCnt==0) _flTurnDir=255;
				}
			}
		}
	}
}



/////// TILES LEFT SCROLLING /////
// Display the floor,sky,mountains and countryside
// from memory (_floor & bgTilesBandX) on screen with tiles
// using a left scrolling
////////////////////////////
type tRasterInstr {
	byte opCode;
	nat word;
	byte val;
};

									
// To be set at line 1: sky->mountains->country->floor 
// For each band, we set an offset and a the correct buffer to display
// There are 2 analog display lists as we use double buffering
tRasterInstr rasterlistA[32]={
									{SET,&rasterTunnel,0},
									{POS,5,0},
									{NEXT,&rasterlistA[4],0},
									{HALT,0,0},

									{SET,0x2f01,0}, // set tile offs@10
									{SET,statusReg,0},//set display buffer
									{POS,142,0},
									{NEXT,&rasterlistA[9],0},
									{HALT,0,0},

									{SET,0x2f01,0}, // set tile offs@142
									{SET,statusReg,0},
									{POS,224,0},
									{NEXT,&rasterlistA[14],0},
									{HALT,0,0},

									{SET,0x2f01,0}, // set tile offs@224
									{SET,statusReg,0},
									{POS,320,0},
									{NEXT,&rasterlistA[19],0},
									{HALT,0,0},

									{SET,0x2f01,0}, // set tile offs@320	
									{SET,statusReg,0},
									{POS,325,0},
									{NEXT,&rasterlistA[24],0},
									{HALT,0,0},

									{SET,&rasterTunnel,1}, //@325
									{POS,480,0},
									{NEXT,&rasterlistA[28],0},
									{HALT,0,0},
									
									{INC,&cntVblank,0}, //@480
									{POS,1,0},
									{NEXT,&rasterlistA[0],0},
									{HALT,0,0}
								};


tRasterInstr rasterlistB[32]={
									{SET,&rasterTunnel,0},
									{POS,4,0},
									{NEXT,&rasterlistB[4],0},
									{HALT,0,0},

									{SET,0x2f01,0}, // set tile offs@10
									{SET,statusReg,0},//set display buffer
									{POS,142,0},
									{NEXT,&rasterlistB[9],0},
									{HALT,0,0},

									{SET,0x2f01,0}, // set tile offs@142
									{SET,statusReg,0},
									{POS,224,0},
									{NEXT,&rasterlistB[14],0},
									{HALT,0,0},

									{SET,0x2f01,0}, // set tile offs@224
									{SET,statusReg,0},
									{POS,320,0},
									{NEXT,&rasterlistB[19],0},
									{HALT,0,0},

									{SET,0x2f01,0}, // set tile offs@320	
									{SET,statusReg,0},
									{POS,325,0},
									{NEXT,&rasterlistB[24],0},
									{HALT,0,0},

									{SET,&rasterTunnel,1}, //@325
									{POS,480,0},
									{NEXT,&rasterlistB[28],0},
									{HALT,0,0},
									
									{INC,&cntVblank,0}, //@480
									{POS,1,0},
									{NEXT,&rasterlistB[0],0},
									{HALT,0,0}
								};



nat offsAddrA[4];
offsAddrA[0] = &rasterlistA[19]+3;//Tunnel@320
offsAddrA[1] = &rasterlistA[4]+3;//sky:@1
offsAddrA[2] = &rasterlistA[9]+3;//mountains:@142
offsAddrA[3] = &rasterlistA[14]+3;//countryside:@224

