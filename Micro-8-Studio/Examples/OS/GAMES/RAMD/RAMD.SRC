byte rndx[100];
byte rndy[100];
byte t=1;

byte status=0;
// 0=init 1=play 2=win 3=lose
byte end=0;
//used to exit game loop

int x=40; int y=20;
int dx=0; int dy=0;

int xblock=0; int yblock=0;

int xver[3]={0,10,50}; int yver[3]={0,10,30};
int verdx[3]={0,0,0}; int verdy[3]={0,0,0};

int neux=0; int neuy=0;
int neuxblock=0; int neuyblock=0;

byte a=0; byte b=0; // coords used for setting blocks and disintegration
byte c=0; 				// used in disintegration

byte color=135;
byte blockcolor=200;
byte bu=0xb9;
byte block=0x7F;
byte verfolger=0x25;
byte vercolor=170;

nat adresse;
byte empty=1;
byte dir=0;
byte ergebnis=0;

byte scrx1=6; byte scrx2=74;	// screen borders
byte scry1=6; byte scry2=32;

byte bodycount=0;				//counter to delay verfolgers
byte zahl=0;					//counter for disintegrator

int xice[4]={-1,1,0,0};		//4 dir to check if surrounded
int yice[4]={0,0,-1,1};
byte adj[4];						//blocks surrounding verfolger
byte trapped=0;

byte gefangen1=0;
byte gefangen2=0;
byte gefangen3=0;


void cls()
{
	memSet(0x1200,0x1900,0);
	memSet(0x3000,48000,0,0x60);
}

void kprint(nat a, nat b, byte c)
// a is x, b is y, c is char
{
	adresse=4608+a+(80*b);
	poke(adresse,c);
}

void kcolor(byte a, byte b, byte c)
// c is color code
{
	adresse=7808+a+(80*b);
	poke(adresse,c);
}

void kcprint(int a, int b, byte c, byte d)
// c is char, d is color code
{
	adresse=4608+(nat)a+(80*(nat)b);
	poke(adresse,c);
	adresse=7808+(nat)a+(80*(nat)b);
	poke(adresse,d);
}

byte attr(byte a, byte b)
// returns color code in a.b
{
	return peek(7808+a+(80*b));
}

byte code(int a, int b)
// returns char in a,b
{
	return peek(4608+(nat)a+(80*(nat)b));
}

void pause(nat p)
{
	p=p*100;
	for(nat n;n<p;n++) {}
}

void detect()
// dir - direction of push
{
	if(code(x,y)==verfolger) 
	{
		curPos(30,0); print("Dead!");
		pause(500); status=3;
		end=1; // to exit game loop
	}
	//if(xver[1]==x && yver[1]==y)
	//{
	//	curPos(30,0); print("Dead!");
	//	pause(500); status=3;
	//	end=1; // to exit game loop
	//}
}

void applydir()
{
	if(dir==1) y--; 
	if(dir==2 && x<78) x++;
	if(dir==3) y++; 
	if(dir==4 && x>2) x--; 
}

void verfolgerdir()
{
	// direction to player
	for(byte n=1;n<3;n++)
	{
	verdx[n]=x-xver[n];
	verdy[n]=y-yver[n];

	// normalize
	if(verdx[n]>0) verdx[n]=1; 
	if(verdx[n]<0) verdx[n]=-1;
	if(verdy[n]>0) verdy[n]=1; 
	if(verdy[n]<0) verdy[n]=-1;
	}
}


void verbewegung2()
// no diagonal movement
{
	for(byte n=1;n<3;n++)
	{
	// move in x dir
	if(code(xver[n]+verdx[n],yver[n])!=block)
	{
		kcprint(xver[n],yver[n],empty,0);
		xver[n]=xver[n]+verdx[n];
		kcprint(xver[n],yver[n],verfolger,vercolor);
	}

	// try y dir
	if(code(xver[n],yver[n]+verdy[n])!=block)
	{
		kcprint(xver[n],yver[n],empty,0);
		yver[n]=yver[n]+verdy[n];
		kcprint(xver[n],yver[n],verfolger,vercolor);
	}

	}
}

void verbewegung()
{
	for(byte n=1;n<3;n++)
	{
	// move in x dir
	if(code(xver[n]+verdx[n],yver[n])!=block)
	{
		kcprint(xver[n],yver[n],empty,0);
		xver[n]=xver[n]+verdx[n];
		kcprint(xver[n],yver[n],verfolger,vercolor);
	}

	// try y dir
	if(code(xver[n],yver[n]+verdy[n])!=block)
	{
		kcprint(xver[n],yver[n],empty,0);
		yver[n]=yver[n]+verdy[n];
		kcprint(xver[n],yver[n],verfolger,vercolor);
	}

	// try diagonal
	else if(code(xver[n]+1,yver[n]+1)!=block)
	{
		kcprint(xver[n],yver[n],empty,0);
		xver[n]=xver[n]+1; yver[n]=yver[n]+1;
		kcprint(xver[n],yver[n],verfolger,vercolor);
	}

	else if(code(xver[n]-1,yver[n]+1)!=block)
	{
		kcprint(xver[n],yver[n],empty,0);
		xver[n]=xver[n]-1; yver[n]=yver[n]+1;
		kcprint(xver[n],yver[n],verfolger,vercolor);
	}
	else if(code(xver[n]-1,yver[n]-1)!=block)
	{
		kcprint(xver[n],yver[n],empty,0);
		xver[n]=xver[n]-1; yver[n]=yver[n]-1;
		kcprint(xver[n],yver[n],verfolger,vercolor);
	}
	else if(code(xver[n]+1,yver[n]-1)!=block)
	{
		kcprint(xver[n],yver[n],empty,0);
		xver[n]=xver[n]+1; yver[n]=yver[n]-1;
		kcprint(xver[n],yver[n],verfolger,vercolor);
	}
	}
}
 
	
			void kright()
			{
				if(_keyDwn==59 && x<scrx2)
				{
					dir=2; // right
					//kcprint(x,y,empty,0);
					dx=1; dy=0;
				}
			}
			void kleft()
			{
				if(_keyDwn==57 && x>scrx1)
				{
					dir=4; // left
					//kcprint(x,y,empty,0);
					dx=-1; dy=0;
				}
				else kright();
			}
			void kup()
			{
				if(_keyDwn==77 && y>scry1)
				{
					dir=1; // up
					//kcprint(x,y,empty,0);
					dy=-1; dx=0;
				}
				else kleft();
			}
			void kdown()
			{
				if(_keyDwn==80 && y<scry2)
				{
					dir=3; // down
					//kcprint(x,y,empty,0);
					dy=1; dx=0;
				}
				else kup(); 
			}

void keys()
{
	kdown();
}


void bewegung()
{
	neux=x+dx;
	neuy=y+dy;

	// check if new pos is a block
	if(code(neux,neuy)==block)
	{
		// block coords are new player coords
		xblock=neux;
		yblock=neuy;
		neuxblock=xblock+dx;
		neuyblock=yblock+dy;

		// check if block can be moved
		if(neuxblock>=scrx1 && neuxblock<scrx2 && neuyblock>=scry1 && neuyblock<scry2)
		{
			if(code(neuxblock,neuyblock)!=block && code(neuxblock,neuyblock)!=verfolger)
			{
				// move block
				kcprint(xblock,yblock,empty,0);
				kcprint(neuxblock,neuyblock,block,blockcolor);
				xblock=neuxblock;
				yblock=neuyblock;

				// move me
				kcprint(x,y,empty,0);
				kcprint(neux,neuy,bu,color);
				x=neux;
				y=neuy;
			}
		}
	}
	else // no block just move  
	{
		kcprint(x,y,empty,0);
		kcprint(neux,neuy,bu,color);
		x=neux;
		y=neuy;	
	}				
	// reset delta + sync video
	dx=0; dy=0;
	vSync();
}

void trappedunderice()
{
	//curPos(10,0);
	for(byte n=1;n<3;n++)
	{
	//curPos(10,0); print("n=",n," a=",adj[n]," tr=",trapped);
	
		if(code(xver[n]+1,yver[n])==block) adj[n]++;
		if(code(xver[n]-1,yver[n])==block) adj[n]++;
		if(code(xver[n],yver[n]+1)==block) adj[n]++;
		if(code(xver[n],yver[n]-1)==block) adj[n]++;

		if(adj[1]>3) { trapped=1; } else { adj[1]=0; }
		if(adj[2]>3) { trapped=2; } else { adj[2]=0; }

	}
}


void trappedunderice2()
{
	//curPos(10,0);
	// curPos(10,0); print("n=",n," a=",adj[n]," tr=",trapped);

	if(gefangen1!=1)
	{
		if(code(xver[1]+1,yver[1])==block) adj[1]++;
		if(code(xver[1]-1,yver[1])==block) adj[1]++;
		if(code(xver[1],yver[1]+1)==block) adj[1]++;
		if(code(xver[1],yver[1]-1)==block) adj[1]++;
	}
		if(adj[1]>3) { trapped=1; gefangen1=1; } else { adj[1]=0; }

	if(gefangen2!=1)
	{
		if(code(xver[2]+1,yver[2])==block) adj[2]++;
		if(code(xver[2]-1,yver[2])==block) adj[2]++;
		if(code(xver[2],yver[2]+1)==block) adj[2]++;
		if(code(xver[2],yver[2]-1)==block) adj[2]++;

		if(adj[2]>3) { trapped=2; gefangen2=1; } else { adj[2]=0; }
	}

	if(gefangen1 && gefangen2) gefangen3=1;
}


void randomgen()
{
	for(byte n=1;n<101;n++)
	{ rndx[n]=rnd(scrx1,scrx2); rndy[n]=rnd(scry1,scry2); }	
}


void disintegrator()
{
	zahl++;
	if(zahl>1)
	{
		zahl=0;
	
			//a=rndx[t]; b=rndy[t]; t++; if(t>99) t=1;
			a=rnd(scrx1,scrx2); b=rnd(scry1,scry2);

			if(attr(a,b)==blockcolor)
			{ 
				kcprint(a,b,0xBA,blockcolor);
				pause(1);
				kcprint(a,b,0xB9,blockcolor);
				pause(1);
				kcprint(a,b,0xB8,blockcolor);
				pause(1);
				kcprint(a,b,0xB7,blockcolor);
				pause(1);
				kcprint(a,b,0xB6,blockcolor);
				pause(1);
				kcprint(a,b,empty,0);
			}
	}
	c=0;
}


void setblocks()
{
	for(nat n=0; n<=700; n++)
	{
		a=rnd(scrx1,scrx2); b=rnd(scry1,scry2);
		if(attr(a,b)!=blockcolor)
		{
			kcprint(a,b,block,blockcolor);
		}	
	}
	for(byte n=1;n<3;n++)
	{
		kcprint(xver[n],yver[n],verfolger,vercolor);
		kcprint(xver[n]-1,yver[n],empty,0);
		kcprint(xver[n],yver[n]-1,empty,0);
	}
}


void intro()
{
	//randomgen();
	cls(); curPos(0,3);	

	print("0  Navigate the chaotic world of Professor Petru Myra's lab,");
	print("where a failed experiment with Right Angle Matter Deblobbing");
	print("technology has warped reality into a dangerous labyrinth of");
	print("rectangles.");	
	print("  Outmaneuver two very clingy geometric anomalies");
	print("and use the lab's disintegrating blocks to trap them.");
	print("  It's a race against time and the threatening void, where");
	print("every move is a calculated risk in the name of");
	print("science and survival!");

	for(byte n=3;n<21;n=n+2)
	{
		for(byte m=2;m<65;m++)
		{
			kcolor(m,n,2); pause(5);
		}
	}

	curPos(30,35); print("Press SPACE to start");

	while(_keyDwn!=78)
	{
		zahl++;
		if(zahl>3)
		{
			zahl=0;

				a=rnd(50,70); b=rnd(25,35);
				kcprint(a,b,0xBA,blockcolor);
				pause(5);
				kcprint(a,b,0xB9,blockcolor);
				pause(5);
				kcprint(a,b,0xB8,blockcolor);
				pause(5);
				kcprint(a,b,0xB7,blockcolor);
				pause(5);
				kcprint(a,b,0xB6,blockcolor);
				pause(5);
				kcprint(a,b,empty,0);
		}
	}
	status=1;
}


void fill()
{
	for(byte n=scry1;n<=scry2;n++)
	{
		for(byte m=scrx1;m<=scrx2;m++)
		{
			kcprint(m,n,block,blockcolor);
		}
	}
}


void resetvars()
{
	x=40; y=20;
	trapped=0;
	gefangen1=0; gefangen2=0; gefangen3=0;
	adj[1]=0; adj[2]=0;
	xver[1]=rnd(10,30); xver[2]=rnd(40,60);
	yver[1]=rnd(10,20); yver[2]=rnd(20,30);
}

void win()
{
	fill();
	cls(); 
	while(_keyDwn!=78)
	{
		cls(); curPos(rnd(2,60),rnd(2,30));
		print("YOU DID IT!");
		pause(70);
	}
	resetvars();
	status=1; // play again  
}

void lose()
{
	fill();
	cls();
	while(_keyDwn!=78)
	{
		cls(); curPos(rnd(2,60),rnd(2,30));
		print("SPACE TO PLAY AGAIN");
		pause(70);
	}
	resetvars();
	status=1; // play again  
}


void game()
{
cls();

setblocks();

while(_keyDwn !=12)
		{
			keys();
			bewegung();
			if(bodycount==72)
			{
				verfolgerdir();
				verbewegung2();
				detect();
				bodycount=0;
			}
			trappedunderice2();
			
			if(trapped>0)
			{
				if(trapped==1)
				{
					curPos(30,0); print("Trapped ",trapped);
				}
				else
				{
					curPos(50,0); print("Trapped ",trapped);
				}
			// trapped=0;
			}

			if(gefangen3==1) { curPos(40,20); print("END"); }
			
			disintegrator();

			bodycount++;	
			pause(25);
			curPos(20,0); print("      ");
			curPos(40,0); print("      ");
		}
}


void game2()
{
cls();

setblocks();

end=0;

while(end !=1)
		{
			//if(_keyDwn==12) end=1;
			
			keys();
			bewegung();
			if(bodycount==30)
			{
				verfolgerdir();
				verbewegung2();
				detect();
				bodycount=0;
			}
			trappedunderice2();
			
			if(gefangen3==1)
			{
				status=2; 
				end=1;
			}
			
			disintegrator();

			bodycount++;	
			pause(15);
		}
}


void main()
{
	while(_keyDwn!=12)
	{
	if(status==0) intro();

	if(status==1) game2();

	if(status==2) win();

	if(status==3) lose();
	}
}

main();
