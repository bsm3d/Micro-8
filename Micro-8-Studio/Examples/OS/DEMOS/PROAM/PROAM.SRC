
import("/system/reginit.dat",0x1100,0);

nat bmpPal=0x11a0; //bitmap palette
byte bmpPage=0x60; //default page for bitmap in XSRAM: 0x18000
nat cpuWindow=0x3000; //default memory mapping (where the cpu sees XSRAM)

// direction table for cars
real dx[24] = {99,97,87,71,50,26,0,-26,-50,-71,-87,-97,-99,-97,-87,-71,-50,-26,0,26,50,71,87,97};
real dy[24] = {0,26,50,71,87,97,99,97,87,71,50,26,0,-26,-50,-71,-87,-97,-99,-97,-87,-71,-50,-26};

nat tileAdr= 0x2f0b;
nat offX= 0x2f01;
nat offY= 0x2f02;
nat mapX[2]={1587,1676}; // car start position
nat mapY[2]={1510,1461}; // car start position
byte timer;

byte carRotation[2]={21,21}; // rotation cars

byte HALT = 0;
byte SET = 1;
byte INC = 2;
byte DEC = 3;
byte ADD = 4;
byte SUB = 5;
byte OR = 6;
byte AND = 7;
byte POS = 8;
byte NEXT = 9;
byte NOP = 10;

real maxSpeed[2]={1.2,1.2};
real accel[2]={0.05,0.05};
real brake[2]={0.01,0.01};
real speed[2];
type rasterInstr {byte opCode; nat word; byte val;};


//memCpy(0x3000,0,48000,0x60);  // clear bmp
memSet(0x1200,3200,' ');			// clear text
memSet(0x1E80,3200,0);			// clear color text

rasterInstr list[60]={

								{POS, 240, 0},
								{SET, 0x2f51,0},//at new Y pos  // duplicate #2
								{SET, 0x2f52,0},//at new Y pos
