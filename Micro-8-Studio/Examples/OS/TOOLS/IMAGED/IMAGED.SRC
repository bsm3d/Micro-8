void updateColEd(byte r, byte g, byte b)
{
	displayColEd();
	curPos(colEdPosX+1,colEdPosY+7-r>>1);//red cursor
	print("e",colCur[r%2]);

	curPos(colEdPosX+3,colEdPosY+7-g>>1);//green cursor
	print("a",colCur[g%2]);

	curPos(colEdPosX+5,colEdPosY+7-b>>1);//blue cursor
