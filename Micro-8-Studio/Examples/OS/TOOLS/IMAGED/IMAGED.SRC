nat glyphAddr=glyphId*10*12;//compute the linear address of the glyph to be replaced

text glyphLine={10};//buffer for storing line contents

void genGlyph(text t[])
{
	for(byte y; y<12; y++)//for each line
	{
		glyphLine=t[y];//get the actual text line contents from the text ref in the array
		for(byte x; x<10; x++)//scan the line to check for plain squares
		{
			bool bit=peek(&glyphLine+x)=='';
			glyphSet(glyphAddr++,bit);//set/clear bit and increment address
		}
	}
}

