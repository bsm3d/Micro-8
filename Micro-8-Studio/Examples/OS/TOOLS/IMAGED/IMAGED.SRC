void charCol(byte x, byte y, byte col)//change character foreground color
{
	nat address=0x1e80+x+y*80;
	poke(address,peek(address)&0xf0|col);
}

void backCol(byte x, byte y, byte col)//change character background color
{
	nat address=0x1e80+x+y*80;
	poke(address,peek(address)&0x0f|col<<4);
}

void clrBmp()
{
	memSet(cpuWinOrg,48000,0,bmpPage);//clear bitmap
}

clrBmp();

text mainImage="tmp/main.bmp";
text workImage="tmp/work.bmp";
export(workImage,cpuWinOrg,48000,bmpPage);//clear (export empty)

poke(0x2f16,bmpPage);//draw
poke(0x2f05,bmpPage);//display (scanout)

void toggleImage()
{
	if(zoom)poke(0x2f05,zoomOutPage);//zoomout bitmap scanout
	else poke(0x2f05,bmpPage);//regular bitmap scanout

	if(currentImage==MAIN_IMG)
	{
		export(mainImage,cpuWinOrg,48000,bmpPage);
		import(workImage,cpuWinOrg,48000,bmpPage);
		currentImage=WORK_IMG;
	}
	else if(currentImage==WORK_IMG)
	{
		export(workImage,cpuWinOrg,48000,bmpPage);
		import(mainImage,cpuWinOrg,48000,bmpPage);
		currentImage=MAIN_IMG;
  	}
}

