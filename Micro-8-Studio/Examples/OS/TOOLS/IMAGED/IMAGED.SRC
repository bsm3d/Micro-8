//Any color change has to be reflected to all used palettes
void copyPalettes()
{
	//copy bitmap palette to tile palette
	for(byte i; i<48; i++) poke(tilePal+i,peek(bmpPal+i));
	//copy bitmap palette to sprite palette A
	for(byte i; i<48; i++) poke(spritePal+i,peek(bmpPal+i));
	//copy color 0 to text color 3 for use as substitute to sprite col 0 in the color picker
	poke(textPal+3,peek(bmpPal));
	poke(textPal+16+3,peek(bmpPal+16));
	poke(textPal+32+3,peek(bmpPal+32));

	//copy current paint color to text col 4
	poke(textPal+4,peek(bmpPal+color));
	poke(textPal+16+4,peek(bmpPal+16+color));
	poke(textPal+32+4,peek(bmpPal+32+color));

	//copy current eraser color to text col 6
	poke(textPal+6,peek(bmpPal+eraser));
	poke(textPal+16+6,peek(bmpPal+16+eraser));
	poke(textPal+32+6,peek(bmpPal+32+eraser));
}
copyPalettes();

//------------File management

text bmpFullPath={64};//arbitrary value, can be larger if necessary
text palFullPath={64};
text folder={32};
folder="images";//default folder

text fileName={8};//name without extension (file must be in the same folder)
fileName="untitled";
text fileName2={8};
fileName2="sketch";

text bmpName={12};//name with extension
text palName={12};

void clearNames()
{
	memSet(&bmpName,12,0);//clear working buffers
	memSet(&palName,12,0);
	memSet(&bmpFullPath,32,0);
	memSet(&palFullPath,32,0);
}

void changeFolder()
{
	curPos(msgPosX,msgPosY);
	print("fChange folder to:         ");
	input(folder,32);
	print("");
	clrMsg();
}

void enterFileName(nat txtAddr)
{
	curPos(msgPosX,msgPosY);
	print("fEnter file name (without extension):         ");
	input((text)txtAddr,8);
	print("");
	clrMsg();
}

void appendExtensions(nat fileNameAddr)
{
	clearNames();

	memCpy(fileNameAddr,&bmpName,8);//source, destination, include nullchar
	concat(bmpName,".bmp");

	memCpy(fileNameAddr,&palName,8);
	concat(palName,".pal");
}

void buildFullPathNames()
{
	memCpy(&folder, &bmpFullPath,$folder);
	concat(bmpFullPath,"/");
	concat(bmpFullPath,bmpName);

	memCpy(&folder, &palFullPath,$folder);
	concat(palFullPath,"/");
	concat(palFullPath,palName);
}

void loadFile(nat fileNameAddr)
{
	txtWin(msgPosX,msgPosY,79,msgPosY+1);//in case of file error message
	curPos(msgPosX,msgPosY);

	appendExtensions(fileNameAddr);
	buildFullPathNames();

	import(palFullPath,bmpPal,48);//load palette
	import(bmpFullPath,0x3000,48000,bmpPage);//load bitmap

	copyPalettes();
	txtWin(0,0,79,39);//back to default window
}

void saveFile(nat fileNameAddr)
{
	txtWin(msgPosX,msgPosY,79,msgPosY+1);//setup msg window
	curPos(msgPosX,msgPosY);
	appendExtensions(fileNameAddr);
	buildFullPathNames();
	export(bmpFullPath,0x3000,48000,bmpPage);//save bitmap
	export(palFullPath,bmpPal,48);//save palette
	print("f'",(text)fileNameAddr,"' saved successfully !");

	txtWin(0,0,79,39);//back to default window
}

//------------Undo

//actions are stored/restored as a tile-based packet stream

byte undoId;//current undo id
byte undoStart;
byte undoEnd;

void undoInit()
{
	undoId=1;
	undoStart=0;
	undoEnd=0;
}
undoInit();

bool actionPushed=true;
byte ACTION_UNDO=0;
byte ACTION_REDO=1;

text undoActionPath="tmp/undoact.";
text redoActionPath="tmp/redoact.";

text undoActionFullName={32};
text redoActionFullName={32};

text numExtension={3};

//undo tiles are 8x16 bytes (16x16 pixels) (25x15 tiles total)
bool savedTiles[375]; //dirty flag for saved tiles

//a tile-based action contains the number of saved packets when drawing ends
//packets have a 3 byte coordinates header and 128 bytes tile data

nat actions[32];//ring buffer with 32 undo levels.
//If the above is changed, modulos needs to reflect the change

void int2ext(nat val)
{
	nat rank=1;
	for(int n=#numExtension-1; n>=0; n--)
	{
		byte digit = (byte)((val%(10*rank))/rank);
		poke(&numExtension+(byte)n,digit+48);
		rank*=10;
	}
}

void undoMakeFileName(nat id, byte actionType)
{
	if(actionType==ACTION_UNDO)
	{
		memCpy(&undoActionPath,&undoActionFullName,$undoActionPath);
		int2ext(id);
		concat(undoActionFullName,numExtension);
	}
	else if(actionType==ACTION_REDO)
	{
		memCpy(&redoActionPath,&redoActionFullName,$redoActionPath);
		int2ext(id);
		concat(redoActionFullName,numExtension);		
	}
}

int posToTile(int x, int y)//x,y in pixel coords
{
	return x>>4 + 25*(y>>4);//returns tile index
}

//a packet is a tile coords + tile data
void pushPacket(int x, int y) //push pixel coordinates+tile data to xsram
{
	int tile=posToTile(x,y);
	
	if(!savedTiles[tile])
	{
		int tileX=(x&0xfff0)>>1;//in byte x coords
		byte tileY=(byte)(y&0xfff0);//in pixel y coords
		
		nat pos=actions[undoId]*131;//3 bytes coordinates and 128 bytes data
		pokeW(cpuWinOrg+pos,tileX,undoTilesPage);
		poke(cpuWinOrg+pos+2,tileY,undoTilesPage);
		areaCpy(cpuWinOrg,200,tileX,tileY,8,16,scratchPad,8,0,0,bmpPage);//to scratchpad
		areaCpy(scratchPad,8,0,0,8,16,cpuWinOrg+pos+3,8,0,0,undoTilesPage);//to xsram
		actions[undoId]++;				
		savedTiles[tile]=true;
	}
}

void pushArray(int x1, int y1, int x2, int y2)
{
	//first make it work in any direction
	if(x1>x2)
	{
		int t=x2;
		x2=x1;
		x1=t;
	}
	if(y1>y2)
	{
		int t=y2;
		y2=y1;
		y1=t;
	}
	
	for(int y=y1; y<y2+16; y+=16)
	for(int x=x1; x<x2+16; x+=16)
		pushPacket(clamp(x,0,399),clamp(y,0,239));
}

void pushDraw(int radius, int mx, int my, int px, int py)
{
	//compute draw sub tiles for undo/redo and push packets to action	
	if(radius<=8)
	{
		real dx=mx-px;
		real dy=my-py;

		real dist=sqrt(dx*dx+dy*dy);
		int numStep=1+(int)(dist/8);
		
		for(int i=0; i<numStep; i++)
		{
			real t=(real)i/numStep+.5/numStep;
			int lx=lerp(px,mx,t);
			int ly=lerp(py,my,t);

			//push 4 adjascent tiles		
			int minx=min(lx+radius,399);
			int maxx=max(lx-radius,0);
			int miny=min(ly+radius,239);
			int maxy=max(ly-radius,0);

			pushPacket(minx,miny);
			pushPacket(maxx,miny);
			pushPacket(minx,maxy);
			pushPacket(maxx,maxy);		
		}
	}
	else
	{
		for(int y=my-radius; y<my+radius; y+=8)
		for(int x=mx-radius; x<mx+radius; x+=8)
			pushPacket(clamp(x,0,399),clamp(y,0,239));
	}	
}

void pushAction()//on finish draw
{
	undoMakeFileName(undoId, ACTION_REDO);
	//first we push the current frame buffer content for redo action
	//we copy each packet from the frame buffer to scratchpad
	//then directly write the packet to file to avoid buffering
	//the entire action in memory. Because we are not drawing at this
	//time, speed is less of an issue.
	fOpen(0,redoActionFullName);
	nat numPackets=actions[undoId];
	nat offset;
	for(nat n; n<numPackets; n++)
	{
		//we reuse the undo tiles coords, they are the same for redo
		int tileX=peekW(cpuWinOrg+offset,undoTilesPage);//in byte coords
		byte tileY=peek(cpuWinOrg+offset+2,undoTilesPage);//in pixel coords
		//writes coords to scratchpad
		pokeW(scratchPad,tileX);
		poke(scratchPad+2,tileY);
		//copy tile data to scratchpad to linearize for writing to file
		areaCpy(cpuWinOrg,200,tileX,tileY,8,16,scratchPad+3,8,0,0,bmpPage);
		//write packet to file
		fWrite(0,scratchPad,offset,131);//packet data
		offset+=131;
	}			
	fClose(0);
	//then we save the undo action tiles that are already in memory
	memSet(&savedTiles,375,0);//clear dirty flags
	undoMakeFileName(undoId, ACTION_UNDO);
	export(undoActionFullName,cpuWinOrg,actions[undoId]*131,undoTilesPage);

	//update ring buffer
	undoId=(undoId+1)%32;
	undoEnd=undoId;

	if(undoStart==undoEnd)//if we loop all over the ring buffer
	{
		undoStart=(undoStart+1)%32;//the buffer is full, start has to move up
	}
	
	actionPushed=true;//only push once on stop
}

void popPacket(nat offset) //pops tile from xsram and write back to frame buffer
{
	int tileX=peekW(cpuWinOrg+offset,undoTilesPage);//in byte coords
	byte tileY=peek(cpuWinOrg+offset+2,undoTilesPage);//in pixel coords
	areaCpy(cpuWinOrg+offset+3,8,0,0,8,16,scratchPad,8,0,0,undoTilesPage);
	areaCpy(scratchPad,8,0,0,8,16,cpuWinOrg,200,tileX,tileY,bmpPage);
}

void undo()
{
	byte previous=(undoId-1)%32;
	if(previous!=undoStart)
	{
		undoId=previous;
		undoMakeFileName(undoId, ACTION_UNDO);
		import(undoActionFullName,cpuWinOrg,actions[undoId]*131,undoTilesPage);
		nat numPackets=actions[undoId];
		nat offset;
		for(nat n; n<numPackets; n++)
		{
			popPacket(offset);
			offset+=131;
		}
	}
}

void redo()
{
	byte next=(undoId+1)%32;
	if(undoId!=undoEnd)
	{
		undoMakeFileName(undoId, ACTION_REDO);
		import(redoActionFullName,cpuWinOrg,actions[undoId]*131,undoTilesPage);
		nat numPackets=actions[undoId];
		nat offset;
		for(nat n; n<numPackets; n++)
		{
			popPacket(offset);
			offset+=131;
		}
		undoId=next;
	}
}

//---------------------------- Paint bucket

//Paint bucket tool using the scanline flood fill algorithm from wikipedia
//Original algorithm author Paul S. Heckbert (Graphics Gems, 1990)

type Seg
{
	int x1;
	int x2;
	byte y;
	byte dy;//can only be -1 or 1 We bias by 1 to allow byte and reduce memory
};

Seg segs[512];//should a complex fill fail (very unlikely), increase this.
nat segId;//top of segment stack

byte oldCol;

void pushSeg(int x1, int x2, byte y, int dy)
{
	if(segId<512)//safety to avoid crash. should match the segs[] size above
	{
		segs[segId]={x1,x2,y,(byte)(dy+1)};//bias on dy to allow byte usage
		segId++;
	}
}

Seg popSeg()
{
	segId--;
	return segs[segId];
}

void floodFill(int x, int y)
{
	oldCol=pick(x,y);
	if(oldCol==color && shape!=3) return;
	segId=0;

	pushSeg(x,x,(byte)y,1);
	if(y>0) pushSeg(x,x,(byte)y-1,-1);
	else pushSeg(x,x,0,-1);

	while(segId>0 && _keyDwn!=12)
	{
		Seg seg=popSeg();
		int dy=seg.dy-1;//bias
		
		if(seg.y>=0 && seg.y<240)
		{
			//search for left border
			int xMin=seg.x1;				
			while(xMin>0 && pick(xMin-1,seg.y)==oldCol) xMin--;

			//search for right border
			int xMax=seg.x2;
			while(xMax<399 && pick(xMax+1,seg.y)==oldCol) xMax++;

			//push segment for undo
			for(int x=max(0,xMin-8); x<min(xMax+8,399); x+=8)
			{
				pushPacket(x,seg.y-8);
				pushPacket(x,seg.y+8);
			}
				
			if(shape==3) //dither (could be accelerated by writing bytes)
			{
				for(int x=xMin; x<=xMax; x++)
				{
					if(!(bool)(x&1) && !(bool)(seg.y&1) ||
						x&1 && seg.y&1) plot(x,seg.y,color);
					else plot(x,seg.y,eraser);
				}
			}
			else 
			{
				line(xMin,seg.y,xMax,seg.y,color);
			}
			
			//scan row above
			int ny=seg.y-dy;
			if(ny>=0 && ny<240)
			{
				int i=xMin;
				while(i<=xMax)
				{
					while(i<=xMax && pick(i,ny)!=oldCol) i++;
					if(i>xMax) break;
					int x1=i;
					while(i<=xMax && pick(i,ny)==oldCol) i++;
					pushSeg(x1,i-1,(byte)ny,-dy);
				}
			}
			
			//scan row below
			int py=seg.y+dy;
			if(py>=0 && py<240)
			{
				int i=xMin;
				while(i<=xMax)
				{
					while(i<=xMax && pick(i,py)!=oldCol) i++;
					if(i>xMax) break;
					int x1=i;
					while(i<=xMax && pick(i,py)==oldCol) i++;
					pushSeg(x1,i-1,(byte)py,dy);
				}
			}
		}
	}
}

// -------------- Selection

bool hasSelection;
bool selectToggle;
byte selectCnt;
vec2 selOrg;
vec2 selEnd;

bool isRotatable()
{
	return selEnd.x-selOrg.x==selEnd.y-selOrg.y;
}

void initSelection()
{
	if(selOrg.x>selEnd.x)
	{
		int t=selEnd.x;
		selEnd.x=selOrg.x;
		selOrg.x=t;
	}
	if(selOrg.y>selEnd.y)
	{
		int t=selEnd.y;
		selEnd.y=selOrg.y;
		selOrg.y=t;
	}

	for(int x=selOrg.x; x<selEnd.x-4; x+=10)
	{
		line(x,selOrg.y,x+4,selOrg.y,0xf0);
		line(x,selEnd.y,x+4,selEnd.y,0xf0);
	}
	for(int y=selOrg.y; y<selEnd.y-4; y+=10)
	{
		line(selOrg.x,y,selOrg.x,y+4,0xf0);
		line(selEnd.x,y,selEnd.x,y+4,0xf0);
	}
	hasSelection=true;
}

void toggleSelection(byte limit)
{
	if(selectCnt++==limit)
	{
		rect(selOrg.x,selOrg.y,selEnd.x,selEnd.y,0xf0);
		selectToggle=!selectToggle;
		selectCnt=0;
	}
}

void deselect()
{
	if(selectToggle) rect(selOrg.x,selOrg.y,selEnd.x,selEnd.y,0xf0);

	for(int x=selOrg.x; x<selEnd.x-4; x+=10)
	{
		line(x,selOrg.y,x+4,selOrg.y,0xf0);
		line(x,selEnd.y,x+4,selEnd.y,0xf0);
	}
	for(int y=selOrg.y; y<selEnd.y-4; y+=10)
	{
		line(selOrg.x,y,selOrg.x,y+4,0xf0);
		line(selEnd.x,y,selEnd.x,y+4,0xf0);
	}
	selectToggle=false;
	hasSelection=false;
	selectCnt=0;
}

void flipHorizontal()
{
	//push for undo
	pushArray(selOrg.x,selOrg.y,selEnd.x,selEnd.y);

	int halfX=selOrg.x+(selEnd.x-selOrg.x)/2;
	for(int x=selOrg.x; x<=halfX; x++)
	{
		int diff=selEnd.x-(x-selOrg.x);
		for(int y=selOrg.y; y<=selEnd.y; y++)
		{
			byte tmp=pick(x,y);
			plot(x,y,pick(diff,y));
			plot(diff,y,tmp);
		}
	}	
}

void flipVertical()
{
	//push for undo
	pushArray(selOrg.x,selOrg.y,selEnd.x,selEnd.y);

	int halfY=selOrg.y+(selEnd.y-selOrg.y)/2;
	for(int y=selOrg.y; y<=halfY; y++)
	{
		int diff=selEnd.y-(y-selOrg.y);
		for(int x=selOrg.x; x<=selEnd.x; x++)
		{
			byte tmp=pick(x,y);
			plot(x,y,pick(x,diff));
			plot(x,diff,tmp);
		}
	}
}

void rotateLeft()
{
	//push for undo
	pushArray(selOrg.x,selOrg.y,selEnd.x,selEnd.y);

	int n=selEnd.x-selOrg.x+1;
	int nm1=n-1;
	int halfN=n/2;
	
	for(int i; i<halfN; i++)
	{
		int topY=selOrg.y+i;
		int botY=selOrg.y+nm1-i;
		int leftX=selOrg.x+i;
		int rightX=selOrg.x+nm1-i;
		int bound=nm1-i;
		
		for(int j=i; j<bound; j++)
		{
			int topX=selOrg.x+j;
			int botX=selOrg.x+nm1-j;
			int topYj=selOrg.y+j;
			int botYj=selOrg.y+nm1-j;
			byte tmp=pick(topX, topY);
			plot(topX,topY, pick(rightX, topYj));
			plot(rightX, topYj, pick(botX, botY));
			plot(botX, botY, pick(leftX, botYj));
			plot(leftX, botYj, tmp);
		}
	}
}

void rotateRight()
{
	//push for undo
	pushArray(selOrg.x,selOrg.y,selEnd.x,selEnd.y);

	int n=selEnd.x-selOrg.x+1;
	int nm1=n-1;
	int halfN=n/2;
	
	for(int i; i<halfN; i++)
	{
		int topY=selOrg.y+i;
		int botY=selOrg.y+nm1-i;
		int leftX=selOrg.x+i;
		int rightX=selOrg.x+nm1-i;
		int bound=nm1-i;
		
		for(int j=i; j<bound; j++)
		{
			int topX=selOrg.x+j;
			int botX=selOrg.x+nm1-j;
			int topYj=selOrg.y+j;
			int botYj=selOrg.y+nm1-j;
			byte tmp=pick(topX, topY);
			plot(topX,topY, pick(leftX, botYj));
			plot(leftX, botYj, pick(botX, botY));
			plot(botX, botY, pick(rightX, topYj));
			plot(rightX, topYj, tmp);
		}
	}
}

void snapTool()
{
	if(currentTool==2)//snap line horizontally or vertically
	{
		int dx=abs(toolX2-toolX1);
		int dy=abs(toolY2-toolY1);
		if(dx<dy) toolX2=toolX1;
		else toolY2=toolY1;
	}
	else if(currentTool==11 && grid)//overlay selection rectangle
	{
		tx=(tx+8)&0xfff0;//snap to grid
		ty=(ty+8)&0xfff0;
	}
	else if(grid)//other tools snap to grid
	{
		if(toolX2>toolX1)
		{
			toolX1=(toolX1+8)&0xfff0;
			toolX2=(toolX2+8)&0xfff0-1;	
		}
		else
		{
			toolX1=(toolX1+8)&0xfff0-1;
			toolX2=(toolX2+8)&0xfff0;	
		}
		if(toolY2>toolY1)
		{
			toolY1=(toolY1+8)&0xfff0;
			toolY2=(toolY2+8)&0xfff0-1;
		}
		else
		{
			toolY1=(toolY1+8)&0xfff0-1;
			toolY2=(toolY2+8)&0xfff0;
		}
	}
}

//------------- Copy / Paste selection

//stuff for dynamic overlay selection rectangle
type overRect
{
	bool visible;
	int x1;//post transform pixel coords
	int y1;
	int x2;
	int y2;
};

overRect shownOR;//the one currently in the frame buffer
overRect newOR;//the new one we want to draw

vec2 selDim;

bool overlap()
{
	return (shownOR.x1==newOR.x1 && shownOR.y1==newOR.y1 && shownOR.x2==newOR.x2 && shownOR.y2==newOR.y2);
}

void overRectSync()
{
	if(shownOR.visible && (!newOR.visible || !overlap()))
	{
		rect(shownOR.x1,shownOR.y1,shownOR.x2,shownOR.y2,0xf0);
		shownOR.visible=false;
	}
	if(newOR.visible && !shownOR.visible)
	{
		rect(newOR.x1,newOR.y1,newOR.x2,newOR.y2,0xf0);
		shownOR = newOR;
		shownOR.visible=true;
	}
}

void renderOverRect()
{
	newOR.visible=true;
	newOR.x1=tx;
	newOR.y1=ty;
	newOR.x2=tx+selDim.x-1;
	newOR.y2=ty+selDim.y-1;
	overRectSync();
}

void hideOverRect()
{
	newOR.visible=false;
	overRectSync();	
}

void copySelection()
{
	fOpen(0,"data/clpboard.dat");
	
	nat offset;
	int width=selEnd.x+1-selOrg.x;
	int height=selEnd.y+1-selOrg.y;
	byte allign=(byte)(selOrg.x%2);//pixel offset within first byte
	byte lsize=(byte)(width>>1+(selEnd.x+1)%2);//size of a line in bytes
	
	//first serialize info
	fWrite(0,&width,offset,2);//in pixels
	offset+=2;
	fWrite(0,&height,offset,2);
	offset+=2;
	fWrite(0,&allign,offset,1);
	offset++;
	fWrite(0,&lsize,offset,1);//in bytes
	offset++;
	
	//then the selection data
	for(byte y=(byte)selOrg.y; y<=(byte)selEnd.y; y++)//save each line
	{
		nat addr=0x3000+(nat)selOrg.x>>1+y*200;
		fWrite(0,addr,offset,lsize,bmpPage);
		offset+=lsize;
	}
	fClose(0);
}

void getSelectionDim()
{
	fOpen(0,"data/clpboard.dat");
	
	//deserialize data
	fRead(0,&selDim,0,4);//width, height (2 bytes each)
	fClose(0);	
}

void pasteSelection(int x, int y)
{
	fOpen(1,"data/clpboard.dat");//descriptor 0 used by undo in pushArray
	
	nat offset;
	nat width;
	nat height;
	byte allign;
	byte lsize;//size of a line in bytes
			
	//first deserialize data
	fRead(1,&width,offset,2);//pixels
	offset+=2;
	fRead(1,&height,offset,2);
	offset+=2;
	fRead(1,&allign,offset,1);
	offset++;
	fRead(1,&lsize,offset,1);
	offset++;

	//push for undo
	pushArray(x,y,x+width-1,y+height-1);

	//because blit does not write color 0, we need first to clear the area
	//unless the user holds ALT
	if(!ALT) box(x,y,x+width-1,y+height-1,0);

	//determine the number of lines that can fit into the scratchpad
	//and split selection into smaller blocs
	nat linesInBloc=2048/lsize;//2 KiB is the scratchpad size
	nat blocSize=linesInBloc*lsize;
	nat numIter=height/linesInBloc;
	nat remainderHeight=height%linesInBloc;
	nat remainderSize=remainderHeight*lsize;	
	
	//read file by 2 KiB blocs to the scratchpad
	//then blit to screen
	for(nat i; i<numIter; i++)
	{
		fRead(1,scratchPad,offset,blocSize);
		blit(scratchPad,lsize,allign,0,width,linesInBloc,x,y+i*linesInBloc);
		offset+=blocSize;
	}
	fRead(1,scratchPad,offset,remainderSize);
	blit(scratchPad,lsize,allign,0,width,remainderHeight,x,y+numIter*linesInBloc);
	
	fClose(1);
}

