//	byte shift=4-zoomFactor;
//	zoomOriginX &= 0xfe<<shift;
//	zoomOriginY &= 0xfc<<shift;
//}

void toggleGrid()
{
	grid=!grid;
	if(grid)
	{
		poke(gfxModes,peek(gfxModes)|0b01000000);
		if(zoom)
		{
			showZoomGrid();
			refreshUI();
		}
	}
	else
	{
		poke(gfxModes,peek(gfxModes)&0b10111111);
		if(zoom)
		{
			hideZoomGrid();
			drawZoomSeparator();
			refreshUI();
		}
	}
}

//------------- ZOOM

//zoom window is made of 14x15 hardware tiles
//zoom posx in tiles is 11
int zwtx=11*16*2; //in hires pixels (for collision testing)
int zwty=0;
int zwbx=25*16*2;
int zwby=15*16*2;
bool zoomRefreshAll=true;

//When in zoom, the left size shows unzoomed image that follows zoom pos
//This function is used to copy from current page to zoomOut page
void cpy2zoomOut()
{
	//fast version for small brushes, otherwise copy the entire screen
	//could be optimized by computing the actual vertical footprint of
	//the tool and copying only the necessary area

	if(grid) zoomOutPosx=zoomOutPosx&0xfff8;//snap to tile (bytes)
	
	if(zoomRefreshAll || currentTool==1 && brushSizes[brush]>=10)
	{
		//12 bloc copies of 100x20 bytes using scratchpad
		for(int i; i<12; i++)
		{
			//source copy from current page to scratchpad
			areaCpy(cpuWinOrg,200,zoomOutPosx,i*20,100,20,scratchPad,100,0,0,bmpPage);
			//destination copy from scratchpad to zoomOutPage
			areaCpy(scratchPad,100,0,0,100,20,cpuWinOrg,200,0,i*20,zoomOutPage);
		}
	}
	else
	{
		byte cy=(byte)clamp(ty-10,0,239);
		byte ln=(byte)min(20,240-cy);//lines to copy (20 or less at the bottom)
		//source copy from current page to scratchpad
		areaCpy(cpuWinOrg,200,zoomOutPosx,cy,100,ln,scratchPad,100,0,0,bmpPage);
		//destination copy from scratchpad to zoomOutPage
		areaCpy(scratchPad,100,0,0,100,ln,cpuWinOrg,200,0,cy,zoomOutPage);
	}
}

int toZPos(int orgPos, int winPos) //compute position within zoom
{
	return (orgPos-(winPos>>1)) >> (zoomFactor-1);
}

void displayZoom()
{	
	byte index=1;//index 0 is fully transparent in opaque tile mode
	for(byte y=0; y<15; y++)
		for(byte x=11; x<25; x++)
		{
			poke(tileBufferA+x+y<<5,index);
			index++;
		}

	if(grid) showZoomGrid();
	drawZoomSeparator();
	refreshUI();
	
	poke(0x2f05,zoomOutPage);//bitmap scanout	to zoomOut window (left half)
}

void hideZoom()
{	
	poke(0x2f05,bmpPage);//bitmap scanout back to normal
	areaSet(tileBufferA,32,11,0,14,15,0);
	hideZoomGrid();
	refreshUI();
}

//In order to improve performance for brush updates when drawing in zoom
//we update only the relevant tiles

byte getZoomTileRef(int x, int y)
{
		return(byte)((x-176)/16 + (y/16)*14 + 1);//tile 0 is transparent
}

vec2 getZoomTilePos(int x, int y)
{
	vec2 tp;
	tp.x=toZPos(x,zwtx)>>(5-zoomFactor);
	tp.x=tp.x<<(4-zoomFactor);
		
	tp.y=toZPos(y,zwty)>>(5-zoomFactor);
	tp.y=tp.y<<(5-zoomFactor);
	
	tp.x+=zoomOriginX;
	tp.y+=zoomOriginY;
	
	return tp;
} 

void zoomInterpolateTiles()
{
	//interpolate the brush path to refresh intermediate tiles
	real dx=mx-px;
	real dy=my-py;
	real dist=sqrt(dx*dx+dy*dy);
	int numStep=1+(int)(dist/8);
	for(int i=0; i<numStep; i++)
	{
		real t=(real)i/(numStep-1);
		int lx=lerp(px,mx,t);
		int ly=lerp(py,my,t);

		//for each step we refresh up to 4 tiles (less on the borders)
		int x=clamp(lx-8,176,399);
		int y=clamp(ly-8,0,239);
		
		vec2 tp=getZoomTilePos(x,y);
		byte ref=getZoomTileRef(x,y);

		if(x<383)
			bmpToTile(tp.x,tp.y,2,1,ref,zoomFactor);//refresh 2 tiles at a time
		else
			bmpToTile(tp.x,tp.y,1,1,ref,zoomFactor);
		
		y=clamp(ly+8,0,231);
		tp=getZoomTilePos(x,y);
		ref=getZoomTileRef(x,y);

		if(x<383)
			bmpToTile(tp.x,tp.y,2,1,ref,zoomFactor);
		else
			bmpToTile(tp.x,tp.y,1,1,ref,zoomFactor);
	}
}

void zoomUpdate()
{
	//for small brushes, update touched tiles only
	if(!zoomRefreshAll && inZoom && currentTool==1 && brush<(7-zoomFactor))
	{
		zoomInterpolateTiles();
	}
	else //otherwise update the entire window
	{
		bmpToTile(zoomOriginX,zoomOriginY,14,15,1,zoomFactor);//update all tilestiles
	}
	
//	if(!drawing)//update zoomOut view when finished drawing
	{
		if(zoomFactor==2) zoomOutPosx=(int)((real)zoomOriginX/1.275);
		else if(zoomFactor==3) zoomOutPosx=(int)((real)zoomOriginX/1.524);
		else if(zoomFactor==4) zoomOutPosx=(int)((real)zoomOriginX/1.65);
		
		cpy2zoomOut();
	}
}

void zoomLimits()
{
	byte shift=zoomFactor-1;//24

	int right=200-((14*8)>>shift);//limit to the right border
	int bottom=240-(240>>shift);//limit to the bottom
	zoomOriginX=clamp(zoomOriginX,0,right);
	zoomOriginY=clamp(zoomOriginY,0,bottom);

	//snap to grid for unzoomed fixed grid
	if(grid)
	{
		shift=4-zoomFactor;
		zoomOriginX &= 0xfe<<shift;
		zoomOriginY &= 0xfc<<shift;
	}
}

void toggleZoom()
{
	zoom=!zoom;
	if(zoom)
	{
		byte shift=zoomFactor-1;
		zoomOriginX=mx>>1-(64>>shift);//place zoom at pointer position
		zoomOriginY=my-(128>>shift);
		zoomLimits();
		zoomRefreshAll=true;
		zoomUpdate();//update tiles
		displayZoom();
	}
	else hideZoom();
}

zoomUpdate();

void repaintUI()
{
	if(UI)
	{
		curPos(8,2);
		print("f2");//background windows color, foreground white
	
		byte dBrush;
		if(brush<3)dBrush=brush;
		else dBrush=brushSizes[brush-3]*2+1; 
		if(dBrush<10) print(" ");
		print(dBrush);
	
		curPos(17,2);
		if(shape==1) print("");//square brush
		else if(shape==2) print("∫");//round brush
		else if(shape==3) print("ë");//dithering
		//possibly add more shapes later

		curPos(22,2);
		if (speedDivider==1) print("M");
		else if (speedDivider==0) print("H");
		else print("L");
	
		curPos(28,2);
		print("       ");//clear previous coords
		curPos(28,2);
		print(tx,",",ty);
		
		curPos(41,2);
		print("        ");
		curPos(36,2);
		if(currentImage==MAIN_IMG) print("Main:", fileName);
		else print("Work:", fileName2);
	
		print("");//restore default color
	}
}
repaintUI();

void mouseHoldUpdt()
{
	LMB.wasHeld=LMB.held;
	MMB.wasHeld=MMB.held;
	RMB.wasHeld=RMB.held;
}

bool clicInUI;
bool exit=false;
//----------------------------Main loop-------------------------------
while(!exit)//FCTN + Esc
{
	px=mx;//previous lowres coordinates
	py=my;
	ptx=tx;//previous transformed coordinates
	pty=ty;

	byte previousTool=currentTool;

	mouseUpdt();//update mouse buffered position
	mx=_mouseX>>1;//lowres coordinates
	my=_mouseY>>1;

	// MouseButton states

	LMB.held=_mouse==1;
	LMB.pressed=LMB.held && !LMB.wasHeld;
	LMB.released=!LMB.held && LMB.wasHeld;

	RMB.held=_mouse==2;
	RMB.pressed=RMB.held && !RMB.wasHeld;
	RMB.released=!RMB.held && RMB.wasHeld;

	MMB.held=_mouse==3;
	MMB.pressed=MMB.held && !MMB.wasHeld;
	MMB.released=!MMB.held && MMB.wasHeld;
	
	if(LMB.pressed) lastButton=1;
	else if(RMB.pressed) lastButton=2;

	// Read keyboard

	byte keyDwn=getKeyDwn();//get key from ring buffer (FIFO)
	byte keyUp=getKeyUp();

	// Compute transformed coordinates
	if(inZoom) //inside the zoom window
	{
		int cx=clamp(mx,zwtx>>1,zwbx>>1);//clamp to window if we move out
		int cy=clamp(my,zwty>>1,zwby>>1);
		tx=toZPos(cx,zwtx)+zoomOriginX<<1;
		ty=toZPos(cy,zwty)+zoomOriginY;
	}
	else if(zoom) //zoom is active but we are in the zoomOut area
	{
		//modify x coords according to the zoomOut position
		tx=mx+zoomOutPosx<<1;//byte pos to pixel
		ty=my;
	}
	else //normal coordinates
	{
		tx=mx;
		ty=my;
	}

	bool isMoving = tx!=ptx || ty!=pty;

	// Update infos display
	if(UI && isMoving) repaintUI();

	// UI tests
	if(UI && (LMB.pressed || RMB.pressed))
	{
		//are we in the tool box
		if(isPtrBox(toolPosX,toolPosY,toolPosX+50,toolPosY+204))
		{
			if(isPtrGlyph(0x1a)) currentTool = 1;//draw
			else if(isPtrGlyph(0x81)) currentTool = 2;//line
			else if(isPtrGlyph(0x7f)) currentTool = 3;//rect
			else if(isPtrGlyph(0x01)) currentTool = 4;//box
			else if(isPtrGlyph(0xca)) currentTool = 5;//circle
			else if(isPtrGlyph(0xba)) currentTool = 6;//disk
			else if(isPtrGlyph(0x1c)) currentTool = 7;//fill
			else if(isPtrGlyph(0xcd)) currentTool = 8;//select
			else if(isPtrGlyph(0x1b)) currentTool = 9;//brush
			else if(isPtrGlyph(0x54)) currentTool = 10;//text
			else if(isPtrGlyph(0xf4))
			{
				currentTool = 11;//paste selection tool
				getSelectionDim();
			}
			else if(isPtrGlyph(0xf3) && hasSelection)//copy
			{
				copyIcon=true;
				deselect();
				hideOverRect();
				copySelection();
			}
			//momentary tools
			else if(isPtrGlyph(0x04) && hasSelection && !flipHorizontalIcon)
			{
				flipHorizontalIcon=true;
				zoomRefreshAll=true;
			}
			else if(isPtrGlyph(0x05) && hasSelection && !flipVerticalIcon)
			{
				flipVerticalIcon=true;
				zoomRefreshAll=true;
			}
			else if(isPtrGlyph(0x06) && hasSelection && !rotateLeftIcon)
			{
				rotateLeftIcon=true;
				zoomRefreshAll=true;
			}
			else if(isPtrGlyph(0x07) && hasSelection && !rotateRightIcon)
			{
				rotateRightIcon=true;
				zoomRefreshAll=true;
			}

			if(currentTool!=11) hideOverRect();
			displayToolBox();
			clicInUI=true;
		}
			
		//are we in the palette box
		else if(isPtrBox(colorPosX,colorPosY,colorPosX+40,colorPosY+192))
		{
			if(LMB.pressed) //pick color
			{
				color=(byte)(_mouseY-colorPosY)/24+(byte)((_mouseX-colorPosX)>20)*8;
				paint=true;
				refreshColor();
			}
			else if(RMB.pressed) //pick eraser
			{
				eraser=(byte)(_mouseY-colorPosY)/24+(byte)((_mouseX-colorPosX)>20)*8;
				paint=false;
				refreshColor();
			}
			clicInUI=true;
		}

		//are we in the color editor?
		else if(isPtrBox(colEdWinX,colEdWinY,colEdWinX+60,colEdWinY+132))
		{
			if(isPtrGlyph('¬')) colCompInc(_mouseX/10);//are we over one of the 'increase' buttons?
			if(isPtrGlyph('√')) colCompDec(_mouseX/10);//are we over one of the 'decrease' buttons?
			clicInUI=true;
		}
	}

	//deselection on new clic
	if(hasSelection && (LMB.pressed || RMB.pressed || MMB.pressed))
	{
		deselect();
		displayToolBox();
		zoomRefreshAll=true;
	}

	//reselection of previous selection when reusing the selection tool
	if(previousTool!=8 && currentTool==8)
	{
		initSelection();
		displayToolBox();
		zoomRefreshAll=true;
	}

	//momentary actions/tools
	if(!clicInUI && LMB.pressed)
	{		
		if(currentTool==7)//flood fill
		{
			if(actionPushed) actions[undoId]=0;
			//undo push is handled inside the floodFill function
			floodFill(tx,ty);
			actionPushed=false;
		}
		else if(currentTool==11)//paste overlay rectangle
		{
			if(SHIFT) snapTool();
			hideOverRect();
			if(actionPushed) actions[undoId]=0;
			//undo push is handled inside the pasteSelection function
			pasteSelection(tx,ty);
			actionPushed=false;
		}
	}
	else if(!clicInUI && MMB.pressed)//toggle main->work pages
	{
		if(hasSelection) deselect();
		if(currentTool==11) hideOverRect();
		toggleImage();
		if(UI) repaintUI();
		undoInit();
		if(zoom)
		{
			zoomRefreshAll=true;
			zoomUpdate();
		}
	}
	//icon-based actions
	else if(flipHorizontalIcon)
	{
		if(actionPushed) actions[undoId]=0;
		//undo push is handled inside the flipHorizontal function
		flipHorizontal();
		initSelection();//reselect
		actionPushed=false;
	}
	else if(flipVerticalIcon)
	{
		if(actionPushed) actions[undoId]=0;
		//undo push is handled inside the flipVertical function
		flipVertical();
		initSelection();//reselect
		actionPushed=false;
	}
	else if(rotateLeftIcon)
	{
		if(isRotatable())
		{
			if(actionPushed) actions[undoId]=0;
			//undo push is handled inside the rotateLeft function
			rotateLeft();
			initSelection();//reselect
			actionPushed=false;
		}
	}
	else if(rotateRightIcon)
	{
		if(isRotatable())
		{
			if(actionPushed) actions[undoId]=0;
			//undo push is handled inside the rotateRight function
			rotateRight();
			initSelection();//reselect
			actionPushed=false;
		}
	}

	//continuous actions/tools
	if(!clicInUI && (LMB.held || RMB.held))
	{
		if(currentTool==1)//draw
		{
			zoomRefreshAll=false;
			
			//record for undo
			if(actionPushed) actions[undoId]=0;
			if(brush==1 || brush==2) pushDraw(8, tx, ty, ptx, pty);
			else
			{
				int r = brushSizes[brush-3];
				pushDraw(8+r, tx, ty, ptx, pty);
			}
			actionPushed=false;

			if(brush==1)
			{
				if(shape==3) //dithering
				{
					if(LMB.held)
					{
						if(tx%2==0 && ty%2==0 || (tx%2!=0 && ty%2!=0))
							plot(tx, ty, color);
						else plot(tx, ty, eraser);
					}
						else if(RMB.held) draw(tx, ty, eraser);
				}
				else
				{
					if(LMB.held) draw(tx, ty, color);
					else if(RMB.held) draw(tx, ty, eraser);
				}
			}
			else if(brush==2)
			{
				if(shape==3)//dithering
				{
					if(LMB.held)
					{
						if(tx%2==0 && ty%2==0 || (tx%2!=0 && ty%2!=0))
						{
							plot(tx, ty, color);
							plot(tx+1, ty, eraser);
							plot(tx, ty+1, eraser);
							plot(tx+1, ty+1, color);
						}
						else
						{
							plot(tx, ty, eraser);
							plot(tx+1, ty, color);
							plot(tx, ty+1, color);
							plot(tx+1, ty+1, eraser);
						}
					}
					else if(RMB.held) box(tx, ty, tx+1, ty+1, eraser);
				}
				else
				{
					if(LMB.held) box(tx, ty, tx+1, ty+1, color);
					else if(RMB.held) box(tx, ty, tx+1, ty+1, eraser);
				}
			}
			else //larger brushes
			{
				int r = brushSizes[brush-3];
				if(shape==1)//square brush
				{
					if(LMB.held) box(tx-r, ty-r, tx+r, ty+r, color);
					else if(RMB.held) box(tx-r, ty-r, tx+r, ty+r, eraser);
				}
				else if(shape==2)//round brush
				{
					if(LMB.held) disk(tx, ty, r, color);
					else if(RMB.held) disk(tx, ty, r, eraser);
				}
				else if(shape==3)//dither (drawned with diag lines)
				{
					if(LMB.held)
					{
						if(tx%2==0 && ty%2==0 || (tx%2!=0 && ty%2!=0))
						{
							line(tx-r,ty-r,tx+r,ty+r,color);
							for(int i=1; i<=r; i++)
							{
								line(tx-r+i<<1,ty-r,tx+r,ty+r-i<<1,color);
								line(tx-r,ty-r+i<<1,tx+r-i<<1,ty+r,color);
								line(tx-r+i<<1-1,ty-r,tx+r,ty+r-i<<1+1,eraser);
								line(tx-r,ty-r+i<<1-1,tx+r-i<<1+1,ty+r,eraser);
							}
						}
						else
						{
							line(tx-r,ty-r,tx+r,ty+r,eraser);
							for(int i=1; i<=r; i++)
							{
								line(tx-r+i<<1,ty-r,tx+r,ty+r-i<<1,eraser);
								line(tx-r,ty-r+i<<1,tx+r-i<<1,ty+r,eraser);
								line(tx-r+i<<1-1,ty-r,tx+r,ty+r-i<<1+1,color);
								line(tx-r,ty-r+i<<1-1,tx+r-i<<1+1,ty+r,color);
							}
						}
					}
					else if(RMB.held) box(tx-r, ty-r, tx+r, ty+r, eraser);
				}
			}
		}
		else// other tools
		{
			zoomRefreshAll=true;
			if(!toolHold)//origin
			{
				toolX1=tx; toolY1=ty;
				toolX2=tx; toolY2=ty;
				if(SHIFT) snapTool();
				toolHold=true;
			}
			if(toolHold && isMoving)
			{
				if(currentTool==2)//line
				{
					line(toolX1,toolY1,toolX2,toolY2,0xf0);//restore
					toolX2=tx; toolY2=ty;
					if(SHIFT) snapTool();
					line(toolX1,toolY1,toolX2,toolY2,0xf0);//invert
				}
				else if(currentTool==3 || currentTool==4 || currentTool==8)//rect or box
				{
					rect(toolX1,toolY1,toolX2,toolY2,0xf0);//restore
					toolX2=tx; toolY2=ty;
					if(SHIFT) snapTool();
					rect(toolX1,toolY1,toolX2,toolY2,0xf0);//invert
				}
				else if(currentTool==5 || currentTool==6)//circle or disk
				{
					real u=((real)(toolX2-toolX1))/100;//would be out of range without the divide
					real v=((real)(toolY2-toolY1))/100;
					int r=(int)(sqrt(u*u+v*v)*100);
					circle(toolX1,toolY1,r,0xf0);//restore
					toolX2=tx; toolY2=ty;
					if(SHIFT) snapTool();

					u=((real)(toolX2-toolX1))/100;
					v=((real)(toolY2-toolY1))/100;
					r=(int)(sqrt(u*u+v*v)*100);
					circle(toolX1,toolY1,r,0xf0);//invert
				}
			}
		}	
		if(zoom) zoomUpdate();
	}
	else if(_mouse==0)//release
	{
		zoomRefreshAll = false;
		clicInUI=false;
		if(zoom && isPtrBox(zwtx,zwty,zwbx,zwby)) inZoom=true;
		else inZoom=false;

		if(currentTool==1) skip(tx, ty);
		else if(currentTool==8) zoomRefreshAll = true;
		else if(currentTool==11)
		{
			if(SHIFT) snapTool();
			renderOverRect();
			zoomRefreshAll = true;
		}		

		if(toolHold)
		{
			zoomRefreshAll = true;

			if(currentTool==2)//line
			{
				//record for undo
				//first hide the temporary line by reverting pixels again
				line(toolX1,toolY1,toolX2,toolY2,0xf0);
				plot(toolX1,toolY1,0xf0);
				//then record previous state for undo
				if(actionPushed) actions[undoId]=0;
				pushDraw(4,toolX1,toolY1,toolX2,toolY2);
				actionPushed=false;

				if(lastButton!=2) line(toolX1,toolY1,toolX2,toolY2,color);//draw actual line on release
				else line(toolX1,toolY1,toolX2,toolY2,eraser);//draw actual line on release
			}

			else if(currentTool==3)//rect
			{
				//record for undo
				//first hide the temporary rect by reverting pixels again
				rect(toolX1,toolY1,toolX2,toolY2,0xf0);
				//then record previous state for undo
				if(actionPushed) actions[undoId]=0;
				pushDraw(1,toolX1,toolY1,toolX2,toolY1);
				pushDraw(1,toolX2,toolY1,toolX2,toolY2);
				pushDraw(1,toolX2,toolY2,toolX1,toolY2);
				pushDraw(1,toolX1,toolY2,toolX1,toolY1);
				actionPushed=false;

				if(lastButton!=2) rect(toolX1,toolY1,toolX2,toolY2,color);
				else rect(toolX1,toolY1,toolX2,toolY2,eraser);
			}

			else if(currentTool==4)//box
			{
				//record for undo
				//first hide the temporary rect by reverting pixels again
				rect(toolX1,toolY1,toolX2,toolY2,0xf0);
				if(actionPushed) actions[undoId]=0;
				pushArray(toolX1,toolY1,toolX2,toolY2);
				actionPushed=false;

				if(lastButton!=2) box(toolX1,toolY1,toolX2,toolY2,color);
				else box(toolX1,toolY1,toolX2,toolY2,eraser);
			}

			else if(currentTool==5)//circle
			{
				real u=((real)(toolX2-toolX1))/100;
				real v=((real)(toolY2-toolY1))/100;
				int r=(int)(sqrt(u*u+v*v)*100);
				
				//record for undo
				//first hide the temporary circle by reverting pixels again
				circle(toolX1,toolY1,r,0xf0);
				//then record previous state for undo
				//we record along a circle in a few steps
				if(actionPushed) actions[undoId]=0;
				real TWOPI=6.2832;
				real STEP=TWOPI/18;
				int prevX=clamp(toolX1+r,0,399);
				int prevY=toolY1;				
				for(real angle=STEP; angle<TWOPI; angle+=STEP)
				{
					int x=clamp(toolX1+(int)(cos(angle)*r),0,399);
					int y=clamp(toolY1+(int)(sin(angle)*r),0,239);
					pushDraw(8,x,y,prevX,prevY);
					prevX=x;
					prevY=y;
				}				
				actionPushed=false;
						
				if(lastButton!=2) circle(toolX1,toolY1,r,color);
				else circle(toolX1,toolY1,r,eraser);
			}
			else if(currentTool==6)//disk
			{
				real u=((real)(toolX2-toolX1))/100;
				real v=((real)(toolY2-toolY1))/100;
				int r=(int)(sqrt(u*u+v*v)*100);

				//record for undo
				//first hide the temporary circle by reverting pixels again
				circle(toolX1,toolY1,r,0xf0);
				//then record previous state for undo
				if(actionPushed) actions[undoId]=0;
				pushArray(toolX1-r,toolY1-r,toolX1+r,toolY1+r);
				actionPushed=false;


				if(lastButton!=2) disk(toolX1,toolY1,r,color);
				else disk(toolX1,toolY1,r,eraser);
			}
			else if(currentTool==8)//select
			{
				//first hide the temporary rect by reverting pixels again
				rect(toolX1,toolY1,toolX2,toolY2,0xf0);
				selOrg={toolX1,toolY1};
				selEnd={toolX2,toolY2};
				initSelection();
				displayToolBox();
			}

			toolHold = false;
			zoomRefreshAll = true;
		}
		
		if(zoom) zoomUpdate();

		//push the undo/redo actions
		if(!actionPushed)
		{
			if(currentTool==11) hideOverRect();//to avoid overRect to be baked into the redo
			pushAction();
		}
		
	}

	//release momentary icons
	if(flipHorizontalIcon)
	{
		flipHorizontalIcon=false;
		displayToolBox();
	}
	else if(flipVerticalIcon)
	{
		flipVerticalIcon=false;
		displayToolBox();
	}
	else if(rotateLeftIcon)
	{
		rotateLeftIcon=false;
		displayToolBox();
	}
	else if(rotateRightIcon)
	{
		rotateRightIcon=false;
		displayToolBox();
	}
	else if(copyIcon)
	{
		copyIcon=false;
		displayToolBox();			
	}

	mouseHoldUpdt();
	
	//keys tests
	if(keyDwn != 0)//skip all tests if no keypress
	{
		if(keyDwn==79) FCTN=true;
		else if(keyDwn==71) ALT=true;
		else if(keyDwn==58 || keyDwn==51) SHIFT=true;
		else if(keyDwn==12 && FCTN) exit=true; //FCTN+Esc to exit
		else if(keyDwn==7) //del
		{
			if(FCTN || SHIFT)//full screen clear
			{
				if(actionPushed) actions[undoId]=0;
				pushArray(0,0,399,239);
				actionPushed=false;
				clrBmp();
			}
			else if(hasSelection)//clear selection
			{
				deselect();
				if(actionPushed) actions[undoId]=0;
				pushArray(selOrg.x,selOrg.y,selEnd.x,selEnd.y);
				actionPushed=false;
				box(selOrg.x,selOrg.y,selEnd.x,selEnd.y,0);
				initSelection();
			}
			zoomRefreshAll=true;
		}
	
		else if(keyDwn==67)// ]
		{
			brush++;
			if(brush>10) brush=10;
			repaintUI();
		}
	
		else if(keyDwn==46) // [
		{
			brush--;
			if(brush<1) brush=1;
			repaintUI();
		}
		else if(keyDwn==31) //tab
		{
			toggleUI();
			repaintUI();
		}

		else if(keyDwn==57) //left
		{
			zoomRefreshAll=true;
			zoomOriginX-=zoomSpeed>>(zoomFactor-1);
			zoomLimits();
			if(zoom && grid)
			{
				drawZoomGrid();
				if(UI) displayInfos();
			}
			repaintUI();
		}
		else if(keyDwn==59) //right
		{
			zoomRefreshAll=true;
			zoomOriginX+=zoomSpeed>>(zoomFactor-1);
			zoomLimits();
			if(zoom && grid)
			{
				drawZoomGrid();
				if(UI) displayInfos();
			}
			repaintUI();
		}
		else if(keyDwn==77) //up
		{
			zoomRefreshAll=true;
			zoomOriginY-=2*zoomSpeed>>(zoomFactor-1);
			zoomLimits();
			if(zoom && grid)
			{
				drawZoomGrid();
				if(UI) displayInfos();
			}
			repaintUI();
		}
		else if(keyDwn==80) //down
		{
			zoomRefreshAll=true;
			zoomOriginY+=2*zoomSpeed>>(zoomFactor-1);
			zoomLimits();
			if(zoom && grid)
			{
				drawZoomGrid();
				if(UI) displayInfos();
			}
			repaintUI();
		}
		else if(keyDwn==72) //z
		{
			toggleZoom();
			if(zoom)	zoomRefreshAll=true;
			repaintUI();
			selectCnt=0;
		}
		else if(keyDwn==6) //-		zoom out
		{
			zoomRefreshAll=true;
			zoomFactor--;
			if(zoomFactor<2) zoomFactor=2;
			else
			{
				byte shift=zoomFactor-1;
				zoomOriginX-=32>>shift;//centered zoom out
				zoomOriginY-=64>>shift;
				zoomLimits();
			}
			if(grid)
			{
				drawZoomGrid();
				if(UI) displayInfos();
			}
			repaintUI();
		}
		else if(keyDwn==26) //=	zoom in
		{
			zoomRefreshAll=true;
			zoomFactor++;
			if(zoomFactor>4) zoomFactor=4;
			else
			{
				byte shift=zoomFactor-1;
				zoomOriginX+=64>>shift;//centered zoom in
				zoomOriginY+=128>>shift;
				zoomLimits();
			}
			if(grid)
			{
				drawZoomGrid();
				if(UI) displayInfos();
			}
			repaintUI();
		}
		else if(keyDwn==75) //m for mouse sensitivity
		{
			speedDivider++;
			if(speedDivider>2) speedDivider=0;
			mouseSens(speedDivider);
			repaintUI();
		}
		else if(keyDwn==1) //1 brush shapes
		{
			shape=1;
			repaintUI();
		}
		else if(keyDwn==21) //2
		{
			shape=2;
			repaintUI();
		}
		else if(keyDwn==2) //3
		{
			shape=3;
			repaintUI();
		}
		else if(keyDwn==55) //, pick draw color
		{
			color=pick(tx,ty);

			byte r=peek(bmpPal+color);
			byte g=peek(bmpPal+16+color);
			byte b=peek(bmpPal+32+color);
			if(UI) updateColEd(r,g,b);
		}
		else if(keyDwn==76) //, pick eraser color
		{
			eraser=pick(tx,ty);

			byte r=peek(bmpPal+eraser);
			byte g=peek(bmpPal+16+eraser);
			byte b=peek(bmpPal+32+eraser);
			if(UI) updateColEd(r,g,b);
		}
		else if(keyDwn==15) //g grid
		{
			toggleGrid();
			repaintUI();
			zoomRefreshAll=true;
		}
		else if(keyDwn==33 && FCTN) //FCTN+f for change folder
		{
			changeFolder();
			refreshUI();
			FCTN=false;//force release to avoid multiple calls
		}
		else if(keyDwn==54 && FCTN) //FCTN+n for name file
		{
			if(currentImage==MAIN_IMG)
				enterFileName(&fileName);
			else if(currentImage==WORK_IMG)
				enterFileName(&fileName2);

			FCTN=false;
			refreshUI();
			if(UI) repaintUI();
		}
		else if(keyDwn==17 && FCTN) //FCTN+l for load file
		{
			if(hasSelection) deselect();
			if(currentImage==MAIN_IMG)
			{
				enterFileName(&fileName);
				loadFile(&fileName);
			}	
			else if(currentImage==WORK_IMG)
			{
				enterFileName(&fileName2);
				loadFile(&fileName2);
			}
			undoInit();
			FCTN=false;
			refreshUI();
			if(UI) repaintUI();
			zoomRefreshAll=true;
		}
		else if(keyDwn==32 && FCTN) //FCTN+s for save file
		{
			if(hasSelection) deselect();
			if(currentImage==MAIN_IMG)
				saveFile(&fileName);
			else if(currentImage==WORK_IMG)
				saveFile(&fileName2);
			
			FCTN=false;
			undoInit();
		}
		else if(keyDwn==44 && FCTN) //FCTN+u for undo
		{
			if(hasSelection) deselect();
			hideOverRect();
			zoomRefreshAll=true;
			undo();
		}
		else if(keyDwn==14 && FCTN) //FCTN+d for redo
		{
			if(hasSelection) deselect();
			hideOverRect();
			zoomRefreshAll=true;
			redo();
		}
		else if(keyDwn==45 && FCTN) //FCTN+o for copy selection
		{
			if(hasSelection)
			{
				deselect();
				hideOverRect();
				copySelection();
				displayToolBox();
			}
		}
		else if(keyDwn==66 && FCTN) //FCTN+p for paste selection
		{
			currentTool = 11;//paste selection tool
			getSelectionDim();
			displayToolBox();
		}
		
		if(zoom) zoomUpdate();
	}
	
	if(keyUp==79) FCTN=false;
	else if(keyUp==71) ALT=false;
	else if(keyUp==58 || keyUp==51) SHIFT=false;
	
	if(hasSelection)
	{
		if(zoom)
		{
			toggleSelection(1);
			zoomRefreshAll=true;
		}
		else toggleSelection(150);
	}
	
	if(DEBUG)
	{
		byte x=15; byte y=27;
		curPos(x,y++); print("currentTool: ",currentTool," ");
		curPos(x,y++); print("toolHold: ",toolHold," ");
		curPos(x,y++); print("hasSelection: ",hasSelection," ");
		curPos(x,y++); print("zoom: ",zoom," ");
		curPos(x,y++); print("inZoom ",inZoom," ");
		curPos(x,y++); print("zoomFactor: ",zoomFactor," ");
		curPos(x,y++); print("zoomRefreshAll: ",zoomRefreshAll," ");
		curPos(x,y++); print("zoomOrg(x,y) ",zoomOriginX,",",zoomOriginY," ");
		curPos(x,y++); print("(tx,ty) ",tx,",",ty," ");
		curPos(x,y++); print("(ptx,pty) ",ptx,",",pty," ");
		curPos(x,y++); print("isMoving: ",isMoving," ");
		curPos(x,y++); print("isRotatable: ",isRotatable()," ");		
	}
}

//exit program
bmpPage=0x60;
clrBmp();

ptrShape(0);//back to arrow pointer

mouseSens(0);

//restore initial registers
import("/system/reginit.dat",0x1100,0);
