//Now we draw two columns of color boxes to represent the color selector
//Then we copy those boxes to a sprite set.
//We do this because we do not want to change the text color palette
//nor use bitmap for the UI.
//A problem that plagued Deluxe Paint on Amiga, the UI depended on the
//first two color of the palette. If those two colors were close together
//the UI was barely visible.
//By using sprites to display the color palette, we avoid this problem.

byte col;
for(byte x; x<2; x++)
{
	for(byte y; y<8; y++)
	{
		box(0+x*10,y*12,9+x*9,12+y*12,col);//draw color boxes in the bitmap
		col++;
	}
}

bmpToSpr(0,0,1,5,0);//copy to sprite set. 5 sprites required to cover all boxes

clrBmp();

void displayColorBoxes()
{
	for(byte i; i<5; i++)//display sprites
	{
		sprPos(i,48+colorPosX,42+colorPosY+i*42);
		sprRef(i,i);
		sprPal(i,0);
	}
	sprUpdt();
}

//we also need to be able to hide the color boxes
void hideColorBoxes()
{
	for(byte i; i<5; i++) sprPos(i,0,0);
	sprUpdt();
}

