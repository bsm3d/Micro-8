//--zoom grid

//We use the character layer to draw the zoom grid (used for tile editing)
//However, character glyphs are 10x12 hires pixels and do not align with
//16 lowres tile pixels. So we need a custom glyph set to create an
//aligned grid.
//To do so, we redefine micro-8 logo and the large disk glyphs into grid
//elements that match the 16 lowres pixels tile grid

//The grid data itself have been precomputed in the "data/xxxx.dat" files
//and are used in the showZoomGrid() function above.

byte zoomGlyphId[24]={0x20,
					0xe6,0xe7,0xe8,0xe9,0xea,0xeb,0xec,0xed,0xee,0xef,
					0xf6,0xf7,0xf8,0xf9,0xfa,0xfb,0xfc,0xfd,0xfe,0xff,
					0xd2,0xd3,0xe2};

void zoomGenGlyphs()
{
	for(byte b; b<23; b++)
	{
		nat addr=zoomGlyphId[b+1]*120; //index 0 is for ' '
	
		for(byte y; y<12; y++)
			for(byte x; x<10; x++)
			{
				bool bit;
				if(b>=20) bit=x%5==0 && y==(((b-20)%4)*4);
				else bit=y%4==0 && x==(b%5)*2 || x%4==0 && y==((b/5)%4)*4;
				glyphSet(addr++,bit);
			}
	}
}
zoomGenGlyphs();

text gridData128[16]={	"data/128x0y0.dat",
								"data/128x3y0.dat",
								"data/128x2y0.dat",
								"data/128x1y0.dat",
								"data/128x0y3.dat",
								"data/128x3y3.dat",
								"data/128x2y3.dat",
								"data/128x1y3.dat",
								"data/128x0y2.dat",
								"data/128x3y2.dat",
								"data/128x2y2.dat",
								"data/128x1y2.dat",
								"data/128x0y1.dat",
								"data/128x3y1.dat",
								"data/128x2y1.dat",
								"data/128x1y1.dat" };

void drawZoomGrid() //includes separator (baked-in)
{
	if(zoomFactor==2)
	{
		import2D("data/32x0y0.dat",0x1200+35,80,45,40);
	}
	else if(zoomFactor==3)
	{
		bool offsetX=(zoomOriginX/4)%2==1;
		bool offsetY=(zoomOriginY/8)%2==1;
		if(offsetX && offsetY) import2D("data/64x1y1.dat",0x1200+35,80,45,40);
		else if(offsetX) import2D("data/64x1y0.dat",0x1200+35,80,45,40);
		else if(offsetY) import2D("data/64x0y1.dat",0x1200+35,80,45,40);
		else import2D("data/64x0y0.dat",0x1200+35,80,45,40);
	}
	else if(zoomFactor==4)
	{
		int i=(zoomOriginX/2)%4+4*((zoomOriginY/4)%4);
		import2D(gridData128[i],0x1200+35,80,45,40);
	}	
}

void showZoomGrid()
{
	areaSet(0x1e80,80,35,0,45,40,0x01);
	drawZoomGrid();
}

void hideZoomGrid()
{
	areaSet(0x1e80,80,35,0,45,40,0x01);
	areaSet(0x1200,80,35,0,45,40,' ');	
}

void drawZoomSeparator()
{
	areaSet(0x1e80,80,35,0,1,40,0x01);
	areaSet(0x1200,80,35,0,1,40,'í');
}

void refreshUI()
{
	if(UI)
	{
		if(zoom && grid) drawZoomGrid();
		if(zoom && !grid) drawZoomSeparator();
		displayToolBox();
		displayColorBoxes();
		displayInfos();
		byte r; byte g; byte b;
		r=peek(bmpPal+color);
		g=peek(bmpPal+color+16);
		b=peek(bmpPal+color+32);
		updateColEd(r,g,b);
	}
	else
	{
		hideToolBox();
		hideColorBoxes();
		hideInfos();
		hideColEd();
		clrMsg();
		if(zoom && grid) drawZoomGrid();
		if(zoom && !grid) drawZoomSeparator();
	}
}

refreshUI();//UI visible by default

void toggleUI()
{
	UI = !UI;
	refreshUI();
}

