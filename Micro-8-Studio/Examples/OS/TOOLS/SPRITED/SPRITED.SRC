//Micro-8 Built-in sprite editor program
//This program is provided 'as is' without warranty of any kind.
//You are free to use, copy, modify, distribute, license, sell.

//Version 0.5 Franck Sauer

//Although the hardware supports up to 256 sprite images (64 KiB),
//in SpritEd, the sprite set is limited to a maximum of 184 images.

//The main reason is the visibility window of the cpu which is 48KiB.
//That covers 192 sprites. But 8 sprites are used for the UI (see below).

//If you need the full 256 sprites for your game, just create and load
//multiple smaller sets.
//Example: Hero set, ennemi set, boss set...

//In general, I don't think it is practical to edit all sprites in a single
//huge set anyways.

//Last 8 sprites are used for the UI:
//187-191 used for palette display(5)
//186 used for checker pattern (to display unused sprite in modes 0-2)
//184-185 used for AABB corners(2)
//so the max number of editable sprite images is 184 (0-183)

//init registers
import("/system/reginit.dat",0x1100,0);

nat setSize=192*256-8*256;

byte mode;//0single 1two vertical 2two horizontal 3four
byte stride=1;//mode 0single sprite

int currentRef;//the ref to the sprite data currently being edited
int maxRef=183;

byte checkerCol=1;//color used for checker pattern

bool hold;
bool FCTN;
bool CTRL;
bool ALT;

int start=0;
int end=19;//the size-1 of the set at startup. Change this if you want a
//larger set at startup. Max end is 183.

int loopStart=start;
int loopEnd=end;
int FPS=10;
nat MS=(nat)(1000/FPS);//fps to ms
int frame;
bool looping=true;
bool pingpong;
bool playing;
bool stop=true;
bool reverse;
text valTxt={3};//text to hold text input from values boxes

byte speedDivider=1;//defaults to a slower mouse speed for more precision pixelling
mouseSens(speedDivider);

int zoomPosX=138;//hires pos
int zoomPosY=64;
int zoomSizeX=12*16*2;//hires size x 12 tiles
int zoomSizeY=11*16*2;
byte zoomCharPosX=(byte)(zoomPosX/10);
byte zoomCharPosY=(byte)(zoomPosY/12);
byte zoomCharSizeX=(byte)(zoomSizeX/10);
byte zoomCharSizeY=(byte)(zoomSizeY/12);
