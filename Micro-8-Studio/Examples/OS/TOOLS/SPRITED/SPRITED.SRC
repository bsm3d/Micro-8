byte AABB[4]; //x1,y1,x2,y2

void setAABB()
{
	nat addr=cpuWindow+(nat)currentRef*256+252;
	poke(addr+0,AABB[0],sprPage);
	poke(addr+1,AABB[1],sprPage);
	poke(addr+2,AABB[2],sprPage);
	poke(addr+3,AABB[3],sprPage);
}

void getAABB()
{
	nat addr=cpuWindow+(nat)currentRef*256+252;
	AABB[0]=peek(addr+0,sprPage);
	AABB[1]=peek(addr+1,sprPage);
	AABB[2]=peek(addr+2,sprPage);
	AABB[3]=peek(addr+3,sprPage);
}

void showAABB()
{
	sprPos(9,zoomPosX+51+AABB[0]*8,zoomPosY+44+AABB[1]*8);
	sprPos(10,zoomPosX+6+AABB[2]*8,zoomPosY+4+AABB[3]*8);
	sprUpdt();
}

void hideAABB()
{
	sprPos(9,0,0);
	sprPos(10,0,0);
	sprUpdt();
}
hideAABB();

//sprite preview
void updateSprPrev()
{
	if(mode==0)
	{
		sprRef(0,(byte)currentRef);
		sprRef(1,186);
		sprRef(2,186);
		sprRef(3,186);
	}
	else if(mode==1)
	{
		sprRef(0,(byte)currentRef);
		sprRef(1,186);
		sprRef(2,(byte)currentRef+1);
		sprRef(3,186);
	}
	else if(mode==2)
	{
		sprRef(0,(byte)currentRef);
		sprRef(1,(byte)currentRef+1);
		sprRef(2,186);
		sprRef(3,186);
	}
	else if(mode==3)
	{
		sprRef(0,(byte)currentRef);
		sprRef(1,(byte)currentRef+1);
		sprRef(2,(byte)currentRef+2);
		sprRef(3,(byte)currentRef+3);
	}
}
updateSprPrev();

