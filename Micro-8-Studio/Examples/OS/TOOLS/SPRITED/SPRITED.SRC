poke(gfxModes, 0b00111110);//turn off bitmap, turn on sprites,tiles & opaque


//------------------Memory configuration--------------


nat scratchPad=0xf000;//working buffer for sprite display
// scratchPad+256  copy/paste buffer (256, 512 or 1024 bytes depending on mode)

nat sprPalA=0x11d0; //first sprite palette
nat sprPalB=0x2fa0; //second sprite palette
nat bmpPal=0x11a0;
nat tilePal=0x1170;
nat textPal=0x1140;

nat tileBufferA=0x2b00;

//The tileset is used for displaying zoom and takes 12x11=132 tiles
byte sprPage=0x20; //page for sprites in XSRAM: 0x08000
byte bmpPage=0x60; //page for bitmap in XSRAM: 0x18000
nat cpuWindow=0x3000; //default memory mapping (where the cpu sees XSRAM)
nat bmpScanoutPageReg=0x2f05;
nat bmpDrawPageReg=0x2f16;
nat sprPageReg=0x2f04;

//we move the spriteset and bitmap segments positions in the XSRAM
poke(bmpScanoutPageReg,bmpPage);
poke(bmpDrawPageReg,bmpPage);
poke(sprPageReg,sprPage);

memSet(0x1200,3200,' ');//clear char glyph and color buffer
memSet(0x1e80,3200,0);
memSet(tileBufferA,1024,0);//clear tile buffers A & B (512 bytes each)
memSet(cpuWindow,setSize,0,sprPage);//clear sprite set

//init all sprite instances
for(byte i; i<32; i++)
{
	sprPal(i,0);
	sprPrio(i,0);
	sprRef(i,0);
	sprPos(i,0,0);
	sprFlip(i,false,false);
}
sprUpdt();

//Utility functions

void clrBmp()
{
	//clear lower half of the bitmap
	//where the dynamic draw will happen
	//no need to clear all bitmap as it is not visible (only used as temp
	//draw buffer)
	memSet(0x3000,24000,0,bmpPage);
}
clrBmp();

void clrTls()
{
	memSet(0x3000,12*11*128,0,0);
}
clrTls();

void clrMsg()
{
	areaSet(0x1200,80,msgPosX,msgPosY,65-msgPosX,1,0);
	areaSet(0x1e80,80,msgPosX,msgPosY,65-msgPosX,1,0);
}

void charCol(byte x, byte y, byte col)//change character foreground color
{
	nat address=0x1e80+x+y*80;
	poke(address,peek(address)&0xf0|col);
}

void backCol(byte x, byte y, byte col)//change character background color
{
	nat address=0x1e80+x+y*80;
	poke(address,peek(address)&0x0f|col<<4);
}

int txt2Int(nat addr)
{
	byte size;
	while(peek(addr+size)!=0) size++;
	int acc;
	int rank=1;
	for(int i=size-1; i>=0; i--)//from right to left
	{
		int val=peek(addr+(nat)i)-48;//ASCII to numeric value
		if(val<0 || val>9)continue;//skip non numeric character
		acc+=val*rank;
		rank*=10;//next decimal rank
	}
	return acc;
}

//-------------------initial colors
//set first system color the same as background color
poke(textPal,5);//R
poke(textPal+16,5);//G
poke(textPal+32,5);//B

byte sysCol[48];//backup system text colors to a byte array
memCpy(textPal,&sysCol,48);//src,dest,size

//we create two working palettes we can choose from
byte palA[48];
byte palB[48];

//copy system colors to first palette (to get some initial colors)
memCpy(textPal,&palA,48);

//Some text colors are used for the GUI

//text col 15 is used for windows background
poke(textPal+15,5);//R    Change color used for windows background
poke(textPal+16+15,5);//G
poke(textPal+32+15,5);//B

//text col 3 is used for greyed out icons (not yet implemented)
poke(textPal+3,4);//R    Change color used for windows background
poke(textPal+3+16,4);//G
poke(textPal+3+32,4);//B



//text col 4 is used to display current paint color in the col editor
//text col 6 is used to display current eraser color in the col editor
void copyPal()
{
	if(currentPal==0) memCpy(&palA,sprPalA,48);
	else memCpy(&palB,sprPalA,48);

	for(byte c=0; c<48; c+=16)
	{
		for(byte i; i<16; i++) poke(tilePal+c+i,peek(sprPalA+c+i));
		for(byte i; i<16; i++) poke(bmpPal+c+i,peek(sprPalA+c+i));
		poke(textPal+c+4,peek(sprPalA+c+color));
		poke(textPal+c+6,peek(sprPalA+c+eraser));
	}
}

void palA2B()
{
	memCpy(&palA,&palB,48);
}

void palB2A()
{
	memCpy(&palB,&palA,48);
}


//copy a sprite image to bitmap
void sprToBmp(byte ref, nat offset) //ref in the spriteset, offset in bitmap
{
	nat addr = 0x3000+256*ref;
	memCpy(addr, scratchPad, 252, sprPage);//copy sprite data to scratchpad

	for(byte i; i<21; i++)//copy sprite from scratchpad to bitmap
	{
		memCpy(scratchPad+i*12, 0x3000+offset+i*200, 12, bmpPage);
	}
}

//update bitmap with current sprite(s) (or checker when unused)
void updateBmp()
{
	if(mode==0)//single sprite
	{
		sprToBmp((byte)currentRef,0);
		sprToBmp(186,12);
		sprToBmp(186,21*200);
		sprToBmp(186,12+21*200);
	}
	else if(mode==1)//two vertical sprites
	{
		sprToBmp((byte)currentRef,0);
		sprToBmp(186,12);
		sprToBmp((byte)currentRef+1,21*200);
		sprToBmp(186,12+21*200);
	}
	else if(mode==2)//two horizontal sprites
	{
		sprToBmp((byte)currentRef,0);
		sprToBmp((byte)currentRef+1,12);
		sprToBmp(186,21*200);
		sprToBmp(186,12+21*200);
	}
	else if(mode==3)//four sprites
	{
		sprToBmp((byte)currentRef,0);
		sprToBmp((byte)currentRef+1,12);
		sprToBmp((byte)currentRef+2,21*200);
		sprToBmp((byte)currentRef+3,12+21*200);
	}
}

