//------------File management

text sprFullPath={64};//arbitrary values, can be larger if necessary
text palAFullPath={64};
text palBFullPath={64};
text folder={32};
folder="sprites";//default folder

void changeFolder()
{
	curPos(msgPosX,msgPosY);
	print("Change folder to: ");
	input(folder,32);
	clrMsg();
}

text fileName={8};//name without extension (file must be in the same folder)
fileName="default";

text sprName={12};//name with extension
text palAName={12};//name with extension
text palBName={12};

void enterFileName()
{
	curPos(msgPosX,msgPosY);
	print("Enter file name (without extension): ");
	input(fileName,8);
	clrMsg();
}

void appendExtensions()
{
	memCpy(&fileName,&sprName,$fileName);//source, destination, include nullchar
	concat(sprName,".spr");

	memCpy(&fileName,&palAName,$fileName);
	concat(palAName,".pla");

	memCpy(&fileName,&palBName,$fileName);
	concat(palBName,".plb");
}

void buildFullPathNames()
{
	memCpy(&folder, &sprFullPath,$folder);
	concat(sprFullPath,"/");
	concat(sprFullPath,sprName);

	memCpy(&folder, &palAFullPath,$folder);
	concat(palAFullPath,"/");
	concat(palAFullPath,palAName);

	memCpy(&folder, &palBFullPath,$folder);
	concat(palBFullPath,"/");
	concat(palBFullPath,palBName);
}

void cleanupNames()
{
	memSet(&sprName,12,0);//clear names
	memSet(&palAName,12,0);
	memSet(&sprFullPath,64,0);
	memSet(&palAFullPath,64,0);
	memSet(&palBFullPath,64,0);
}

void loadFile()
{
	txtWin(msgPosX,msgPosY,79,msgPosY+1);//in case of file error message
	curPos(msgPosX,msgPosY);

	appendExtensions();
	buildFullPathNames();

	import(palAFullPath,&palA,48);
	import(palBFullPath,&palB,48);

	import(sprFullPath,cpuWindow,0,sprPage);//load sprite set
	end=_fSize/256-1;

	cleanupNames();
	copyPal();
	txtWin(0,0,79,39);//back to default window
}

void saveFile()
{
	txtWin(msgPosX,msgPosY,79,msgPosY+1);//setup msg window
	curPos(msgPosX,msgPosY);
	appendExtensions();
	buildFullPathNames();
	export(sprFullPath,cpuWindow,((nat)end+1)*256,sprPage);//save sprite set
	
	export(palAFullPath,&palA,48);
	export(palBFullPath,&palB,48);

	print("'",fileName,"' saved successfully !");
	msgDelay=0;

	cleanupNames();

	txtWin(0,0,79,39);//back to default window
}

