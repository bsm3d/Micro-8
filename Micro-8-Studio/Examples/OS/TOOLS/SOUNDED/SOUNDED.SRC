//          ----------Voice allocator functions-----------
type Voice
{
	bool active;
	int key;
	int age;
};

Voice voices[6];//max polyphony
int allocCounter;

void initVoices()
{
	for(int i; i<#voices; i++)
	{
		voices[i].active=false;
		voices[i].key=-1;
		voices[i].age=0;
	}
	allocCounter=0;
}

int findVoiceByKey(int key)
{
	for(int i; i<#voices; i++)
	{
		if(voices[i].active && voices[i].key==key) return i;
	}
	return -1;
}

int findFreeVoice()
{
	for(int i; i<#voices; i++)
	{
		if(!voices[i].active) return i;
	}
	return -1;
}

int stealVoice()
{
	int best;
	int bestAge=voices[0].age;
	for(int i; i<#voices; i++)
	{
		if(voices[i].age<bestAge)
		{
			best=i;
			bestAge=voices[i].age;
		}
	}
	return best;
}

byte allocVoice(int key)
{
	int v=findVoiceByKey(key);
	if(v>=0) return (byte)v;
	v=findFreeVoice();
	if(v<0) v=stealVoice();
	voices[v].active=true;
	voices[v].key=key;
	voices[v].age=allocCounter;
	return (byte)v;
}

int releaseVoice(int key)
{
	int v=findVoiceByKey(key);
	if(v<0) return -1;
	voices[v].active=false;
	voices[v].key=-1;
	return v;
}

//				-------------minimal MIDI support--------------
type midiEvent
{
	byte t;
	byte ch;
	byte p1;
	byte p2;	
};

midiEvent midiGet()
{
	midiEvent mE;
	mE.t=peek(0xffd0); //Event type (e.g. note ON)
	mE.ch=peek(0xffd1); //Channel
	mE.p1=peek(0xffd2); //First parameter (e.g. note number)
	mE.p2=peek(0xffd3); //Second parameter (e.g. velocity)
	return mE;
}


//        ------------------ADC & YM2612 setup-----------------

adcSampleL();
ymInit(0);//set master tune and generate internal notes table
adcSampleR();

ymLFO(true,0);//0-7 range. 0 is the slowest
ymSetReg(0,0x2a,0);//dac value to 0
ymSetReg(0,0x2b,0);//dac disabled


ymVol(127);//Global volume 0-127

byte instr=0;//current instrument
byte octave=4;//current octave
byte voice=0;//current voice
byte pan=0b11;//00=off 01=right 10=left 11=center
byte vol=127;//current voice volume

void setupVoices()
{
	for(byte v; v<#voices; v++) ymVoice(v,instr,octave,pan,vol);//setup voice
}
setupVoices();

