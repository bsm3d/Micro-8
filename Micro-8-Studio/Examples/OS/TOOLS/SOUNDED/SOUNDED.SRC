type charPos
{
	byte x;
	byte y;
};

type vWidget //value widget
{
	byte posX;//position in character coordinates
	byte posY;

	int BBx0;//bounding box for quick mouse detection
	int BBy0;
	int BBx1;
	int BBy1;

	int minVal;//value limits
	int maxVal;

	//The modified propery is directly mapped to the instrument parameter
	byte YMparamID;

	byte digits;//number of display digits

	bool up;//up arrow is clicked
	bool down;//down arrow is clicked
	bool drag;//middle bar is clicked
	real speed;//changing speed when draging (computed automatically at instantiation)
};

type opWindow //operator window
{
	byte posX;//position in character coordinates
	byte posY;

	int BBx0;//bounding box for quick mouse detection
	int BBy0;
	int BBx1;
	int BBy1;

	byte wFirst;//position in the widget array of the first widget for this window
	byte wLast;//position of last widgets for this window
	
	bool am;
	bool on;
};

