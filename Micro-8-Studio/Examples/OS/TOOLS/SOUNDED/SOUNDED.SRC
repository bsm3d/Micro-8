byte LFOposX=68;
byte LFOposY=18;

void LFOcheckBoxUpdate()
{
	int x0=(LFOposX+4)*10;
	int y0=(LFOposY+6)*12;
	if(mouseHold==-1 && isPtrBox(x0,y0,x0+10,y0+12))
	{
		if(_mouse==1)
		{
			LFOActive=!LFOActive;
			curPos(LFOposX+4,LFOposY+6);
			if(LFOActive)print("");else print("");
			ymLFO(LFOActive,LFOValue);
			mouseHold=-2;
		}
	}	
}
LFOcheckBoxUpdate();

void opRenderCheckBoxes(byte opWinID)
{
	curPos(opWindows[opWinID].posX+25,opWindows[opWinID].posY+13);
	if(opWindows[opWinID].am)print("");else print("");
	
	curPos(opWindows[opWinID].posX+25,opWindows[opWinID].posY+15);
	if(opWindows[opWinID].on)print("");else print("");
}

//widget update and render for current active window
void opUpdate()
{
	for(byte i; i<opWinID; i++)
	{
		if((mouseHold>=opWindows[i].wFirst && mouseHold<opWindows[i].wLast) || 
			isPtrBox(opWindows[i].BBx0,opWindows[i].BBy0,opWindows[i].BBx1,opWindows[i].BBy1))
		{
			//value widgets
			for(byte j=opWindows[i].wFirst; j<opWindows[i].wLast; j++)
			{
				vWidgetUpdate(j);
			}
			//curve
			if(mouseHold!=-1)//only redraw on change
			{
				int x=opWindows[i].BBx0/2+3;
				int y=opWindows[i].BBy0/2+3;
				drawYMEnv(i, x, y, 129, 41);//op, x, y, w, h
			}
			//checkboxes
			if(mouseHold==-1 && (isPtrGlyph(0x7f) || isPtrGlyph(1)))//hovering a  or a 
			{
				if(_mouse==1)
				{
					if((_mouseY>opWindows[i].BBy0+13*12) && (_mouseY<opWindows[i].BBy0+14*12))
					{
						opWindows[i].am=!opWindows[i].am;
						ymSetParam(instr,5+i*10,opWindows[i].am);
					}
					else if((_mouseY>opWindows[i].BBy0+15*12) && (_mouseY<opWindows[i].BBy0+16*12))
					{
						opWindows[i].on=!opWindows[i].on;
						byte param=ymGetParam(instr,44);
						if(opWindows[i].on)
						{
							if(i==1)ymSetParam(instr,44,param|0b0100);//op order != reg order
							else if(i==2)ymSetParam(instr,44,param|0b0010);
							else ymSetParam(instr,44,param|(1<<i));//set bit
						}
						else
						{
							if(i==1)	ymSetParam(instr,44,param&0b1011);
							else if(i==2)ymSetParam(instr,44,param&0b1101);
							else ymSetParam(instr,44,param&(~(1<<i)));//clear bit
						}
					}
					mouseHold=-2;
				}
			}
			opRenderCheckBoxes(i);
		}
	}
}

void opRefresh()
{
	for(byte i; i<vWidgetID; i++) vWidgetRender(i);
	for(byte i; i<opWinID; i++)
	{
		int x=opWindows[i].BBx0/2+3;
		int y=opWindows[i].BBy0/2+3;
		drawYMEnv(i, x, y, 129, 41);//op, x, y, w, h

		opWindows[i].am=(bool)ymGetParam(instr,5+i*10);

		bool opEnabled;//again op 1&2 are inverted. See YM2612 doc.
		if(i==1) opEnabled=(bool)(ymGetParam(instr,44) & 0b0100);
		else if(i==2) opEnabled=(bool)(ymGetParam(instr,44) & 0b0010);
		else opEnabled=(bool)(ymGetParam(instr,44) & (1<<i));
		
		opWindows[i].on=opEnabled;
		opRenderCheckBoxes(i);
	}
}

void updateNames(bool refresh)
{
	int numPosX=namesPos.x*10;
	int numPosY=(namesPos.y+3)*12;
	if(refresh || mouseHold==-1 && isPtrBox(numPosX,numPosY,numPosX+13*10,numPosY+20*12))
	{
		if(refresh || _mouse==1)
		{
			if(_mouse==1)//update current instr if click
			{
				byte index=(byte)((_mouseY-numPosY)/24);
				instr=index;
				setupVoices();
				opRefresh();
				algoUpdate(true);
				mouseHold=-2;
			}
			for(byte i; i<10; i++)
			{
				byte x=namesPos.x+1;
				byte y=namesPos.y+3+i*2;

				curPos(x,y);//numbers
				if(i==instr)
					print("2",i,"");
				else
					print(i);
				
				x+=2;//names
				curPos(x,y);
				print("        ");//clear line
				curPos(x,y);
				if(i==instr)
					print("2",instrNames[i],"");
				else
					print(instrNames[i]);
			}
			if(refresh)
			{
				opRefresh();
				algoUpdate(true);
			}
		}
	}
}

void octaveUpdate()
{
	if(mouseHold==-1 && isPtrGlyph('Á'))
	{
		if(_mouse==1)
		{
			octaveDwn=true;
			if(octave>0) octave--;
			setupVoices();
			mouseHold=-2;
		}
		else octaveDwn=false;
	}
	else if(mouseHold==-1 && isPtrGlyph('À'))
	{
		if(_mouse==1)
		{
			octaveUp=true;
			if(octave<7) octave++;
			setupVoices();
			mouseHold=-2;
		}
		else octaveUp=false;
	}
	octaveRender();
}

void renderWaveform()
{
	//set new bitmap windows to clip drawings
	bmpWin(337,15,399,43);
	bmpOrg(337,15);
	box(0,0,62,28,0);//clear top window

	//display waveforms using Analog to Digital Converter values
	skip(0,15);
	for(int x; x<62; x+=3)//left channel
	{
		adcSampleL();
		int left=(int)(((nat)(_adcL+512))>>3)-49;
		draw(x,left,5);
	}

	bmpWin(337,57,399,85);
	bmpOrg(337,57);
	box(0,0,62,28,0);//clear bottom window

	skip(0,15);
	for(int x; x<62; x+=3)
	{
		adcSampleR();
		int right=(int)(((nat)(_adcR+512))>>3)-49;
		draw(x,right,14);
	}
}

//create and display the 4 operators windows
displayTYOperator(0,13+0,0);
displayTYOperator(1,13+27,0);
displayTYOperator(2,13+0,17);
displayTYOperator(3,13+27,17);


//the rest
displayChip(0,0);

displayAlgo(4,34);

displayFeedback(19,34);

displayKeyboard(26,34);
displayModulation(56,34);

displayNames(namesPos.x, namesPos.y);
updateNames(true);
displayToolbox(0,30);

displayWaveform(67,0);
displayGlobals(67,15);

displayLFO(LFOposX,LFOposY);


//-------Main loop----------
bool FCTN;
bool exit;
while(!exit)
{
	mouseUpdt();
	if(_mouse == 0) mouseHold=-1;

	opUpdate();	
	algoUpdate(false);
	vWidgetUpdate(feedbackWidget);
	vWidgetUpdate(ampModWidget);
	vWidgetUpdate(freqModWidget);
	vWidgetUpdate(LFOWidget);
	LFOcheckBoxUpdate();
	octaveUpdate();
	updateNames(false);

	if(midiUpdt())//if there is at least an event available in the queue
	{
		midiEvent mE=midiGet();//get event
		if(mE.t==0x90 && mE.p2>0)//check for Note ON event type
		{
			ymNoteOn(allocVoice(mE.p1),mE.p1,mE.p2);
		}
		else if(mE.t==0x80 || mE.t==0x90 && mE.p2==0)//some devices send note OFF as note ON with velocity=0
		{
			int voice=releaseVoice(mE.p1);
			if(voice>=0)	ymNoteOff((byte)voice);
		}
	}
	
	//keyboard
	byte keyDwn=getKeyDwn();
	byte keyUp=getKeyUp();

	if(keyDwn==12 && FCTN) exit=true; //FCTN+Esc to exit
	else if(keyDwn==79) FCTN=true;
	else if(keyDwn==33 && FCTN) //FCTN+f for change folder
	{
		changeFolder();
		FCTN=false;
	}
	else if(keyDwn==54 && FCTN) //FCTN+n for name file
	{
		enterFileName();
		updateNames(true);
		FCTN=false;
	}
	else if(keyDwn==17 && FCTN) //FCTN+l for load file
	{
		enterFileName();
		loadFile();		
		updateNames(true);
		opRefresh();	
		FCTN=false;
	}
	else if(keyDwn==32 && FCTN) //FCTN+s for save file
	{
		saveFile();
		FCTN=false;
	}
	else if(keyDwn && findVoiceByKey(keyDwn)==-1)//all other keys for notes
	{
		ymNoteOn(allocVoice(keyDwn),keyNoteMap[keyDwn-1],128);
	}

	if(keyUp)
	{
		int voice=releaseVoice(keyUp);
		if(voice>=0) ymNoteOff((byte)voice);
		if(keyUp==79) FCTN=false;
	}

	renderWaveform();
}

ymNoteOff(voice);
