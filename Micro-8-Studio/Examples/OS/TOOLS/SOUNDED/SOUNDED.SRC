void msgWindow(charPos pos, charPos size)
{
	areaCpy(0x1200,80,pos.x,pos.y,size.x,size.y,0xf000,size.x,0,0);//save to scratchpad
	txtWin(pos.x,pos.y,pos.x+size.x,pos.y+size.y);
	curPos(pos.x,pos.y);
	print("‰Š");
	print("€                                                   €");
	print("ˆ‡");
	curPos(pos.x+1,pos.y+1);
	txtWin(0,0,79,39);
}

void msgRestore(charPos pos, charPos size)//copy back from scratchpad
{
	areaCpy(0xf000,size.x,0,0,size.x,size.y,0x1200,80,pos.x,pos.y);
}
							
void changeFolder()
{
	msgWindow(msgPos,msgSize);
	print("Change folder to:");
	input(folder,32);
	print("");
	msgRestore(msgPos,msgSize);
}

text fullName={12};//name with extension

void enterFileName()
{
	msgWindow(msgPos,msgSize);
	print("Enter file name (without extension):");
	input(instrNames[instr],8);
	msgRestore(msgPos,msgSize);
}

void appendExtensions()
{
	nat size=txtSize(peekW(&instrNames[instr]));
	memCpy(peekW(&instrNames[instr]),&fullName,size+1);//source, destination, include nullchar
	concat(fullName,".ins");
}

void buildFullPathNames()
{
	memCpy(&folder, &fullPath,$folder);
	concat(fullPath,"/");
	concat(fullPath,fullName);
}

void loadFile()
{
	appendExtensions();
	buildFullPathNames();

	ymLoad(fullPath,instr);//load current instrument

	memSet(&fullName,12,0);//clear names
	memSet(&fullPath,64,0);
}

void saveFile()
{
	appendExtensions();
	buildFullPathNames();

	ymSave(fullPath,instr);


	memSet(&fullName,12,0);//clear names
	memSet(&fullPath,64,0);
}

//globals
mouseSens(1);
int mouseHold;//captures from which widget the mouse has been held 
real subMouseDY;//used for smoothly changing values with the mouse
real subDYDivider=20;
text vWidgetTxt={3};//temporary holds the numeric input (increase size if needed)

vWidget vWidgets[64];//max number of widgets (increase size if needed) here 54 params for a YM instrument
byte vWidgetID;//unique vWidget ID

opWindow opWindows[4];//one for each operator
byte opWinID;

//independent widgets index storage to know where is the related widget in the array
byte algoWidget;
byte feedbackWidget;
byte ampModWidget;
byte freqModWidget;

bool octaveDwn;
bool octaveUp;

byte LFOWidget; //lfo is global and not stored in an instrument
byte LFOValue;
bool LFOActive=true;

void vWidgetCreate(byte x, byte y, int minV, int maxV, byte d, byte id)
{
	vWidgets[vWidgetID].posX=x;
	vWidgets[vWidgetID].posY=y;
	vWidgets[vWidgetID].minVal=minV;
	vWidgets[vWidgetID].maxVal=maxV;
	vWidgets[vWidgetID].YMparamID=id;
	vWidgets[vWidgetID].digits=d;

	//compute bounding box
	vWidgets[vWidgetID].BBx0=x*10;
	vWidgets[vWidgetID].BBy0=y*12;
	vWidgets[vWidgetID].BBx1=vWidgets[vWidgetID].BBx0+(d+3)*10;
	vWidgets[vWidgetID].BBy1=vWidgets[vWidgetID].BBy0+3*12;

	//compute drag speed accoring to min-max
	vWidgets[vWidgetID].speed=((real)abs(maxV-minV))/subDYDivider;

	vWidgetID++;
	if(vWidgetID>=#vWidgets) print("Increase widget array!");
} 

void vWidgetRender(byte id)
{
	curPos(vWidgets[id].posX,vWidgets[id].posY);

	if(vWidgets[id].up) print("2Â");//highlight up arrow
	else print("Â");
	
	print("");

	if(vWidgets[id].drag) print("2");//highlight drag bar
	else print("");

	print("");

	if(vWidgets[id].down) print("2Ã");//highlight down arrow
	else print("Ã");

	curPos(vWidgets[id].posX+1,vWidgets[id].posY);
	print("‰");
	for(int i; i<vWidgets[id].digits; i++) print("");
	print("Š");
	curPos(vWidgets[id].posX+1,vWidgets[id].posY+1);
	print("€");

	//get value
	byte YMparamID=vWidgets[id].YMparamID;//index into the global widget data storage
	//int val=wProperty[propertyID];//get value
	int val;
	if(YMparamID<54) val=ymGetParam(instr, YMparamID);
	else if(YMparamID==54)val=LFOValue;//lfo is global and not in an instrument

	//leading zeroes (todo support for negative values)
	if(val<10)
	{
		for(int i; i<vWidgets[id].digits-1; i++) print("0");
	}
	else if(val<100)
	{
		for(int i; i<vWidgets[id].digits-2; i++) print("0");
	}

	print(val);//the value

	print("€");
	curPos(vWidgets[id].posX+1,vWidgets[id].posY+2);
	print("ˆ");
	for(int i; i<vWidgets[id].digits; i++) print("");
	print("‡");
}

void vWidgetStep(int id, int step)
{
	byte YMparamID=vWidgets[id].YMparamID;//index into the global widget data storage
	int val;
	if(YMparamID<54) val=ymGetParam(instr, YMparamID);
	else if(YMparamID==54) val=LFOValue;
	val+=step;
	val=clamp(val,vWidgets[id].minVal,vWidgets[id].maxVal);
	if(YMparamID<54) ymSetParam(instr, YMparamID, (byte)val);
	else if(YMparamID==54)
	{
		LFOValue=(byte)val;
		ymLFO(LFOActive,LFOValue);
	}
}

void vWidgetUpdate(byte id)
{
	//test if dragging or mouse is hovering the bounding box
	if(mouseHold==id && vWidgets[id].drag || mouseHold==-1 && isPtrBox(vWidgets[id].BBx0,vWidgets[id].BBy0,vWidgets[id].BBx1,vWidgets[id].BBy1))
	{
		int cx=_mouseX/10; int cy=_mouseY/12;
		if(mouseHold==-1 && _mouse==1 && cx>vWidgets[id].posX+1 && cx<vWidgets[id].posX+2+vWidgets[id].digits)
		{
			if(cy==vWidgets[id].posY+1)//we are in the numeric input field
			{
				curPos(vWidgets[id].posX+2,vWidgets[id].posY+1);
				input(vWidgetTxt,vWidgets[id].digits);
				int val=txt2Int(&vWidgetTxt);
				val=clamp(val,vWidgets[id].minVal,vWidgets[id].maxVal);
				byte YMparamID=vWidgets[id].YMparamID;//index into the global widget data storage
				if(YMparamID<54) ymSetParam(instr, YMparamID, (byte)val);
				else if(YMparamID==54)
				{
					LFOValue=(byte)val;
					ymLFO(LFOActive,LFOValue);
				}
			}
		}
		else if(isPtrGlyph('Â') && _mouse==1 && mouseHold==-1)
		{
			vWidgets[id].up=true;
			vWidgetStep(id,1);
			mouseHold=id;
		}
		else if(isPtrGlyph('Ã') && _mouse==1 && mouseHold==-1)
		{
			vWidgets[id].down=true;
			vWidgetStep(id,-1);
			mouseHold=id;
		}
		else if(mouseHold==id && vWidgets[id].drag==true || isPtrGlyph('') && _mouse==1) //drag bar
		{
			vWidgets[id].drag=true;
			int pixDY=_mouseDY/16;
			subMouseDY+=(real)pixDY*vWidgets[id].speed;
			if(subMouseDY >= 1)
			{
				vWidgetStep(id,min(-pixDY/2,-1));//fast and slow threshold
				subMouseDY=0;
			}
			else if(subMouseDY <= -1)
			{
				vWidgetStep(id,max(-pixDY/2,1));//fast and slow threshold
				subMouseDY=0;
			}
									
			mouseHold=id;
		}
	}
	if(mouseHold==-1)
	{
		vWidgets[id].up=false;
		vWidgets[id].down=false;
		vWidgets[id].drag=false;
	}
	vWidgetRender(id);
}

// YM2612 ---------------------------

type YMEnv //envelope params
{
	byte TL;
	byte AR;
	byte DR;
	byte SR;
	byte SL;
	byte RR;
};

YMEnv getYMEnv(byte op) //get envelope params from current instrument
{
	YMEnv env;
	env.TL=ymGetParam(instr,op*10+2);// [0,127] total level (attenuation)
	env.AR=ymGetParam(instr,op*10+4);// [0,31] attack rate (higher is steeper)
	env.DR=ymGetParam(instr,op*10+6);// [0,31] decay rate (higher is steeper)
	env.SR=ymGetParam(instr,op*10+7);// [0,31] sustain rate (higher is steeper)
	env.SL=ymGetParam(instr,op*10+8);// [0,15] sustain level (attenuation)
	env.RR=ymGetParam(instr,op*10+9);// [0,15] release rate (higher is steeper)

	return env;
}

void drawYMEnv(byte op, int x, int y, int w, int h)
{
	byte col=2;

	//set new bitmap window to clip drawing to envelope window
	bmpWin(x,y,x+w,y+h);
	bmpOrg(x,y);
	box(0,0,w,h,0);//clear window

	x=0; y=h;//bottom relative to new window now
	skip(x,y);

	YMEnv env=getYMEnv(op);

	//Attack
	env.TL=127-env.TL;//turn attenuation into volume for display. Same for other params.
	env.AR=31-env.AR;
	env.TL=(byte)(((real)h/128)*env.TL);//Total Level dictates the vertical scale of graph
	x+=env.AR; y-=env.TL;
	draw(x,y,col);
	
	//Decay
	env.SL=15-env.SL;
	env.DR=31-env.DR;
	env.SL=(byte)(((real)env.TL/16)*env.SL);//normalize SL to TL
	x+=env.DR; y=h-env.SL;
	draw(x,y,col);

	//Sustain
	env.SR=env.SR;//31-env.SR
	x+=30; y+=env.SR/2;
	draw(x,y,col);
	
	//Release
	env.RR=15-env.RR;
	x+=env.RR*2; y=h;
	draw(x,y,col);

	//restore default bitmap window
	bmpWin(0,0,399,239);
	int winID;
}

void displayTYOperator(byte op, int x, int y)
{
	byte tx=(byte)x; byte ty=(byte)y;
	txtWin(tx,ty,tx+27,ty+17);
	curPos(tx,ty);
	
	print("‰Š");
	for(int i; i<6; i++)	print("€                         €");
	print("‚ƒ");
	print("€  AR   DR   SL   SR   RR €");
	for(int i; i<3; i++)	print("€                         €");
	print("€  Ml   Dt   RS   TL      €");
	print("€                     AM  €");
	print("€                         €");
	print("€                     ON  €");
	print("ˆ‡");

	curPos(tx,ty);
	//For some reason register order 1234 is different than
	//operator order 1324 so we account here for display
	//see register ref @ plutiedev.com/ym2612-registers
	
	if(op==1)print("Operator 3");//inverted
	else if(op==2)print("Operator 2");//inverted
	else print("Operator ",op+1);//ok

	byte wFirst=vWidgetID;//the first widget for this window

	//vWidgets
	//Total Level
	vWidgetCreate(tx+16,ty+13,0,127,3,op*10+2);

	//Attack Rate
	vWidgetCreate(tx+1,ty+9,0,31,2,op*10+4);//posx, posy, min, max, digits, out param index

	//Decay Rate
	vWidgetCreate(tx+6,ty+9,0,31,2,op*10+6);

	//Sustain Rate
	vWidgetCreate(tx+16,ty+9,0,31,2,op*10+7);

	//Sustain Level
	vWidgetCreate(tx+11,ty+9,0,15,2,op*10+8);

	//Release Rate
	vWidgetCreate(tx+21,ty+9,0,15,2,op*10+9);

	//Base Freq multiplier
	vWidgetCreate(tx+1,ty+13,0,15,2,op*10+1);

	//Detune
	vWidgetCreate(tx+6,ty+13,0,7,2,op*10);

	//Rate Scaling (key follow)
	vWidgetCreate(tx+11,ty+13,0,3,2,op*10+3);

	//Setup the window for fast updates of the widgets
	byte wLast=vWidgetID;//last widget for this operator window

	opWindows[opWinID].posX=tx;
	opWindows[opWinID].posY=ty;
	opWindows[opWinID].BBx0=tx*10;
	opWindows[opWinID].BBy0=ty*12;
	opWindows[opWinID].BBx1=tx*10+27*10;
	opWindows[opWinID].BBy1=ty*12+17*12;
	opWindows[opWinID].wFirst=wFirst;
	opWindows[opWinID].wLast=wLast;

	opWinID++;

	txtWin(0,0,79,39);//restore default text window
}

