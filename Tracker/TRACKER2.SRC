// Benoit (BSM) Saint-Moulin - www.bsm3d.com
// 6 voix FM + 2 voix synth

byte sng[384];
byte bak[384];
byte bank[540];
byte nn[12]={'C','C','D','D','E','F','F','G','G','A','A','B'};
byte ns[12]={'-','#','-','#','-','-','#','-','#','-','#','-'};
text tname[8]={"FM1","FM2","FM3","FM4","FM5","FM6","DRM","SYN"};
text tabs[5]={"PATTERN","SONG","SETUP","FILE","HELP"};
int tabx[6]={37,46,52,59,65,71};
