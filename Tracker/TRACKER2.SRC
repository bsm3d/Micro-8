// affiche (SoundEd)

// codes des touches : notes Z..I, chiffres, lettres
byte nkey[25]={72,32,52,14,73,53,15,74,34,54,16,75,41,21,62,2,42,63,3,43,23,64,4,44,65};
byte dkey[10]={25,1,21,2,22,3,23,4,24,5};
byte akey[26]={13,74,73,14,42,33,15,34,65,16,35,17,75,
                54,45,66,41,63,32,43,44,53,62,52,64,72};

// clavier a l'ecran : demi-ton et touche des blanches, touches des noires (' ' = aucune)

// valeurs par defaut de sng[50] a sng[67]
byte dflt[18]={3,0,8,8,4,0,8,8,4,0,0,0,128,64,3,4,0,0};
// couleur des blocs du morceau, par pattern
byte songPal[8]={0x91,0x41,0xC1,0x71,0x32,0xD2,0xA2,0x82};
// case vide de la grille ("---  ---") : ecrite d'un coup (memCpy) au lieu de 8 putc, le
// cas le plus frequent
byte emptyG[8]={'-','-','-',' ','-',' ','-','-'};
byte sinT[32];
byte insNm[80];
int lastIns[8];
int lastN[8];
int vu[8];
int scopeV[8];
byte solo[8];
int tmp[128];
byte tbuf[32];
int midiKey=-1;
int tempo=120;
int stepMs=125;
nat carry=0;
nat vuNext=0;

int gY=9;    // premiere ligne de la grille
int curPat=0;
int curRow=0;
int curTrk=0;
int curFld=0;
int top=0;   // premiere ligne de la grille (negative en debut de lecture)
