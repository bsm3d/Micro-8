	if(midiKey>=0) c=0x09;
	putc(56,30,0xB8,c);
	txt(58,30,"MIDI IN",0x01);
	txt(69,30,"FOLLOW",0x01);
	c=0x7F;
	if(follow) c=0x01;
	putc(77,30,c,0x01);
	drawBlocks();
	puts(56,33,msg,23,0x01);
}

// --- bandes du morceau
// 1 bloc par entree : 1 + 2 cases par bloc de 16 pas
int entW(int pos) {
	return 1+2*entLen(pos);
}

// premiere entree visible dans w cases
int stripFirst(int w) {
	int e=songSel;
	int sw=entW(entPos(e));
	while(e>0) {
		int pw=entW(entPos(e-1));
		if(sw+pw>w-4) break;
		sw=sw+pw;
		e--;
	}
	return e;
}

// --- instruments
void drawInsRow(int i) {
	int y=27+i%5;
	int x=2+i/5*24;
	int col=0x01;
	if(i==insv) col=0x52;
	putc(x,y,'0'+i,0x21);
	putc(x+1,y,0x80,0x01);
	areaSet(0x1200,80,x+2,y,14,1,' ');
	areaSet(0x1E80,80,x+2,y,14,1,(byte)col);
	for(int k=0;k<8;k++) {
		if(insNm[i*8+k]==0) break;
		putc(x+3+k,y,insNm[i*8+k],col);
	}
}

void drawInstr() {
	panel(0,26,80,9,"INSTRUMENTS");
	title(54,26,"STATUS");
	for(int i=0;i<10;i++) drawInsRow(i);
	putc(2,32,0xC6,0x01);
	txt(4,32,"LOAD INTO",0x06);
	putc(14,32,'0'+insv,0x21);
}

// --- vue centrale
// titre a gauche dans le bord du haut, onglets a droite
void drawCenterTitle() {
	areaSet(0x1200,80,1,8,36,1,0x81);
	areaSet(0x1E80,80,1,8,36,1,0x01);
	if(scr==0) {
		for(int t=0;t<4;t++)
		{
			putc(3+t*9,8,0x85,0x01);
		}
	}
	putc(1,8,' ',0x52);
	int x=2;
	if(scr==0) {
		x=x+txt(x,8,"PATTERN ",0x52);
		puth2(x,8,curPat,0x52);
		putn(x+2,8,plen(curPat),5,0x52);
		x=x+7+txt(x+7,8," STEPS",0x52);
		if(blocks(curPat)>1) {
			x=x+txt(x,8,"  PAGE",0x52);
			int pg=curRow/16;
			if(playing&&follow&&playHead==curPat) pg=playLine/16;
			putn(x,8,pg+1,3,0x52);
			putc(x+3,8,'/',0x52);
			putn(x+4,8,blocks(curPat),2,0x52);
			x=x+6;
		}
	} else if(scr==1) {
		x=x+txt(x,8,"SONG",0x52);
		putn(x,8,entCount(),5,0x52);
		x=x+5+txt(x+5,8," ENTRIES",0x52);
	} else if(scr==2) {
		x=x+txt(x,8,"SETUP  TRACK ",0x52);
		x=x+txt(x,8,tname[trkSel],0x52);
	} else if(scr==3) {
		x=x+txt(x,8,"FILE  ",0x52);
		x=x+txt(x,8,pname,0x52);
	} else x=x+txt(x,8,"HELP",0x52);
	putc(x,8,' ',0x52);
}

void drawSong() {
	{
		// drawStrip_2
		int drawStrip_2_y=11;
		int drawStrip_2_w=74;
		int drawStrip_2_h=3;
		int n=entCount();
		int live=-1;
		if(playing&&songMode) live=entAt();
		areaSet(0x1200,80,2,drawStrip_2_y-1,drawStrip_2_w,drawStrip_2_h+1,' ');
		areaSet(0x1E80,80,2,drawStrip_2_y-1,drawStrip_2_w,drawStrip_2_h+1,0x01);
		int e=stripFirst(drawStrip_2_w);
		int pos=entPos(e);
		int x=2;
		while(e<n&&x<2+drawStrip_2_w) {
			int ew=clamp((entW(pos)),0,2+drawStrip_2_w-x);
			int p=headOf(spat(pos));
			int c=0;
			{
				// entColor
				bool done=false;
				int entColor_p=p;
				{
					c=songPal[headOf(entColor_p)%8];
					done=true;
				}
				if(!done) {
				}
			}
			areaSet(0x1E80,80,x,drawStrip_2_y,ew,drawStrip_2_h,(byte)c);
			for(int r=0;r<drawStrip_2_h;r++)
			{
				putc(x,drawStrip_2_y+r,0x92,c);
			}
			if(ew>=3)
			{
				puth2(x+1,drawStrip_2_y,p,c);
			}
			if(ew>=3&&e==songSel) areaSet(0x1E80,80,x+1,drawStrip_2_y,2,1,0x52);
			if(e==live)
			{
				putc(x,drawStrip_2_y-1,0xC3,0x0D);
			}
			else
			{
				putc(x,drawStrip_2_y-1,'0'+e%10,0x06);
			}
			x=x+entW(pos);
			pos=pos+entLen(pos);
			e++;
		}
	}
	int pos=entPos(songSel);
	int x=spin(2,16,"ENTRY",songSel,2);
	x=hspin(x+2,"PATTERN",headOf(spat(pos)));
	x=sspin(x+2,"TRANSPOSE",strans(pos));
	txt(x+2,16,"LENGTH",0x01);
	putn(x+9,16,entLen(pos)*16,3,0x01);
	txt(2,18,"ENTRIES",0x01);
	putn(10,18,entCount(),3,0x01);
	txt(15,18,"POSITIONS",0x01);
	putn(25,18,slen(),3,0x01);
	txt(28,18,"/128",0x06);
	txt(34,18,"LOOP",0x01);
	int c=0x7F;
	if(cg(6)!=0) c=0x01;
	putc(39,18,c,0x01);
	txt(2,21,"UP/DOWN ENTRY  LEFT/RIGHT PATTERN  - = TRANSPOSE  A COPY  BKSP DELETE",0x06);
	txt(2,22,"L LOOP  ENTER PLAYS FROM THE ENTRY",0x06);
}

// 2 col de 13 reglages, valeurs -> fleches
void drawSetupRow(int i) {
	int x=2+(i/13)*39;
	int y=10+i%13;
	int col=0x01;
	if(i==setSel) col=0x52;
	puts(x,y,plab[i],16,col);
	putc(x+17,y,0xC1,0x05);
	putc(x+22,y,0xC0,0x05);
	areaSet(0x1200,80,x+18,y,4,1,' ');
	areaSet(0x1E80,80,x+18,y,4,1,0x21);
	if(i==0) {
		txt(x+19,y,tname[trkSel],0x21);
		return;
	}
	int idx=pbase[i];
	if(ptrk[i]==1) idx=idx+trkSel;
	int v=cg(idx);
	if(i==25) {
		if(v<64)
		{
			putc(x+18,y,'-',0x21);
		}
		putn(x+19,y,clamp((v-64),64-v,127),3,0x21);
	} else putn(x+18,y,v,4,0x21);
}

