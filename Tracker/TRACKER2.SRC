		areaSet(0x1E80,80,12,10,10,1,0x21);
		txt(13,10,pname,0x21);
		txt(24,10,"= NAME.M8S (ONE FILE)",0x06);
		button(3,0xC4,"SAVE   S");
		button(19,0xC6,"LOAD   L");
		button(35,0xC5,"NEW    N");
		button(51,0x1B,"RENAME R");
		txt(3,17,"LOAD AND NEW STOP THE PLAYBACK",0x06);
		puts(3,22,msg,40,0x01);
	}
	else
	{
		// drawHelp
		txt(2,9,"PATTERN",0x05);
		txt(2,10,"Z-M Q-I notes   1 note off   BKSP clear   - = octave   , . pattern",0x01);
		txt(2,11,"[ ] instrument   ; ' velocity   SPACE play   ENTER play song   9 0 tempo",0x01);
		txt(2,13,"FCTN +",0x05);
		txt(2,14,"C V K copy/paste/clear   L length   - = step   F follow   UP/DN value",0x01);
		txt(2,15,"1-8 mute   SH+1-8 solo   LT/RT transpose   (CTRL+UP/DN = FCTN+UP/DN)",0x01);
		txt(2,17,"SONG",0x05);
		txt(2,18,"UP/DN entry   LT/RT pattern   - = transpose   A copy   BKSP delete   L loop",0x01);
		txt(2,20,"TAB next view     FCTN+ESC quit     hold an arrow to repeat",0x06);
		txt(2,21,"MIDI IN plays on the current track, written at the cursor when stopped",0x06);
	}
	drawCenterTitle();
	{
		// drawTabs
		for(int i=0;i<5;i++) {
			int c=0x01;
			if(scr==i) c=0x52;
			putc(tabx[i],8,' ',c);
			txt(tabx[i]+1,8,tabs[i],c);
			putc(tabx[i+1]-1,8,' ',c);
		}
	}
}

// oscilloscope d'une piste : la forme d'onde seule, sur toute la largeur de sa colonne (40 pixels) ;
// l'amplitude suit le niveau de la piste, une ligne plate quand elle se tait
void drawScope(int t) {
	int bx=(4+t*9)*5;
	int a=vu[t];
	scopeV[t]=a;
	box(bx,30,bx+39,41,5);
	if(a==0) {
		line(bx+1,36,bx+38,36,8);
		return;
	}
	int f=1+(lastN[t]%24)/6;
	skip(bx+1,36);
	for(int i=1;i<39;i++) {
		int v=(sinT[(i*f*32/39)%32]-10)*a/8;
		if(t==6&&isDrum(6)) v=rnd(-a,a);
		draw(bx+i,36+v,7);
	}
}

