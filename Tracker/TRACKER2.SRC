		vsep_y0=0;
		vsep_y1=2;
		vsep();
		putc(20,1,0x0A,0x01);
		vsep_x=28;
		vsep_y0=0;
		vsep_y1=2;
		vsep();
		spin(30,1,"BPM",tempo,3);
		spin(41,1,"OCT",octv,1);
		spin(50,1,"STEP",stepv,2);
		vsep_x=60;
		vsep_y0=0;
		vsep_y1=2;
		vsep();
		putc(62,1,0xC5,0x01);
		putc(64,1,0xC6,0x01);
		putc(66,1,0xC4,0x01);
		areaSet(0x1200,80,68,1,11,1,' ');
		areaSet(0x1E80,80,68,1,11,1,0x21);
		txt(69,1,pname,0x21);
		txt(27,38,"Benoit (BSM) Saint-Moulin",0x05);
		txt(33,39,"www.bsm3d.com",0x06);
	}
	{
		// drawTracks
		box0_x=0;
		box0_y=3;
		box0_w=80;
		box0_h=5;
		box0();
		for(int t=0;t<9;t++)
		{
			vsep_x=3+t*9;
			vsep_y0=3;
			vsep_y1=7;
			vsep();
		}
		title(0,3,"TRACKS");
		drawHeader();
		for(int t=0;t<8;t++) drawScope(t);
	}
	drawCenter();
	drawInstr();
	drawKbValues();
	drawStatus();
}

// Vue centrale (ligne 16)
void popup(text q) {
	box0_x=10;
	box0_y=14;
	box0_w=60;
	box0_h=5;
	box0();
	areaSet(0x1200,80,11,15,58,3,' ');
	areaSet(0x1E80,80,11,15,58,3,0x01);
	title(10,14,q);
}

void stopPlay() {
	playing=false;
	pend=-1;
	cue=-1;
	{
		// stopAll
		for(int t=0;t<8;t++) noteOff(t);
	}
	for(int t=0;t<8;t++) vu[t]=0;
	drawScreen();
}

// --- files
// NOM.M8S, compresse comme sur C64 (format decrit dans micro8_tracker/README.md) :
//   "M8S1" ; le morceau : 16 octets (un bit par octet non nul de sng[0..127]) puis ces
//   octets, les sng[5] numeros
//   de bloc du morceau, puis 0, ou 1 et leurs transpositions ; les instruments : 2 octets
//   (un bit par emplacement
//   FM enregistre) puis 54 octets chacun ; les patterns, bloc par bloc (les vides sont
//   sautes) : le numero du bloc,
//   un octet (un bit par piste non vide), puis pour chaque piste non vide, soit 254 et la
//   piste deja ecrite qu'elle
//   repete (bloc*8+piste sur 2 octets, transposition+128), soit le nombre d'evenements et
//   chacun : pas (0-15)
//   +16 si l'instrument change +32 si la velocite change, la note, puis l'instrument et
//   la velocite s'ils changent ;
//   255 pour finir
byte cbits[16];
byte bitv[8]={1,2,4,8,16,32,64,128};
byte magic[4]={77,56,83,49};
byte iobuf[128];
int iopos;
int iolen;
nat fpos;
nat rsize;
byte ferr;
int nt;
int ni;
int nv;

void oneName(text f) {
	concat(f,pname);
	concat(f,".M8S");
}

int cellAddr_b;
int cellAddr_t;
int cellAddr_k;
nat cellAddr() {
	return 0x3000+(nat)cellAddr_b*384+(nat)cellAddr_k*24+(nat)cellAddr_t*3;
}

int rd_b;
int rd_t;
int rd_k;
// une case (note, instrument, velocite) dans nt, ni, nv
void rd() {
	cellAddr_b=rd_b;
	cellAddr_t=rd_t;
	cellAddr_k=rd_k;
	nat a=cellAddr();
	nt=peek(a,0x90);
	ni=peek(a+1,0x90);
	nv=peek(a+2,0x90);
}

bool slotUsed(int i) {
	for(int p=0;p<54;p++) {
		if(bank[i*54+p]!=0) return true;
	}
	return false;
}

bool has(int m,int i) {
	return (m/bitv[i])%2==1;
}

// un emplacement tout a zero garde l'instrument de la machine
void applyBank() {
	for(int i=0;i<10;i++) {
		if(slotUsed(i)) {
			for(int p=0;p<54;p++) ymSetParam((byte)i,(byte)p,bank[i*54+p]);
		}
	}
}

int usedIdx[512];
int usedSig[512];
int nUsed;
int cnt[8];

void put1(int v) {
	iobuf[iolen]=(byte)v;
	iolen++;
	if(iolen==128)
	{
		// flushOut
		if(iolen>0&&ferr==0) {
			fWrite(0,&iobuf,fpos,(nat)iolen);
			ferr=_fError;
			fpos=fpos+(nat)iolen;
		}
		iolen=0;
	}
}

int trkCount(int b,int t) {
	int n=0;
	cellAddr_b=b;
	cellAddr_t=t;
	cellAddr_k=0;
	nat a=cellAddr();
	for(int k=0;k<16;k++) {
		if(peek(a,0x90)!=0||peek(a+1,0x90)!=0||peek(a+2,0x90)!=0) n++;
		a=a+24;
	}
	return n;
}

// la premiere vraie note de la piste (ni vide ni OFF), 0 sinon
int firstNote(int b,int t) {
	for(int k=0;k<16;k++) {
		rd_b=b;
		rd_t=t;
		rd_k=k;
		rd();
		if(nt!=0&&nt!=255) return nt;
	}
	return 0;
}

// une empreinte qui ne change pas quand la piste est transposee
int trkSig(int b,int t) {
	int f=firstNote(b,t);
	int s=0;
	for(int k=0;k<16;k++) {
		rd_b=b;
		rd_t=t;
		rd_k=k;
		rd();
		if(nt!=0&&nt!=255) nt=nt-f+128;
		s=(s+(k+1)*(nt+1)+ni*3+nv)%16000;
	}
	return s;
}

int trkMatch_j;
int trkMatch_b;
int trkMatch_t;
// la transposition qui donne la piste (b,t) a partir de la piste j, ou -999
int trkMatch() {
	int d=firstNote(trkMatch_b,trkMatch_t)-firstNote(trkMatch_j/8,trkMatch_j%8);
	if(d<-127||d>127) return -999;
	for(int k=0;k<16;k++) {
		rd_b=trkMatch_j/8;
		rd_t=trkMatch_j%8;
		rd_k=k;
		rd();
		int x=nt;
		int i=ni;
		int v=nv;
		rd_b=trkMatch_b;
		rd_t=trkMatch_t;
		rd_k=k;
		rd();
		if(i!=ni||v!=nv) return -999;
		if(x!=0&&x!=255) x=x+d;
		if(nt!=x) return -999;
	}
	return d;
}

// nom du fichier, partage par les fonctions de chargement et de sauvegarde : pas de
// text local, la machine ne libere pas sa place dans la pile du compilateur
text fnm={16};

// le fichier est d'abord efface : fOpen ne raccourcit pas un fichier existant
byte saveOne() {
	memSet(&fnm,17,0);
	oneName(fnm);
	{
		// fillBank
		for(int i=0;i<10;i++) {
			for(int p=0;p<54;p++) bank[i*54+p]=ymGetParam((byte)i,(byte)p);
		}
	}
	fDel(fnm);
	fOpen(0,fnm);
	ferr=_fError;
	if(ferr!=0) return ferr;
	fpos=0;
	iolen=0;
	for(int i=0;i<4;i++) put1(magic[i]);
	memSet(&cbits,16,0);
	for(int i=0;i<128;i++) {
		if(sng[i]!=0) cbits[i/8]=cbits[i/8]+bitv[i%8];
	}
	for(int i=0;i<16;i++) put1(cbits[i]);
	for(int i=0;i<128;i++) {
		if(sng[i]!=0) put1(sng[i]);
	}
	int len=clamp((sng[5]),0,128);
	int tr=0;
	for(int i=0;i<len;i++) {
		put1(sng[128+i]);
		if(sng[256+i]!=64) tr=1;
	}
	put1(tr);
	for(int i=0;i<len*tr;i++) put1(sng[256+i]);
	int mask=0;
	for(int i=0;i<10;i++) {
		if(slotUsed(i)) mask=mask+(i/8)*255*bitv[i%8]+bitv[i%8];
	}
	put1(mask%256);
	put1(mask/256);
	for(int i=0;i<10;i++) {
		if(slotUsed(i)) {
			for(int p=0;p<54;p++) put1(bank[i*54+p]);
		}
	}
	nUsed=0;
	for(int b=0;b<64;b++) {
		int tm=0;
		for(int t=0;t<8;t++) {
			cnt[t]=trkCount(b,t);
			if(cnt[t]>0) tm=tm+bitv[t];
		}
		if(tm>0) {
			put1(b);
			put1(tm);
			for(int t=0;t<8;t++) {
				if(cnt[t]>0)
				{
					// putTrack
					int putTrack_b=b;
					int putTrack_t=t;
					int s=trkSig(putTrack_b,putTrack_t);
					usedSig[nUsed]=s;
					for(int k=0;k<nUsed;k++) {
						if(usedSig[k]==s) {
							trkMatch_j=usedIdx[k];
							trkMatch_b=putTrack_b;
							trkMatch_t=putTrack_t;
							int d=trkMatch();
							if(d!=-999) {
								put1(254);
								put1(usedIdx[k]%256);
								put1(usedIdx[k]/256);
								put1(d+128);
								k=nUsed;
								s=-1;
							}
						}
					}
					if(s>=0) {
						put1(cnt[putTrack_t]);
						int pi=0;
						int pv=0;
						for(int k=0;k<16;k++) {
							rd_b=putTrack_b;
							rd_t=putTrack_t;
							rd_k=k;
							rd();
							if(nt!=0||ni!=0||nv!=0) {
								int e=k;
								if(ni!=pi) e=e+16;
								if(nv!=pv) e=e+32;
								put1(e);
								put1(nt);
								if(ni!=pi) put1(ni);
								if(nv!=pv) put1(nv);
								pi=ni;
								pv=nv;
							}
						}
					}
					usedIdx[nUsed]=putTrack_b*8+putTrack_t;
					nUsed++;
				}
			}
		}
	}
	put1(255);
	{
		// flushOut_2
		if(iolen>0&&ferr==0) {
			fWrite(0,&iobuf,fpos,(nat)iolen);
			ferr=_fError;
			fpos=fpos+(nat)iolen;
		}
		iolen=0;
	}
	fClose(0);
	return ferr;
}

int get1() {
	if(ferr!=0) return 0;
	if(iopos>=iolen) {
		if(fpos>=rsize) {
			ferr=253;
			return 0;
		}
		nat n=rsize-fpos;
		if(n>128) n=128;
		fRead(0,&iobuf,fpos,n);
		ferr=_fError;
		fpos=fpos+n;
		iolen=(int)n;
		iopos=0;
	}
	int v=iobuf[iopos];
	iopos++;
	return v;
}

// charge NOM.M8S dans sng[], les patterns et bank[] ; 0 si tout va bien (applyBank()
// apres initSound())
byte loadFiles() {
	memSet(&fnm,17,0);
	oneName(fnm);
	import(fnm,&iobuf,4);
	if(_fError!=0) return _fError;
	for(int i=0;i<4;i++) {
		if(iobuf[i]!=magic[i]) return 255;
	}
	fOpen(0,fnm);
	rsize=fSize(0);
	fpos=4;
	iopos=0;
	iolen=0;
	ferr=0;
	memSet(&sng,256,0);
	memSet(&sng+256,128,64);
	memSet(0x3000,24576,0,0x90);
	memSet(&bank,540,0);
	for(int i=0;i<16;i++) cbits[i]=(byte)get1();
	for(int i=0;i<128;i++) {
		if(has(cbits[i/8],i%8)) sng[i]=(byte)get1();
	}
	int len=clamp((sng[5]),0,128);
	for(int i=0;i<len;i++) sng[128+i]=(byte)get1();
	if(get1()==1) {
		for(int i=0;i<len;i++) sng[256+i]=(byte)get1();
	}
	int m0=get1();
	int m1=get1();
	for(int i=0;i<10;i++) {
		if((i<8&&has(m0,i))||(i>=8&&has(m1,i-8))) {
			for(int p=0;p<54;p++) bank[i*54+p]=(byte)get1();
		}
	}
	for(int kb=0;kb<64&&ferr==0;kb++) {
		int b=get1();
		if(b==255) break;
		if(b>63) ferr=254;
		int tm=get1();
		for(int t=0;t<8&&ferr==0;t++) {
			if(has(tm,t)) {
				int h=get1();
				if(h==254) {
					int j=get1();
					j=j+get1()*256;
					int d=get1()-128;
					if(j>=b*8+t) ferr=252;
					for(int k=0;k<16&&ferr==0;k++) {
						rd_b=j/8;
						rd_t=j%8;
						rd_k=k;
						rd();
						if(nt!=0&&nt!=255) nt=nt+d;
						if(nt<0||nt>255) ferr=251;
						{
							// wr
							int wr_b=b;
							int wr_t=t;
							int wr_k=k;
							cellAddr_b=wr_b;
							cellAddr_t=wr_t;
							cellAddr_k=wr_k;
							nat a=cellAddr();
							poke(a,(byte)nt,0x90);
							poke(a+1,(byte)ni,0x90);
							poke(a+2,(byte)nv,0x90);
						}
					}
				} else if(h<=16) {
					ni=0;
					nv=0;
					for(int k=0;k<h;k++) {
						int e=get1();
						nt=get1();
						if((e/16)%2==1) ni=get1();
						if((e/32)%2==1) nv=get1();
						{
							// wr_2
							int wr_2_b=b;
							int wr_2_t=t;
							int wr_2_k=e%16;
							cellAddr_b=wr_2_b;
							cellAddr_t=wr_2_t;
							cellAddr_k=wr_2_k;
							nat a=cellAddr();
							poke(a,(byte)nt,0x90);
							poke(a+1,(byte)ni,0x90);
							poke(a+2,(byte)nv,0x90);
						}
					}
				} else ferr=250;
			}
		}
	}
	fClose(0);
	if(ferr==0&&(cg(0)!='M'||cg(1)!='8'||cg(2)!='T'||cg(3)!='1')) ferr=255;
	return ferr;
}

// .INS <-> emplacement d'instrument : L charge, S enregistre (l'instrument edite ici,
// pour SoundEd ou un autre projet)
void insFile(int slot,bool save) {
	if(playing) stopPlay();
	if(save) popup("SAVE INSTRUMENT (.INS)");
	else popup("INSTRUMENT FILE (.INS)");
	txt(12,15,"SLOT",0x01);
	putc(17,15,'0'+slot,0x21);
	txt(20,15,"EG /DEMOS/ORGAN/SOUNDS/PAD01.INS",0x06);
	int n=readLine(30);
	setMsg("CANCELLED");
	if(n>0) {
		{
			// bufToText
			nat bufToText_addr=&insName;
			int bufToText_len=n;
			for(int i=0;i<bufToText_len;i++) poke(bufToText_addr+(nat)i,tbuf[i]);
			poke(bufToText_addr+(nat)bufToText_len,0);
		}
		if(save) {
			ymSave(insName,(byte)slot);
			if(_fError==0) setMsg("INS SAVED");
			else setMsg("INS NOT SAVED");
		} else {
			ymLoad(insName,(byte)slot);
			if(_fError==0) {
				setMsg("INS LOADED");
				{
					// setInsName
					int setInsName_slot=slot;
					int setInsName_n=n;
					int s=0;
					for(int i=0;i<setInsName_n;i++) {
						if(tbuf[i]=='/') s=i+1;
					}
					for(int k=0;k<8;k++) insNm[setInsName_slot*8+k]=0;
					for(int k=0;k<8&&s+k<setInsName_n&&tbuf[s+k]!='.';k++) insNm[setInsName_slot*8+k]=tbuf[s+k];
				}
			} else setMsg("INS NOT LOADED");
		}
		for(int t=0;t<6;t++) lastIns[t]=-1;
	}
	drawCenter();
	drawInstr();
	drawStatus();
}

// --- outils pattern
// Y ou O pour oui
bool askYes(text q) {
	popup(q);
	txt(12,16,"Y OR O = YES      ANY OTHER KEY = NO",0x06);
	int k=waitKey();
	drawCenter();
	return k==64||k==45;
}

// longueur de p blocs 
void setLength(int n) {
	int old=blocks(curPat);
	if(curPat+n>64) {
		setMsg("NO ROOM");
		return;
	}
	bool notes=false;
	for(int b=curPat+old;b<curPat+n;b++) {
		if(inSong(b)||blocks(b)>1) {
			setMsg("BLOCKS USED BY SONG");
			return;
		}
		if(!blockEmpty(b)) notes=true;
	}
	if(notes&&!askYes("THE NEXT BLOCKS HOLD NOTES, KEEP THEM?")) {
		setMsg("CANCELLED");
		return;
	}
	// entrees du song qui play le pattern entier
	int cnt=0;
	for(int i=0;i<slen();i=i+entLen(i)) {
		if(spat(i)==curPat&&entLen(i)==old) {
			tmp[cnt]=i;
			cnt++;
		}
	}
	if(songFull(cnt*(n-old))) return;
	for(int b=curPat+1;b<curPat+old;b++) setCont(b,false);
	for(int b=curPat+1;b<curPat+n;b++) setCont(b,true);
	for(int c=cnt-1;c>=0;c--) {
		songShift(tmp[c]+old,n-old);
		fillEntry_pos=tmp[c];
		fillEntry_p=curPat;
		fillEntry_tr=sng[256+tmp[c]];
		fillEntry();
	}
	curRow=clamp((curRow),0,plen(curPat)-1);
	setMsg("LENGTH CHANGED");
}

// curseur (255 = off), descend step
void enterNote(int v,int vel) {
	rset(curRow,0,v);
	if(v!=255) {
		rset(curRow,1,insv);
		rset(curRow,2,vel);
	}
	curRow=(curRow+stepv)%plen(curPat);
}

// Page si elle change, sinon les 2 lignes
void redrawRows(int oldRow) {
	if(viewTop()!=top) {
		top=viewTop();
		drawGrid();
		drawCenterTitle();
	} else {
		drawRow(oldRow);
		drawRow(curRow);
	}
}

void cellStep(int d) {
	int v=rget(curRow,curTrk,0);
	if(curFld==0&&v!=255) {
		if(v==0) {
			v=clamp((octv*12+1),1,120);
			if(isDrum(curTrk)) v=1;
			rset(curRow,1,insv);
			rset(curRow,2,velv);
		} else if(isDrum(curTrk)) v=clamp((v+d),1,20);
		else if(mShift) v=clamp((v+d*12),1,120);
		else v=clamp((v+d),1,120);
		rset(curRow,0,v);
		if(!playing) {
			playNote_t=curTrk;
			playNote_v=v;
			playNote_vel=rget(curRow,curTrk,2);
			playNote_ins=rget(curRow,curTrk,1);
			playNote();
			prevTrk=curTrk;
			vuNext=_mSec+100;
		}
	} else if(v!=0&&v!=255) {
		if(curFld==1) rset(curRow,1,clamp((rget(curRow,curTrk,1)+d),0,9));
		else {
			if(mShift) d=d*16;
			rset(curRow,2,clamp((rget(curRow,curTrk,2)+d),1,127));
		}
	}
	drawRow(curRow);
}

void gotoPattern(int p) {
	if(p<0) return;
	curPat=p;
	curRow=clamp((curRow),0,plen(p)-1);
	if(playing&&!songMode) {
		// joue tout de suite, au meme pas de la mesure (saut direct, sans attendre la fin du
		// pattern)
		cue=-1;
		int h=headOf(playBlk);
		if(p!=h) {
			int at=((playBlk-h)*16+playRow)%(blocks(p)*16);
			playBlk=p+at/16;
			playRow=at%16;
		}
	}
	if(playing&&songMode&&follow&&p!=playHead) {
		follow=false;
		setMsg("FOLLOW OFF");
	}
	{
		// drawPatternScreen
		top=viewTop();
		drawGrid();
		drawCenterTitle();
		drawHeader();
	}
	drawStatus();
}

void keyPattern(int k) {
	if(mFctn||(mCtrl&&(k==77||k==80))) {
		{
			// keyPatternFctn
			bool done=false;
			int keyPatternFctn_k=k;
			int d=keyDigit(keyPatternFctn_k);
			int n=blocks(curPat);
			if(keyPatternFctn_k==73) {
				clipLen=n;
				for(int j=0;j<n;j++) copyBlock(curPat+j,64+j);
				setMsg("COPIED");
			} else {
				if(keyPatternFctn_k==53) {
					for(int j=0;j<clamp((clipLen),0,n);j++) copyBlock(64+j,curPat+j);
					setMsg("PASTED");
				} else {
					if(keyPatternFctn_k==35) {
						memSet(0x3000+pidx(curPat,0,0,0),(nat)(384*n),0,0x90);
						setMsg("CLEARED");
					} else {
						if(keyPatternFctn_k==17) {
							if(playing) stopPlay();
							if(n==16) setLength(1);
							else if(n==1) setLength(4);
							else setLength(n*2);
						} else {
							if(keyPatternFctn_k==33) {
								follow=!follow;
							} else {
								if(keyPatternFctn_k==6) {
									stepv=clamp((stepv-1),0,16);
								} else {
									if(keyPatternFctn_k==26) {
										stepv=clamp((stepv+1),0,16);
									} else {
										if(keyPatternFctn_k==57||keyPatternFctn_k==59) {
											int step=1;
											if(mShift) step=12;
											if(keyPatternFctn_k==57) step=-step;
											{
												// transposeTrack
												bool done=false;
												int transposeTrack_d=step;
												if(isDrum(curTrk)) {
													setMsg("NO TRANSPOSE ON DRUMS");
													done=true;
												}
												if(!done) {
													for(int r=0;r<plen(curPat);r++) {
														int v=rget(r,curTrk,0);
														if(v>=1&&v<=120) rset(r,0,clamp((v+transposeTrack_d),1,120));
													}
												}
											}
										} else {
											if(keyPatternFctn_k==77) {
												cellStep(1);
												done=true;
											} else {
												if(keyPatternFctn_k==80) {
													cellStep(-1);
													done=true;
												} else {
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
			if(!done) {
				{
					// drawPatternScreen_2
					top=viewTop();
					drawGrid();
					drawCenterTitle();
					drawHeader();
				}
				drawStatus();
			}
		}
		return;
	}
	int len=plen(curPat);
	int oldRow=curRow;
	int oldTrk=curTrk;
	int oldIns=insv;
	int oldVal=octv*1000+velv;
	int n=keyNote(k);
	int d=keyDigit(k);
	if(k==77&&mShift) curRow=clamp((curRow-16),0,len-1);
	else if(k==80&&mShift) curRow=clamp((curRow+16),0,len-1);
	else if(k==77) curRow=(curRow+len-1)%len;
	else if(k==80) curRow=(curRow+1)%len;
	else if(k==57||k==59) {
		// champ suivant, puis piste voisine
		if(k==57) curFld--;
		else curFld++;
		if(curFld<0) curTrk=(curTrk+7)%8;
		if(curFld>2) curTrk=(curTrk+1)%8;
		curFld=(curFld+3)%3;
	} else if(k==7) rclear(curRow);
	else if(k==55||k==76) {
		if(k==55)
		gotoPattern(nextPat(curPat,-1));
		else
		gotoPattern(nextPat(curPat,1));
		return;
	} else if(k==46) insv=clamp((insv-1),0,9);
	else if(k==67) insv=clamp((insv+1),0,9);
	else if(k==36) velv=clamp((velv-4),1,127);
	else if(k==27) velv=clamp((velv+4),1,127);
	else if(n>=0&&!(curFld==1&&d>=0)) {
		// une touche de note entre la note quel que soit le champ (note, instrument, velocite)
		int v=clamp((octv*12+n+1),1,120);
		if(isDrum(curTrk)) v=clamp((n+1),1,20);
		enterNote(v,velv);
		if(!playing) {
			playNote_t=curTrk;
			playNote_v=v;
			playNote_vel=velv;
			playNote_ins=insv;
			playNote();
			prevTrk=curTrk;
			vuNext=_mSec+100;
		}
	} else if(curFld==0) {
		if(k==6) octv=clamp((octv-1),0,8);
		else if(k==26) octv=clamp((octv+1),0,8);
		else if(k==1) enterNote(255,0);
	} else if(curFld==1) {
		if(d>=0) rset(curRow,1,d);
	} else if(k==6||k==26) {
		int step=4;
		if(mShift) step=16;
		if(k==6) step=-step;
		rset(curRow,2,clamp((rget(curRow,curTrk,2)+step),1,127));
	}
	redrawRows(oldRow);
	if(octv*1000+velv!=oldVal||insv!=oldIns) drawKbValues();
	if(curTrk!=oldTrk) {
		drawHeader();
	}
	if(insv!=oldIns) {
		drawInsRow(oldIns);
		drawInsRow(insv);
		putc(14,32,'0'+insv,0x21);
	}
}

// --- vue SETUP
void changeParam(int i,int d) {
	if(i==0) {
		trkSel=clamp((trkSel+d),0,7);
		if(scr==2) {
			{
				// drawSetup_2
				for(int i=0;i<26;i++) drawSetupRow(i);
				txt(2,24,"UP/DOWN SELECT  LEFT/RIGHT CHANGE (SHIFT X8)  L/S LOAD/SAVE .INS",0x06);
			}
			drawCenterTitle();
		}
		return;
	}
	int idx=pbase[i];
	if(ptrk[i]==1) idx=idx+trkSel;
	cs(idx,clamp((cg(idx)+d),0,phi[i]));
	if(i==5&&!heard(trkSel)) noteOff(trkSel);
	if(i>=1&&i<=5) applyVoice(trkSel);
	else if(i>=6&&i<=23)
	applySynth();
	if(scr==2) drawSetupRow(i);
	if(i==5) drawHeader();
}

// --- touches communes
void chgTempo(int d) {
	if(mShift) d=d*10;
	tempo=tempo+d;
	calcStep();
	cs(4,tempo);
	drawStatus();
}

void setView(int v) {
	scr=v;
	drawCenter();
	drawHeader();
}

void defaults() {
	memSet(&sng,384,0);
	cs(0,'M');
	cs(1,'8');
	cs(2,'T');
	cs(3,'1');
	cs(4,120);
	cs(5,1);
	cs(6,1);
	cs(8,64);
	for(int t=0;t<8;t++) {
		cs(10+t,t);
		cs(18+t,5);
		cs(26+t,3);
		cs(34+t,100);
		cs(76+t,t);
	}
	cs(82,9);   // canaux MIDI pour Studio (batterie sur le canal 9)
	for(int i=0;i<18;i++) sng[50+i]=dflt[i];
	for(int i=0;i<128;i++) sng[256+i]=64;
	tempo=120;
}

void doKey(int k) {
	if(prevTrk>=0&&!playing) {
		noteOff(prevTrk);
		prevTrk=-1;
	}
	if(k==12) {
		if(mFctn) quit=true;
		else if(playing) stopPlay();
	} else if(k==31) setView((scr+1)%5);
	else if(k==78||(k==37&&scr!=3)) {
		if(playing) stopPlay();
		else
		{
			// startPlay
			bool startPlay_fromSong=k==37;
			songMode=startPlay_fromSong;
			if(startPlay_fromSong) {
				songSel=clamp((songSel),0,entCount()-1);
				playPos=entPos(songSel);
				playBlk=spat(playPos);
				curPat=headOf(playBlk);
			} else playBlk=curPat;
			playRow=0;
			playHead=headOf(playBlk);
			playLine=(playBlk-playHead)*16;
			vline=playLine;
			curRow=clamp((curRow),0,plen(curPat)-1);
			shown=-1;
			cue=-1;
			calcStep();
			carry=(nat)stepMs;
			clkSet();
			playing=true;
			endPlay=false;
			pend=-1;
			drawScreen();
		}
	}
	// 9 0 : tempo (sauf champ instrument ou FCTN)
	else if((k==5||k==25)&&!mFctn&&!(scr==0&&curFld==1)) {
		if(k==5) chgTempo(-1);
		else chgTempo(1);
	} else if(scr==0) keyPattern(k);
	else if(scr==1)
	{
		// keySong
		int keySong_k=k;
		int pos=entPos(songSel);
		int p=headOf(spat(pos));
		int tr=strans(pos);
		if(keySong_k==77) songSel--;
		else if(keySong_k==80) songSel++;
		else if(keySong_k==57) {
			p=nextPat(p,-1);
			if(p<0) p=headOf(63);
			setEntry(p,tr);
		} else if(keySong_k==59) {
			p=nextPat(p,1);
			if(p<0) p=0;
			setEntry(p,tr);
		} else if(keySong_k==6) setEntry(p,clamp((tr-1),-24,24));
		else if(keySong_k==26) setEntry(p,clamp((tr+1),-24,24));
		else if(keySong_k==17) cs(6,1-cg(6));
		else if(keySong_k==13) {
			{
				// copyEntry
				bool done=false;
				int pos=entPos(songSel);
				int n=entLen(pos);
				if(songFull(n)) {
					done=true;
				}
				if(!done) {
					songShift(pos+n,n);
					for(int j=0;j<n;j++) {
						sng[128+pos+n+j]=sng[128+pos+j];
						sng[256+pos+n+j]=sng[256+pos+j];
					}
				}
			}
			songSel++;
		} else if(keySong_k==7&&entCount()>1) songShift(pos+entLen(pos),-entLen(pos));
		songSel=clamp((songSel),0,entCount()-1);
		if(scr==1) {
			drawSong();
			drawCenterTitle();
		}
		drawStatus();
	}
	else if(scr==2)
	{
		// keySetup
		int keySetup_k=k;
		int old=setSel;
		int step=1;
		if(mShift) step=8;
		if((mFctn||mCtrl)&&keySetup_k==77) changeParam(setSel,step);
		else if((mFctn||mCtrl)&&keySetup_k==80) changeParam(setSel,-step);
		else if(keySetup_k==77) setSel=(setSel+25)%26;
		else if(keySetup_k==80) setSel=(setSel+1)%26;
		else if(keySetup_k==57||keySetup_k==6) changeParam(setSel,-step);
		else if(keySetup_k==59||keySetup_k==26) changeParam(setSel,step);
		else if(keySetup_k==17) insFile(cg(10+trkSel),false);
		else if(keySetup_k==32) insFile(cg(10+trkSel),true);
		if(old!=setSel) {
			drawSetupRow(old);
			drawSetupRow(setSel);
		}
	}
	else if(scr==3)
	{
		// keyFile
		bool done=false;
		int keyFile_k=k;
		if(keyFile_k==63) {
			{
				// renameProject
				popup("PROJECT NAME (8 LETTERS OR DIGITS)");
				int n=readLine(8);
				if(n>0)
				{
					// bufToText_2
					nat bufToText_2_addr=&pname;
					int bufToText_2_len=n;
					for(int i=0;i<bufToText_2_len;i++) poke(bufToText_2_addr+(nat)i,tbuf[i]);
					poke(bufToText_2_addr+(nat)bufToText_2_len,0);
				}
				drawScreen();
			}
			done=true;
		}
		if(!done) {
			if(keyFile_k!=32&&keyFile_k!=17&&keyFile_k!=54) {
				done=true;
			}
			if(!done) {
				if(playing) stopPlay();
				if(keyFile_k==32)
				{
					// saveProject
					cs(4,tempo);
					byte e=saveOne();
					if(e==0) setMsg("SAVED");
					else setMsg("SAVE FAILED");
				}
				else if(keyFile_k==17) {
					{
						// loadProject
						memCpy(&sng,&bak,384);
						byte e=loadFiles();
						if(e==0) {
							{
								// fixSng
								cs(5,clamp((cg(5)),0,128));
								cs(6,clamp((cg(6)),0,1));
								cs(7,clamp((cg(7)),0,1));
								for(int t=0;t<8;t++) {
									cs(10+t,clamp((cg(10+t)),0,9));
									cs(18+t,clamp((cg(18+t)),0,7));
									cs(26+t,clamp((cg(26+t)),0,3));
									cs(34+t,clamp((cg(34+t)),0,127));
									cs(42+t,clamp((cg(42+t)),0,1));
								}
								for(int i=51;i<59;i++) cs(i,clamp((cg(i)),0,15));
								cs(50,clamp((cg(50)),0,3));
								cs(69,clamp((cg(69)),0,3));
								cs(59,clamp((cg(59)),0,1));
								cs(60,clamp((cg(60)),0,3));
								cs(61,clamp((cg(61)),0,3));
								cs(64,clamp((cg(64)),0,3));
								cs(65,clamp((cg(65)),0,15));
								cs(66,clamp((cg(66)),0,15));
								for(int i=0;i<128;i++) cs(128+i,clamp((cg(128+i)),0,63));
							}
							tempo=cg(4);
							calcStep();
							songSel=0;
							curPat=headOf(spat(0));
							curRow=0;
							initSound();
							applyBank();
							for(int t=0;t<6;t++) applyVoice(t);
							setMsg("LOADED");
						} else {
							memCpy(&bak,&sng,384);
							setMsg("LOAD FAILED");
						}
					}
					defaultInsNames();
				} else {
					{
						// newProject
						defaults();
						memSet(0x3000,24576,0,0x90);
						calcStep();
						songSel=0;
						curPat=0;
						curRow=0;
						curTrk=0;
						curFld=0;
						initSound();
						setMsg("NEW PROJECT");
					}
					defaultInsNames();
				}
				drawScreen();
			}
		}
	}
}

// fleches entree / pattern / transposition : vue SONG (0) et panneau (6) -> touches vue
// SONG

// blocs qui contiennent des notes : un bloc par tour de boucle, pour ne jamais geler
// l'ecran
int blkScan=0;
int blkAcc=0;

// --- programme
import("/system/reginit.dat",0x1100,0);
pname="NEWSONG";
defaults();
defaultInsNames();
memSet(0x3000,24576,0,0x90);
calcStep();
{
	// initSin
	for(int i=0;i<32;i++) {
		real a=(real)i*0.19635;
		sinT[i]=(byte)(10+(int)(sin(a)*10.0));
	}
}
initSound();
setMsg("READY");
drawScreen();
while(!quit) {
	{
		// handleKeys
		int k=getKeyUp();
		while(k!=0) {
			if(k==79&&mFctn&&!fctnOnce) mFctn=false;
			else if(k==79) fctnUps++;
			if((k==51||k==58)&&mShift&&!shiftOnce) mShift=false;
			else if(k==51||k==58) shiftUps++;
			if(k==11&&mCtrl&&!ctrlOnce) mCtrl=false;
			else if(k==11) ctrlUps++;
			k=getKeyUp();
		}
		k=getKeyDwn();
		if(k!=0)
		{
			// onKey
			bool done=false;
			int onKey_k=k;
			if(onKey_k==79) {
				mFctn=true;
				if(fctnUps>0) {
					fctnUps--;
					fctnOnce=true;
				}
				done=true;
			}
			if(!done) {
				if(onKey_k==51||onKey_k==58) {
					mShift=true;
					if(shiftUps>0) {
						shiftUps--;
						shiftOnce=true;
					}
					done=true;
				}
				if(!done) {
					if(onKey_k==11) {
						mCtrl=true;
						if(ctrlUps>0) {
							ctrlUps--;
							ctrlOnce=true;
						}
						done=true;
					}
					if(!done) {
						doKey(onKey_k);
						if(onKey_k==57||onKey_k==59||onKey_k==77||onKey_k==80) {
							repKey=onKey_k;
							repNext=_mSec+400;
						}
						if(fctnOnce) mFctn=false;
						if(shiftOnce) mShift=false;
						if(ctrlOnce) mCtrl=false;
						fctnOnce=false;
						shiftOnce=false;
						ctrlOnce=false;
					}
				}
			}
		}
	}
	{
		// handleMidi
		bool done=false;
		bool got=midiUpdt();
		if(!got) {
			done=true;
		}
		if(!done) {
			int ev=peek(0xFFD0);
			int m=peek(0xFFD2);
			int vel=peek(0xFFD3);
			if(ev==0x80||(ev==0x90&&vel==0)) {
				if(m==midiKey) {
					noteOff(curTrk);
					midiKey=-1;
					drawStatus();
				}
				done=true;
			}
			if(!done) {
				if(ev!=0x90) {
					done=true;
				}
				if(!done) {
					int v=clamp((m+1-cg(8)+64),1,120);
					if(isDrum(curTrk)) v=clamp((m-35),1,20);
					playNote_t=curTrk;
					playNote_v=v;
					playNote_vel=vel;
					playNote_ins=insv;
					playNote();
					midiKey=m;
					if(playing||scr!=0||curFld!=0) {
						drawStatus();
						done=true;
					}
					if(!done) {
						int oldRow=curRow;
						enterNote(v,vel);
						redrawRows(oldRow);
					}
				}
			}
		}
	}
	{
		// keyRepeat
		bool done=false;
		if(repKey==0) {
			done=true;
		}
		if(!done) {
			if(_keyDwn!=repKey) {
				repKey=0;
				done=true;
			}
			if(!done) {
				if(repNext>_mSec+1000) repNext=_mSec;
				if(_mSec<repNext) {
					done=true;
				}
				if(!done) {
					repNext=_mSec+70;
					doKey(repKey);
				}
			}
		}
	}
	{
		// updateBlocksUsed
		bool done=false;
		if(!blockEmpty(blkScan)) blkAcc++;
		blkScan++;
		if(blkScan<64) {
			done=true;
		}
		if(!done) {
			if(blkAcc!=blkCache) {
				blkCache=blkAcc;
				drawBlocks();
			}
			blkScan=0;
			blkAcc=0;
		}
	}
	if(playing)
	{
		// tickPlay
		bool done=false;
		nat now=_mSec;
		nat s=(nat)stepMs;
		if(now+carry<s) {
			done=true;
		}
		if(!done) {
			carry=now+carry-s;
			if(carry>s) carry=0;
			clkSet();
			for(int t=0;t<8;t++) {
				if(vu[t]>0) vu[t]--;
			}
			int oldEntry=-1;
			if(songMode) oldEntry=entAt();
			{
				// triggerRow
				int triggerRow_b=playBlk;
				int triggerRow_s=playRow;
				int tr=0;
				if(songMode) tr=strans(playPos);
				for(int t=0;t<8;t++) {
					int v=pget(triggerRow_b,triggerRow_s,t,0);
					if(v==255&&heard(t)) noteOff(t);
					else if(v!=0&&heard(t)) {
						if(t<6) v=clamp((v+tr),1,120);
						playNote_t=t;
						playNote_v=v;
						playNote_vel=pget(triggerRow_b,triggerRow_s,t,2);
						playNote_ins=pget(triggerRow_b,triggerRow_s,t,1);
						playNote();
					}
				}
			}
			playHead=headOf(playBlk);
			playLine=(playBlk-playHead)*16+playRow;
			// suivre le pattern qui joue (sauf pattern en attente)
			bool full=false;
			if(follow&&curPat!=playHead&&curPat!=cue) {
				curPat=playHead;
				curRow=clamp((curRow),0,plen(curPat)-1);
				full=true;
			}
			if(follow&&songMode) songSel=oldEntry;
			// la ligne virtuelle : +1 a chaque pas, meme quand le pattern repart a 0 ; elle ne recale
			// que sur un autre pattern, un saut, ou au bout d'environ une heure
			int pn=plen(playHead);
			if(full||vline>30000) vline=playLine;
			else if(playLine==(vline+1)%pn) vline++;
			else if(playLine!=vline%pn) vline=playLine;
			int nt=viewTop();
			// une ligne plus loin : la grille defile d'une ligne au lieu d'etre redessinee
			bool roll=!full&&nt==top+1;
			if(nt!=top&&!roll) full=true;
			int oldShown=shown;
			{
				// advance
				bool done=false;
				playRow++;
				if(playRow<16) {
					done=true;
				}
				if(!done) {
					playRow=0;
					if(songMode) {
						playPos++;
						if(playPos>=slen()) {
							playPos=0;
							if(cg(6)==0) endPlay=true;
						}
						playBlk=spat(playPos);
						done=true;
					}
					if(!done) {
						int h=headOf(playBlk);
						if(playBlk+1<h+blocks(h)) playBlk++;
						else if(cue>=0) {
							playBlk=cue;
							cue=-1;
						} else playBlk=h;
					}
				}
			}
			if(endPlay) {
				endPlay=false;
				stopPlay();
				done=true;
			}
			if(!done) {
				bool newEntry=songMode&&entAt()!=oldEntry;
				if(newEntry) {
					if(scr==1) drawSong();
				}
				drawBadge();
				if(scr!=0) {
					done=true;
				}
				if(!done) {
					if(roll) {
						top=nt;
						// ligne par ligne, de haut en bas : chaque copie ne recouvre pas sa source
						for(int i=0;i<15;i++) {
							nat a=(nat)((gY+i)*80+1);
							memCpy(0x1200+a+80,0x1200+a,75);
							memCpy(0x1E80+a+80,0x1E80+a,75);
						}
						drawRow(top+15);
						oldShown--;
						// redessin en cours (une ligne par tour) : les lignes pas encore faites ont monte
						if(pend>0) pend--;
					}
					if(full) top=nt;
					shown=-1;
					int pv=playLine;
					if(follow) pv=vline;
					if(playHead==curPat&&pv>=top&&pv<top+16) shown=pv-top;
					if(full) {
						pend=0;
						drawCenterTitle();
						drawScroll();
					} else {
						mark(oldShown,false);
						mark(shown,true);
					}
				}
			}
		}
	}
	else
	{
		// decayVu
		bool done=false;
		if(vuNext>_mSec+400) vuNext=_mSec+100;
		if(_mSec<vuNext) {
			done=true;
		}
		if(!done) {
			vuNext=_mSec+100;
			for(int t=0;t<8;t++) {
				if(vu[t]>0) vu[t]--;
			}
		}
	}
	{
		// updateScopes
		for(int t=0;t<8;t++) {
			if(vu[t]!=scopeV[t]) drawScope(t);
		}
	}
	// nouvelle page en lecture : une ligne par tour
	if(pend>=0) {
		if(scr==0) drawRow(top+pend);
		pend++;
		if(pend>15) pend=-1;
	}
}
{
	// stopAll_2
	for(int t=0;t<8;t++) noteOff(t);
}
memSet(0x1200,3200,' ');
memSet(0x1E80,3200,0x01);
memSet(0x3000,48000,0,0x60);
curPos(0,0);
print("Bye.");
