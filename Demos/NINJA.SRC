void buildSky()
{
	nat base=&sky;
	for(int k=0;k<40;k++)
	{
		int j=k*6;
		int nextBand=k+1;
		nat scan=(nat)(nextBand*10);
		if(nextBand==40)
		{
			nextBand=0;
			scan=480;                       // band 0 is set during the vertical blanking, then the list loops
		}
		sky[j].code=SET;
		sky[j].word=backR;
		sky[j+1].code=SET;
		sky[j+1].word=backG;
		sky[j+2].code=SET;
		sky[j+2].word=backB;
		sky[j+3].code=POS;
		sky[j+3].word=scan;
		sky[j+4].code=NEXT;
		sky[j+4].word=base+(nat)(nextBand*24);
		sky[j+5].code=HALT;
	}
}

