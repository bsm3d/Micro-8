void newPetal(int i,int top)
{
	petX[i]=rnd(240,900);
	petY[i]=top*4;
	petV[i]=rnd(3,7);
}

// the colours that follow the sky
void skyColours()
{
	moonR=moonTabR[skyNow];
	moonG=moonTabG[skyNow];
	moonB=moonTabB[skyNow];
	poke(bmpPal+1,moonR);
	poke(bmpPal+17,moonG);
	poke(bmpPal+33,moonB);
	poke(bmpPal+2,moonR-1);
	poke(bmpPal+18,moonG-1);
	poke(bmpPal+34,moonB);
	poke(bmpPal+3,haloR[skyNow]);
	poke(bmpPal+19,haloG[skyNow]);
	poke(bmpPal+35,haloB[skyNow]);
	starMax=starTop[skyNow];
	if(starMax<2 && starsOn) showStars(false);
	if(starMax>=2 && !starsOn) showStars(true);
	poke(bmpPal+7,cloudR[skyNow]);
	poke(bmpPal+23,cloudG[skyNow]);
	poke(bmpPal+39,cloudB[skyNow]);
	poke(bmpPal+26,snowG[skyNow]);
	poke(bmpPal+42,snowB[skyNow]);
}

void placeSun()
{
	for(int k=0;k<9;k++)
	{
		int col=k%3;
		int row=k/3;
		if(sunTop>=400) sprPos((byte)k,0,0);
		else sprPos((byte)k,276+col*48,sunTop+42+row*42);
	}
}

// ------------------------------------------------------------------ start
memCpy(bmpPal,&savedBmp,48);
memCpy(sprPalA,&savedSprA,48);
memCpy(sprPalB,&savedSprB,48);
byte savedMode=peek(0x2F00);
byte page=peek(0x2F05);
poke(0x2F16,page);                  // draw on the picture shown
poke(0x2F0B,peek(0x2F0B)&0x7F);     // no mouse pointer during the show
poke(backR,0);
poke(backG,0);
poke(backB,0);
memSet(0x1200,3200,' ');
memSet(0x1E80,3200,0x0F);
memSet(0x3000,48000,0,page);
memCpy(&scenePal,bmpPal,48);
memCpy(&spritePal,sprPalA,48);
memCpy(&sunPal,sprPalB,48);
poke(0x2F00,0xB1);                  // bitmap (colour 0 transparent, colours 8-15 over the sprites) and text
curPos(34,36);
print("Code & Music");
memSet(0x1E80+2914,12,0x0B);
curPos(30,37);
print("Benoit Saint-Moulin");
memSet(0x1E80+2990,19,0x02);
curPos(34,39);
print("ESC to quit");
memSet(0x1E80+3154,11,0x0F);
rndSeed(_mSec);
scene();
buildSky();
skyColours();
import("NINJA.SPR",cpuWindow,6144,sprPage);
for(int s=0;s<32;s++)
{
	sprPos((byte)s,0,0);            // (0,0) hides a sprite
	sprPal((byte)s,0);
	sprPrio((byte)s,0);
}
// from the back to the front: the sun (0-8), the birds, the ninja, the petals, the shuriken, the title
for(int k=0;k<9;k++)
{
	sprRef((byte)k,(byte)(11+k));
	sprPal((byte)k,1);
}
for(int k=0;k<3;k++) sprRef((byte)(9+k),20);
sprRef(12,22);
sprPos(12,570,160);            // on the top beam of the torii
sprRef(26,7);
sprPos(26,88,76);
sprRef(27,8);
sprPos(27,132,76);
sprRef(28,7);
sprPos(28,176,76);
sprRef(29,9);
sprPos(29,220,76);
sprRef(30,10);
sprPos(30,264,76);
for(int i=0;i<NPETALS;i++)
{
	newPetal(i,rnd(40,500));
	sprRef((byte)(13+i),(byte)(4+i%3));
}
sprUpdt();
rstrInt(true);
rstrCmp(480,&sky);
poke(0x2F00,0xB5);                  // and the sprites

memSet(&pname,9,0);
concat(pname,"NINJA");
bool loaded=loadFiles()==0;
if(loaded)
{
	fixSng();
	tempo=cg(4);
	initSound();
	applyBank();
	for(int t=0;t<6;t++) applyVoice(t);
	startPlay();
}
else
{
	curPos(15,34);
	print("NINJA.M8S not found: copy it next to this program");
	memSet(0x1E80+2735,49,0x0D);
}

// where the sky should be: night for the 4 bars of the intro, then towards sunrise until bar 46, held, and back
// to night during the last 2 bars
int skyWanted()
{
	int p=playPos*16+playRow;
	if(p<64) return 0;
	if(p>=832) return ((863-p)*23)/32;
	if(p>=736) return 23;
	return ((p-64)/6*23)/112;
}

void frame()
{
	frames++;
	if(frames>=16384) frames=0;
	// the sky: one band of the next sky a frame, then the colours that go with it
	if(skyBand<40)
	{
		nat a=&sky+(nat)(skyBand*24);
		int i=skyNow*40+skyBand;
		poke(a+3,skyR[i]);
		poke(a+7,skyG[i]);
		poke(a+11,skyB[i]);
		skyBand++;
	}
	else
	{
		int want=skyWanted();
		if(want!=skyNow)
		{
			int step=want-skyNow;
			if(step>1) step=1;
			if(step<-4) step=-4;        // the night comes back faster than the day came
			skyNow=skyNow+step;
			skyBand=0;
			skyColours();
		}
	}
	// the sun follows its place under this sky, a line a frame
	int top=sunRise[skyNow];
	if(top!=sunTop)
	{
		if(top<sunTop) sunTop--;
		else
		{
			sunTop=sunTop+3;
			if(sunTop>top) sunTop=top;
		}
		placeSun();
	}
	// the glows: only the colours that change are written
	if(moonHit>0)
	{
		moonHit--;
		byte up=(byte)((moonHit+3)/4);
		poke(bmpPal+1,(byte)min(7,moonR+up));
		poke(bmpPal+17,(byte)min(7,moonG+up));
		poke(bmpPal+33,(byte)min(7,moonB+up));
	}
	if(toriiHit>0)
	{
		toriiHit--;
		poke(bmpPal+11,toriiR[toriiHit]);
		poke(bmpPal+27,toriiG[toriiHit]);
	}
	if(leadHit>0)
	{
		leadHit--;
		byte g=1;
		if(leadHit>3) g=6;
		else if(leadHit>1) g=3;
		poke(sprPalA+16+6,g);       // the title: red at rest, towards white on a note
		poke(sprPalA+32+6,g-1);
	}
	// one group of stars out of three shines, the koto moves it on; all of them fade with the dawn
	byte st=starTurn%3;
	for(byte k=0;k<3;k++)
	{
		byte v=starMax/3;
		if(k==st) v=starMax;
		nat n=(nat)k;
		poke(bmpPal+4+n,v);
		poke(bmpPal+20+n,v);
		poke(bmpPal+36+n,v);
	}
	// the blade: on, then off again 5 frames later (the same line twice with the XOR mask)
	if(slash==6)
	{
		slash=0;
		if(slashOn==0)
		{
			slashY=rnd(40,150);
			line(0,slashY+40,399,slashY,0xF0);
			slashOn=5;
		}
	}
	else if(slashOn>0)
	{
		slashOn--;
		if(slashOn==0) line(0,slashY+40,399,slashY,0xF0);
	}
	// the shuriken: a new one on a snare, then straight across, turning
	if(throwNow!=0)
	{
		throwNow=0;
		for(int k=0;k<3;k++)
		{
			if(shV[k]==0)
			{
				shY[k]=rnd(120,400);
				shV[k]=15;
				shX[k]=40;
				if(!fromLeft)
				{
					shV[k]=-15;
					shX[k]=850;
				}
				fromLeft=!fromLeft;
				break;
			}
		}
	}
	for(int k=0;k<3;k++)
	{
		if(shV[k]!=0)
		{
			int x=shX[k]+shV[k];
			shX[k]=x;
			if(x<30 || x>860)
			{
				shV[k]=0;
				sprPos((byte)(23+k),0,0);
			}
			else
			{
				sprRef((byte)(23+k),(byte)((frames>>1)%4));
				sprPos((byte)(23+k),x,shY[k]);
			}
		}
	}
	// the birds: they cross once the sky is light enough, wings up, wings down
	for(int k=0;k<3;k++)
	{
		int x=birdX[k];
		if(x==0)
		{
			if(skyNow>=11 && rnd(0,300)==0)
			{
				birdX[k]=20;
				birdY[k]=rnd(150,300);
			}
		}
		else
		{
			x=x+2;
			if(x>880)
			{
				x=0;
				sprPos((byte)(9+k),0,0);
			}
			else
			{
				sprRef((byte)(9+k),(byte)(20+((frames>>3)+k)%2));
				sprPos((byte)(9+k),x,birdY[k]);
			}
			birdX[k]=x;
		}
	}
	// the headband of the ninja flies
	sprRef(12,(byte)(22+(frames>>4)%2));
	// the petals: down, drifting left, swaying
	for(int i=0;i<NPETALS;i++)
	{
		int y=petY[i]+petV[i];
		if(y>2120) newPetal(i,34);
		else petY[i]=y;
		if(frames%4==0) petX[i]=petX[i]-1;
		sprPos((byte)(13+i),petX[i]+sway[(frames+i*9)%64],petY[i]>>2);
	}
	sprUpdt();
}

byte lastFrame=peek(0x2F0C);
int key=getKeyDwn();
while(key!=0) key=getKeyDwn();
while(key!=12)
{
	if(playing) tickPlay();
	byte f=peek(0x2F0C);
	if(f!=lastFrame)
	{
		lastFrame=f;
		frame();
		key=getKeyDwn();
	}
}

// leave the machine as it was
stopAll();
rstrInt(false);
for(int s=0;s<32;s++)
{
	sprPos((byte)s,0,0);
	sprPal((byte)s,0);
}
sprUpdt();
memSet(0x1200,3200,' ');
memSet(0x1E80,3200,0x01);
memSet(0x3000,48000,0,page);
memCpy(&savedBmp,bmpPal,48);
memCpy(&savedSprA,sprPalA,48);
memCpy(&savedSprB,sprPalB,48);
poke(backR,5);
poke(backG,5);
poke(backB,5);
poke(0x2F00,savedMode);
poke(0x2F0B,peek(0x2F0B)|0x80);
