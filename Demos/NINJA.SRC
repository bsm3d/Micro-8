// the stars are drawn at night and taken away when the sky is light (a star with no light would be a black dot)
void showStars(bool on)
{
	for(int i=0;i<nStars;i++)
	{
		byte c=0;
		if(on) c=(byte)(4+i%3);
		plot(starX[i],starY[i],c);
	}
	starsOn=on;
}

void scene()
{
	// the stars, in the sky only, not on the moon
	for(int i=0;i<70;i++)
	{
		int x=rnd(0,399);
		int y=rnd(2,118);
		int dx=x-270;
		int dy=y-95;
		if(abs(dx)>70 || abs(dy)>70)
		{
			starX[nStars]=x;
			starY[nStars]=(byte)y;
			nStars++;
		}
	}
	showStars(true);
	// clouds: thin streaks low in the sky, black until the dawn colours them
	box(20,152,96,153,7);
	box(52,157,150,158,7);
	box(170,166,236,167,7);
	box(318,160,392,161,7);
	box(340,170,399,171,7);
	box(0,178,70,179,7);
	box(196,180,300,181,7);
	// the moon, its halo and its seas
	circle(270,95,66,3);
	circle(270,95,64,3);
	disk(270,95,62,1);
	disk(250,78,11,2);
	disk(284,70,7,2);
	disk(292,106,13,2);
	disk(256,118,6,2);
	// the ground and the mountain: black, and over the sprites, so the sun rises behind them
	box(0,200,399,239,8);
	tri(107,200,0,196,40,176,8);
	tri(107,200,40,176,78,148,8);
	tri(107,200,78,148,96,128,8);
	tri(107,200,96,128,104,124,8);
	tri(107,200,104,124,118,124,8);
	tri(107,200,118,124,126,128,8);
	tri(107,200,126,128,146,150,8);
	tri(107,200,146,150,186,180,8);
	tri(107,200,186,180,214,196,8);
	tri(107,200,0,196,0,200,8);
	tri(107,200,214,196,214,200,8);
	// its edge and its snow
	line(0,196,40,176,9);
	line(40,176,78,148,9);
	line(78,148,96,128,9);
	line(126,128,146,150,9);
	line(146,150,186,180,9);
	line(186,180,214,196,9);
	tri(96,128,104,124,101,136,10);
	tri(104,124,118,124,111,138,10);
	tri(104,124,101,136,106,130,10);
	tri(118,124,126,128,121,136,10);
	tri(118,124,121,136,116,130,10);
	tri(106,130,111,138,116,130,10);
	line(0,200,399,200,13);
	// the torii: two pillars, the top beam with its raised ends, the tie beam and the strut
	box(236,96,243,200,11);
	box(304,96,311,200,11);
	box(242,96,243,200,12);
	box(310,96,311,200,12);
	box(232,196,247,200,12);
	box(300,196,315,200,12);
	box(214,80,333,87,11);
