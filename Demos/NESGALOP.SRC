// the bar's top follows a sine: the bands stay where they are, their colours are rewritten (copper style), so
// nothing the raster IRQ has already latched can disagree with the new position. Black outside the bar.
byte barR[16]={0,0,1,2,4,5,6,4,4,6,5,4,2,1,0,0};
byte barG[16]={2,3,5,7,7,7,6,4,4,6,7,7,7,5,3,2};
byte barB[16]={0,1,1,2,2,4,6,4,4,6,4,2,2,1,1,0};
byte sine[64]={
	70,76,82,87,93,98,103,108,112,116,120,123,125,127,129,130,130,130,129,127,125,123,120,116,
	112,108,103,98,93,87,82,76,70,64,58,53,47,42,37,32,28,24,20,17,15,13,11,10,
	10,10,11,13,15,17,20,24,28,32,37,42,47,53,58,64};
int lastB0=-100;

void moveBar(int t) {
	int b0=(sine[(t/2)%64]-8)/4;
	if(b0==lastB0) return;
	int from=b0;
	int to=lastB0;
	if(lastB0<b0) {
		from=lastB0;
		to=b0;
	}
	if(lastB0<0) {
		from=0;
		to=48;
	}
	lastB0=b0;
	to=to+16;
	if(from<0) from=0;
	if(to>48) to=48;
	for(int i=from;i<to;i++) {
		int k=i-b0;
		int j=6+i*6;
		if(k>=0 && k<16) {
			list[j].val=barR[k];
			list[j+1].val=barG[k];
			list[j+2].val=barB[k];
		} else {
			list[j].val=0;
			list[j+1].val=0;
			list[j+2].val=0;
		}
	}
}

// ------------------------------------------------------------------ screen
void cell(int x,int y,int g,int c) {
	nat a=(nat)y*80+(nat)x;
	poke(0x1200+a,(byte)g);
	poke(0x1E80+a,(byte)c);
}

text labels[9]={"N E S   G A L O P","a NES-style tune for the Micro-8","BASS",
	"LEAD","CHORDS","DRUMS",
	"Code, Arrangement","Benoit Saint-Moulin","ESC to quit"};
text wbuf={80};
void write(int x,int y,int k,int c) {
	memSet(&wbuf,81,0);
	concat(wbuf,labels[k]);
	for(int i=0;i<80-x;i++) {
		byte g=peek(&wbuf+(nat)i);
		if(g==0) return;
		cell(x+i,y,g,c);                  // a byte widens to int by itself: (int) on a byte is refused
	}
}

int starX[8];
int starY[8];

void initStars() {
	for(int s=0;s<8;s++) {
		starX[s]=(s*23+7)%80;
		starY[s]=22+(s*5)%6;
	}
}

// text only, on a black background: the raster bar is the background colour itself
void blackScreen() {
	poke(0x2F00,0x10);
	poke(0x2F0B,peek(0x2F0B)&0x7F);     // no mouse pointer during the show
	poke(backR,0);
	poke(backG,0);
	poke(backB,0);
	memSet(0x1200,3200,' ');
	memSet(0x1E80,3200,0x01);
}

void drawStatic() {
	memSet(0x1200,3200,' ');
	memSet(0x1E80,3200,0x01);
	write(31,6,0,0x0B);
	write(24,9,1,0x02);
	write(22,14,2,0x09);
	write(22,16,3,0x09);
	write(22,18,4,0x09);
	write(22,20,5,0x09);
	write(31,29,6,0x07);
	write(30,30,7,0x07);
	write(34,32,8,0x07);
	initStars();
	for(int ch=0;ch<4;ch++) {
		for(int i=0;i<15;i++) cell(32+i,14+ch*2,0x7F,0x06);
	}
}

// meter zones: green 0-8, yellow 9-12, red 13-14 (dark grey when off); a level change repaints [a,b) with
// memSet, one call per zone
byte zoneFrom[3]={0,9,13};
byte zoneTo[3]={9,13,15};
byte zoneCol[3]={0x09,0x0B,0x0D};

void paintMeter(nat base,int a,int b,bool on) {
	for(int z=0;z<3;z++) {
		int f=zoneFrom[z];
		int e=zoneTo[z];
		if(f<a) f=a;
		if(e>b) e=b;
		if(f<e) {
			byte c=0x06;
			if(on) c=zoneCol[z];
			memSet(base+(nat)f,(nat)(e-f),c);
		}
	}
}

byte rainbow[28]={0x0D,0x0C,0x0B,0x09,0x07,0x04,0x03,0x0D,0x0D,0x0C,0x0B,0x09,0x07,0x04,0x03,0x0D,
	0x0D,0x0C,0x0B,0x09,0x07,0x04,0x03,0x0D,0x0D,0x0C,0x0B,0x09};

// parallax stars (cracktro): three slow speeds (one step every 2 to 6 frames), the nearer ones brighter
void stars(int t) {
	for(int s=0;s<8;s++) {
		int sp=1+s%3;
		if(t%(8-2*sp)==0) {
			nat a=(nat)(starY[s]*80+starX[s]);
			poke(0x1200+a,' ');
			int x=starX[s]-1;
			if(x<0) x=79;
			starX[s]=x;
			a=(nat)(starY[s]*80+x);
			byte ch='.';
			byte c=0x03;
			if(sp==2) {
				ch=':';
				c=0x07;
			}
			if(sp==3) {
				ch='*';
				c=0x0D;
			}
			poke(0x1200+a,ch);
			poke(0x1E80+a,c);
		}
	}
}

void drawFrame(int t) {
	// title colour wave, every 4 frames; the credit line takes it shifted, the name stays static
	if(t%4==0) {
		memCpy(&rainbow+(nat)((t/4)%8),0x1E80+6*80+31,17);
		memCpy(&rainbow+(nat)((t/4+3)%8),0x1E80+29*80+31,17);
	}
	// meters: only the cells between the shown level and the new one change colour
	for(int ch=0;ch<4;ch++) {
		int lvl=vu[ch];
		int old=shownVu[ch];
		if(lvl!=old) {
			int a=old;
			int b=lvl;
			if(lvl<old) {
				a=lvl;
				b=old;
			}
			nat base=0x1E80+(nat)(14+ch*2)*80+32;
			paintMeter(base,a,b,lvl>old);
			shownVu[ch]=lvl;
		}
		if(t%2==0 && vu[ch]>0) vu[ch]--;
	}
	if(t%2==1) stars(t/2);
}

void restoreScreen() {
	rstrInt(false);
	poke(backR,5);
	poke(backG,5);
	poke(backB,5);
	poke(0x2F00,0x11);
	poke(0x2F0B,peek(0x2F0B)|0x80);
	memSet(0x1200,3200,' ');
	memSet(0x1E80,3200,0x02);
	curPos(0,0);
}

// ------------------------------------------------------------------ main
blackScreen();
memSet(0x1E80+19*80,80,0x02);
curPos(32,19);
print("Loading the song");
byte err=0;
for(int p=0;p<NPARTS&&err==0;p++) err=loadPart(p);
int key=getKeyDwn();
if(err!=0) {
	curPos(14,19);
	print("Cannot load ",fnm," (error ",err,") - ESC to quit   ");
	while(key!=12) key=getKeyDwn();
	restoreScreen();
} else {
	usePart(0);
	setupSound();
	drawStatic();
	rstrInt(true);
	rstrCmp(480,&list);
	int t=0;
	bool barDue=false;
	byte lastFc=peek(0x2F0C);
	while(key!=0) key=getKeyDwn();      // the key that started the program (ENTER, ESC) must not be taken for a quit
	startPlay();
	while(key!=12) {
		tickPlay();
		byte fc=peek(0x2F0C);
		if(fc!=lastFc) {
			// a new frame (line 480): the text now, the bar 8 ms later, when the beam is below it (line 210) and
			// long before it comes back to the top
			lastFc=fc;
			frameAt=(int)_mSec;
			drawFrame(t);
			barDue=true;
			t++;
			if(t>=7680) t=0;              // an int would turn negative after 9 minutes (7680 = 64 * 120: the sines keep their phase)
		}
		if(barDue&&(int)_mSec-frameAt>=8) {
			barDue=false;
			moveBar(t);
		}
		key=getKeyDwn();
	}
	stopAll();
	restoreScreen();
}
print("Bye.");
