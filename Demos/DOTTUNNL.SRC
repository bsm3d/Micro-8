// DOTS TUNNEL - a winding dot tunnel
// Code & Music: Benoit (BSM) Saint-Moulin, www.bsm3d.com
// Demo 1.0 for Micro-8 OS 0.9

nat cpuWindow=0x3000;
byte bmpPageA=0x60;
byte bmpPageB=0x8f;
nat bmpDrawReg=0x2f16;
nat bmpDisplayReg=0x2f05;
nat bmpPal=0x11A0;

// cos and sin * 127 of 64 angles from 0 to a quarter turn (127 * radius stays in an int: 16 bits)
int cosT[64]={
	127,127,127,127,126,126,126,125,125,124,123,122,122,121,120,118,
	117,116,115,113,112,111,109,107,106,104,102,100,98,96,94,92,
	90,88,85,83,81,78,76,73,71,68,65,63,60,57,54,51,
	49,46,43,40,37,34,31,28,25,22,19,16,12,9,6,3};
int sinT[64]={
	0,3,6,9,12,16,19,22,25,28,31,34,37,40,43,46,
	49,51,54,57,60,63,65,68,71,73,76,78,81,83,85,88,
	90,92,94,96,98,100,102,104,106,107,109,111,112,113,115,116,
	117,118,120,121,122,122,123,124,125,125,126,126,126,127,127,127};
// 24 hues: r g b of the nearest, brightest points
byte hues[72]={
	7,2,2,7,3,2,7,4,2,7,6,2,7,7,2,6,7,2,4,7,2,3,7,2,
	2,7,2,2,7,3,2,7,4,2,7,6,2,7,7,2,6,7,2,4,7,2,3,7,
	2,2,7,3,2,7,4,2,7,6,2,7,7,2,7,7,2,6,7,2,4,7,2,3};

byte savedPal[48];
memCpy(bmpPal,&savedPal,48);
memSet(0x1200,3200,' ');
memSet(cpuWindow,48000,0,bmpPageA);
memSet(cpuWindow,48000,0,bmpPageB);

// colour 0 = black background, 1 (far) to 7 (near) = a ramp of one hue: the far points stay visible
int lvl[8]={0,2,3,4,5,5,6,7};
void setHue(int h)
{
	nat p=(nat)(h*3);
	poke(bmpPal,0);
	poke(bmpPal+16,0);
	poke(bmpPal+32,0);
	for(int i=1;i<8;i++)
	{
		nat n=(nat)i;
		poke(bmpPal+n,(byte)((hues[p]*lvl[i]+3)/7));
		poke(bmpPal+16+n,(byte)((hues[p+1]*lvl[i]+3)/7));
		poke(bmpPal+32+n,(byte)((hues[p+2]*lvl[i]+3)/7));
	}
}
setHue(20);

bool swapState;
void swap()
{
	if(swapState)
	{
		poke(bmpDisplayReg,bmpPageA);
		poke(bmpDrawReg,bmpPageB);
	}
	else
	{
		poke(bmpDisplayReg,bmpPageB);
		poke(bmpDrawReg,bmpPageA);
	}
	swapState=!swapState;
}
swap();

int NC=18;
int CX=200;
int CY=120;
real ZSPEED=0.008;
real circZ[18];
for(int i;i<NC;i++) circZ[i]=(real)(i+1)/(real)NC;

void ring(int r,int k,byte c)
{
	int a;
	int b;
	a=(cosT[k]*r)>>7;
	b=(sinT[k]*r)>>7;
	plot(CX+a,CY+b,c);
	plot(CX-b,CY+a,c);
	plot(CX-a,CY-b,c);
	plot(CX+b,CY-a,c);
	a=(cosT[k+8]*r)>>7;
	b=(sinT[k+8]*r)>>7;
	plot(CX+a,CY+b,c);
	plot(CX-b,CY+a,c);
	plot(CX-a,CY-b,c);
	plot(CX+b,CY-a,c);
	a=(cosT[k+16]*r)>>7;
	b=(sinT[k+16]*r)>>7;
	plot(CX+a,CY+b,c);
	plot(CX-b,CY+a,c);
	plot(CX-a,CY-b,c);
	plot(CX+b,CY-a,c);
	a=(cosT[k+24]*r)>>7;
	b=(sinT[k+24]*r)>>7;
	plot(CX+a,CY+b,c);
	plot(CX-b,CY+a,c);
	plot(CX-a,CY-b,c);
	plot(CX+b,CY-a,c);
	a=(cosT[k+32]*r)>>7;
	b=(sinT[k+32]*r)>>7;
	plot(CX+a,CY+b,c);
	plot(CX-b,CY+a,c);
	plot(CX-a,CY-b,c);
	plot(CX+b,CY-a,c);
	a=(cosT[k+40]*r)>>7;
	b=(sinT[k+40]*r)>>7;
	plot(CX+a,CY+b,c);
	plot(CX-b,CY+a,c);
	plot(CX-a,CY-b,c);
	plot(CX+b,CY-a,c);
	a=(cosT[k+48]*r)>>7;
	b=(sinT[k+48]*r)>>7;
	plot(CX+a,CY+b,c);
	plot(CX-b,CY+a,c);
	plot(CX-a,CY-b,c);
	plot(CX+b,CY-a,c);
	a=(cosT[k+56]*r)>>7;
	b=(sinT[k+56]*r)>>7;
	plot(CX+a,CY+b,c);
	plot(CX-b,CY+a,c);
	plot(CX-a,CY-b,c);
	plot(CX+b,CY-a,c);
}

// the near points are 2 pixels wide and high
void ringBig(int r,int k,byte c)
{
	int a;
	int b;
	a=(cosT[k]*r)>>7;
	b=(sinT[k]*r)>>7;
	box(CX+a,CY+b,CX+a+1,CY+b+1,c);
	box(CX-b,CY+a,CX-b+1,CY+a+1,c);
	box(CX-a,CY-b,CX-a+1,CY-b+1,c);
	box(CX+b,CY-a,CX+b+1,CY-a+1,c);
	a=(cosT[k+8]*r)>>7;
	b=(sinT[k+8]*r)>>7;
	box(CX+a,CY+b,CX+a+1,CY+b+1,c);
	box(CX-b,CY+a,CX-b+1,CY+a+1,c);
	box(CX-a,CY-b,CX-a+1,CY-b+1,c);
	box(CX+b,CY-a,CX+b+1,CY-a+1,c);
	a=(cosT[k+16]*r)>>7;
	b=(sinT[k+16]*r)>>7;
	box(CX+a,CY+b,CX+a+1,CY+b+1,c);
	box(CX-b,CY+a,CX-b+1,CY+a+1,c);
	box(CX-a,CY-b,CX-a+1,CY-b+1,c);
	box(CX+b,CY-a,CX+b+1,CY-a+1,c);
	a=(cosT[k+24]*r)>>7;
	b=(sinT[k+24]*r)>>7;
	box(CX+a,CY+b,CX+a+1,CY+b+1,c);
	box(CX-b,CY+a,CX-b+1,CY+a+1,c);
	box(CX-a,CY-b,CX-a+1,CY-b+1,c);
	box(CX+b,CY-a,CX+b+1,CY-a+1,c);
	a=(cosT[k+32]*r)>>7;
	b=(sinT[k+32]*r)>>7;
	box(CX+a,CY+b,CX+a+1,CY+b+1,c);
	box(CX-b,CY+a,CX-b+1,CY+a+1,c);
	box(CX-a,CY-b,CX-a+1,CY-b+1,c);
	box(CX+b,CY-a,CX+b+1,CY-a+1,c);
	a=(cosT[k+40]*r)>>7;
	b=(sinT[k+40]*r)>>7;
	box(CX+a,CY+b,CX+a+1,CY+b+1,c);
	box(CX-b,CY+a,CX-b+1,CY+a+1,c);
	box(CX-a,CY-b,CX-a+1,CY-b+1,c);
	box(CX+b,CY-a,CX+b+1,CY-a+1,c);
	a=(cosT[k+48]*r)>>7;
	b=(sinT[k+48]*r)>>7;
	box(CX+a,CY+b,CX+a+1,CY+b+1,c);
	box(CX-b,CY+a,CX-b+1,CY+a+1,c);
	box(CX-a,CY-b,CX-a+1,CY-b+1,c);
	box(CX+b,CY-a,CX+b+1,CY-a+1,c);
	a=(cosT[k+56]*r)>>7;
	b=(sinT[k+56]*r)>>7;
	box(CX+a,CY+b,CX+a+1,CY+b+1,c);
	box(CX-b,CY+a,CX-b+1,CY+a+1,c);
	box(CX-a,CY-b,CX-a+1,CY-b+1,c);
	box(CX+b,CY-a,CX+b+1,CY-a+1,c);
}

real bendX;
real bendY;
real turn;
int hue=20;
int hueT;

void frame()
{
	for(int i=0;i<NC;i++)
	{
		real z=circZ[i]-ZSPEED;
		if(z<=0.0) z=z+1.0;
		circZ[i]=z;
		CX=200+(int)(z*75.0*sin(bendX+z*3.0));
		CY=120+(int)(z*42.0*cos(bendY+z*2.2));
		int r=(int)(26.0/(z+0.11));
		int k=((int)(turn+z*40.0))%8;
		int ci=7-(int)(z*7.0);
		if(ci<1) ci=1;
		if(z<0.22) ringBig(r,k,(byte)ci);
		else ring(r,k,(byte)ci);
	}
	bendX=bendX+0.035;
	if(bendX>=6.2832) bendX=bendX-6.2832;
	bendY=bendY+0.046;
	if(bendY>=6.2832) bendY=bendY-6.2832;
	turn=turn+0.15;
	if(turn>=8.0) turn=turn-8.0;
	hueT++;
	if(hueT>=20)
	{
		hueT=0;
		hue=(hue+1)%24;
		setHue(hue);
	}
}

vCount(2);
while(_keyDwn!=12)
{
	frame();
	vSync();
	swap();
	memSet(cpuWindow,48000,0,peek(bmpDrawReg));
}

vCount(1);
poke(bmpDisplayReg,bmpPageA);
poke(bmpDrawReg,bmpPageA);
memSet(cpuWindow,48000,0,bmpPageA);
memCpy(&savedPal,bmpPal,48);
