
//Three nested rotating wireframe cubes
//By Benoit (BSM) Saint-Moulin, built on the CUBEOPTI.SRC technique by Fabrice Lete
//Black background: colour 0 of the bitmap palette is set to black for the show and given back at the end

nat cpuWindow=0x3000;
byte bmpPageA=0x60;//double buffer
byte bmpPageB=0x8f;

nat bmpDrawReg=0x2f16;
nat bmpDisplayReg=0x2f05;

nat bmpPal=0x11A0;//16 reds, 16 greens, 16 blues
byte savedR=peek(bmpPal);
byte savedG=peek(bmpPal+16);
byte savedB=peek(bmpPal+32);
poke(bmpPal,0);
poke(bmpPal+16,0);
poke(bmpPal+32,0);
memSet(0x1200,3200,' ');//no text over the cubes
memSet(cpuWindow,48000,0,bmpPageA);//clear bitmap buffers
memSet(cpuWindow,48000,0,bmpPageB);
bool swapState;
void swap()
{
	if(swapState)
	{
		poke(bmpDisplayReg,bmpPageA);//display
		poke(bmpDrawReg,bmpPageB);//draw
	}
	else
	{
		poke(bmpDisplayReg,bmpPageB);//display
		poke(bmpDrawReg,bmpPageA);//draw
	}
	swapState=!swapState;
}
swap();

real TWOPI = 3.1416 * 2;
real STEP = TWOPI/100;

int vt1[16];//transformed vertices, outer cube
int vt2[16];//middle cube
int vt3[16];//inner cube
int vp1[16];//previous vertices (to clear)
int vp2[16];
int vp3[16];

byte e[24]={0,1,1,3,3,2,2,0,4,5,5,7,7,6,6,4,0,4,1,5,3,7,2,6};

real rot1;
real rot2;
real rot3;

void renderCube(byte col, int v[])
{
	for(int i;i<#e;i+=2)
	{
		byte a=e[i]<<1;
		byte b=e[i+1]<<1;
		line(v[a],v[a+1],v[b],v[b+1],col);
	}
}

void project(real rot, real scale, int v[])
{
	real s=sin(rot);
	real c=cos(rot);
	for(int i;i<8;i++)
	{
		real x=(i&1<<1-1)*scale;
		real y=(i&2-1)*scale;
		real z=(i&4>>1-1)*scale;
		real tx=c*x-s*z;
		real ty=s*-s*x+c*y+c*-s*z;
		real tz=s*c*x+s*y+c*c*z;
		tz+=s*6+14;
		int i2=i<<1;
		v[i2]=200+(int)(tx*400/tz/1.666);
		v[i2+1]=120+(int)(ty*240/tz);
	}
}

while(_keyDwn!=12)
{
	project(rot1,1.0,vt1);
	project(rot2,0.7,vt2);
	project(rot3,0.4,vt3);
	renderCube(4,vt1);//outer: blue
	renderCube(7,vt2);//middle: cyan
	renderCube(2,vt3);//inner: white

	vSync();
	swap();

	renderCube(0,vp1);//clear previous
	renderCube(0,vp2);
	renderCube(0,vp3);
	memCpy(&vt1,&vp1,32);//store for next clear
	memCpy(&vt2,&vp2,32);
	memCpy(&vt3,&vp3,32);

	rot1+=STEP;
	rot2-=STEP*1.3;
	rot3+=STEP*0.6;
	if(rot1>=TWOPI) rot1=0.0;
	if(rot1<0.0) rot1=rot1+TWOPI;
	if(rot2>=TWOPI) rot2=0.0;
	if(rot2<0.0) rot2=rot2+TWOPI;
	if(rot3>=TWOPI) rot3=0.0;
	if(rot3<0.0) rot3=rot3+TWOPI;
}

//leave the machine as it was
poke(bmpDisplayReg,bmpPageA);
poke(bmpDrawReg,bmpPageA);
memSet(cpuWindow,48000,0,bmpPageA);
poke(bmpPal,savedR);
poke(bmpPal+16,savedG);
poke(bmpPal+32,savedB);
