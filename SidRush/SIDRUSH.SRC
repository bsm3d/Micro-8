	70,76,82,87,93,98,103,108,112,116,120,123,125,127,129,130,130,130,129,127,125,123,120,116,
	112,108,103,98,93,87,82,76,70,64,58,53,47,42,37,32,28,24,20,17,15,13,11,10,
	10,10,11,13,15,17,20,24,28,32,37,42,47,53,58,64};

// ------------------------------------------------------------------ state
byte SPEED=6;              // frames per row (59.92 Hz frames: 10 rows a second)
int frame=0;
int row=0;
int pos=0;                 // position in song[]
int bar=0;
int chord=0;
int arpStep=0;
int leadNote=0;
int leadAge=0;
int vu[4];
int shownVu[4];
int vibDepth=0;
int lastB0=-100;

// ------------------------------------------------------------------ sound
void setupSound() {
	ymInit(0);
	ymVol(127);
	synInit(0);
	ymLoad("/tools/sounded/sounds/bass01.ins",0);
	ymLoad("/tools/sounded/sounds/lead02.ins",1);
	ymVoice(0,0,5,0b11,112);
	ymVoice(1,1,5,0b11,112);
	synVoice(0,3,0,0b11,13);           // DPCM drums
	synVoice(1,1,5,0b11,10);            // sawtooth arpeggio (octave 5: the note numbers are the real MIDI ones)
	synEnv(1,0,5,9,15);              // fast release: the arp gate closes before each pitch change
}

void drum(int ins) {
	synNoteOff(0);
	synNoteOn(0,(byte)ins,128);
	vu[3]=15;
}

void bass(int note) {
	ymNoteOff(0);
	ymNoteOn(0,(byte)note,118);
	vu[0]=15;
}

void leadOn(int note) {
	ymNoteOff(1);
	ymNoteOn(1,(byte)note,118);
	leadNote=note;
	leadAge=0;
	vibDepth=fmFn[note-67]/180;
	vu[1]=15;
}

void leadOff() {
	ymNoteOff(1);
	leadNote=0;
}

// the YM2612 channel 1 pitch registers (A5 = block and fnum high bits, then A1 = fnum low): the lead's vibrato
void leadPitch(int dfn) {
	int i=leadNote-67;
	int fn=fmFn[i]+dfn;
	int b=fmBlk[i];
	int hiPart=fn/256;
	int lo=fn-hiPart*256;
	byte hi=(byte)(b*8+hiPart);
	ymSetReg(0,0xA5,hi);
	ymSetReg(0,0xA1,(byte)lo);
}

// the chord arpeggio: the next chord note each frame, envelope held
void arpFrame() {
	int k=chordArp[chord*3+arpStep];
	synNoteOn(1,(byte)(k+60),100);
	arpStep++;
	if(arpStep>2) arpStep=0;
}

void newChord() {
	chord=barChord[bar];
	arpStep=0;
	vu[2]=15;
}

void rowEvents() {
	if(row==0) newChord();
	int off=bassPat[row];
	if(off!=255) bass(chordBass[chord]+off);
	int d=drumPat[row];
	if(bar==16) d=fillPat[row];
	if(d!=255) drum(d);
	int v=lead[bar*16+row];
	if(v==1) leadOff();
	else if(v>1) leadOn(v);
}

void tick() {
	if(frame==0) rowEvents();
	arpFrame();
	if(leadNote>0) {
		leadAge++;
		if(leadAge>14) {                  // delayed vibrato, a triangle of 8 frames
			int ph=leadAge%8;
			int wob=ph;
			if(ph>4) wob=8-ph;
			leadPitch((wob-2)*vibDepth);
		}
	}
	frame++;
	if(frame>=SPEED) {
		frame=0;
		row++;
		if(row>15) {
			row=0;
			pos++;
			if(pos>=#song) pos=2;
			bar=song[pos];
		}
	}
}

