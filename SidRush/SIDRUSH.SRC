// the bar's top follows a sine: the bands stay where they are, their colours are rewritten (copper style), so
// nothing the raster IRQ has already latched can disagree with the new position
byte barR[16]={1,2,4,6,7,7,7,7,7,7,7,7,6,4,2,1};
byte barG[16]={0,0,1,2,4,6,7,7,7,7,6,4,2,1,0,0};
byte barB[16]={1,2,2,1,1,2,4,7,7,4,2,1,1,2,2,1};

void moveBar(int t) {
	int b0=(sine[(t/2)%64]-8)/4;
	if(b0==lastB0) return;
	int from=b0;
	int to=lastB0;
	if(lastB0<b0) {
		from=lastB0;
		to=b0;
	}
	if(lastB0<0) {
		from=0;
		to=48;
	}
	lastB0=b0;
	to=to+16;
	if(from<0) from=0;
	if(to>48) to=48;
	for(int i=from;i<to;i++) {
		int k=i-b0;
		int j=6+i*6;
		if(k>=0 && k<16) {
			list[j].val=barR[k];
			list[j+1].val=barG[k];
			list[j+2].val=barB[k];
		} else {
			list[j].val=2;
			list[j+1].val=1;
			list[j+2].val=4;
		}
	}
}

// ------------------------------------------------------------------ screen
void cell(int x,int y,int g,int c) {
	nat a=(nat)y*80+(nat)x;
	poke(0x1200+a,(byte)g);
	poke(0x1E80+a,(byte)c);
}

// the labels in a global text array (EXAMPLES/CODING/TXTARRAY.SRC), copied into a global buffer and
// read with peek: the machine refuses s[i] on a text
text labels[9]={"S I D   R U S H","a C64-style tune for the Micro-8","BASS","LEAD","ARP","DRUMS",
	"Code, Design, Music","Benoit Saint-Moulin","ESC to quit"};
text wbuf={80};
void write(int x,int y,int k,int c) {
	memSet(&wbuf,81,0);
	concat(wbuf,labels[k]);
	for(int i=0;i<80-x;i++) {
		byte g=peek(&wbuf+(nat)i);
		if(g==0) return;
		cell(x+i,y,g,c);                  // a byte widens to int by itself: (int) on a byte is refused
	}
}

int starX[8];
int starY[8];

void initStars() {
	for(int s=0;s<8;s++) {
		starX[s]=(s*23+7)%80;
		starY[s]=22+(s*5)%6;
	}
}

void drawStatic() {
	poke(0x2F00,0x10);                  // text only: the background colour (and its raster bar) behind it
	poke(0x2F0B,peek(0x2F0B)&0x7F);     // no mouse pointer during the show
	poke(backR,2);                      // C64 blue
	poke(backG,1);
	poke(backB,4);
	poke(0x1140+1,3);                   // text colour 1 = C64 light blue
	poke(0x1150+1,3);
	poke(0x1160+1,6);
	memSet(0x1200,3200,' ');
	memSet(0x1E80,3200,0x01);
	write(32,6,0,0x0B);
	write(24,9,1,0x02);
	write(22,14,2,0x09);
	write(22,16,3,0x09);
	write(22,18,4,0x09);
	write(22,20,5,0x09);
	write(30,29,6,0x07);
	write(30,30,7,0x07);
	write(34,32,8,0x07);
	initStars();
	for(int ch=0;ch<4;ch++) {
		for(int i=0;i<15;i++) cell(32+i,14+ch*2,0x7F,0x01);
	}
}

// meter zones: green 0-8, yellow 9-12, red 13-14; a level change repaints [a,b) with memSet, one call per zone
byte zoneFrom[3]={0,9,13};
byte zoneTo[3]={9,13,15};
byte zoneCol[3]={0x09,0x0B,0x0D};

void paintMeter(nat base,int a,int b,bool on) {
	for(int z=0;z<3;z++) {
		int f=zoneFrom[z];
		int e=zoneTo[z];
		if(f<a) f=a;
		if(e>b) e=b;
		if(f<e) {
			byte c=0x01;
			if(on) c=zoneCol[z];
			memSet(base+(nat)f,(nat)(e-f),c);
		}
	}
}

byte rainbow[28]={0x0D,0x0C,0x0B,0x09,0x07,0x04,0x03,0x0D,0x0D,0x0C,0x0B,0x09,0x07,0x04,0x03,0x0D,
	0x0D,0x0C,0x0B,0x09,0x07,0x04,0x03,0x0D,0x0D,0x0C,0x0B,0x09};

// parallax stars (cracktro): three slow speeds (one step every 2 to 6 frames), the nearer ones brighter
void stars(int t) {
	for(int s=0;s<8;s++) {
		int sp=1+s%3;
		if(t%(8-2*sp)==0) {
			nat a=(nat)(starY[s]*80+starX[s]);
			poke(0x1200+a,' ');
			int x=starX[s]-1;
			if(x<0) x=79;
			starX[s]=x;
			a=(nat)(starY[s]*80+x);
			byte ch='.';
			byte c=0x03;
			if(sp==2) {
				ch=':';
				c=0x07;
			}
			if(sp==3) {
				ch='*';
				c=0x0D;
			}
			poke(0x1200+a,ch);
			poke(0x1E80+a,c);
		}
	}
}

void drawFrame(int t) {
	// title colour wave, every 4 frames; the "Code, Design, Music" line takes it shifted, the name stays static
	if(t%4==0) {
		memCpy(&rainbow+(nat)((t/4)%8),0x1E80+6*80+29,21);
		memCpy(&rainbow+(nat)((t/4+3)%8),0x1E80+29*80+30,19);
	}
	// meters: only the cells between the shown level and the new one change colour
	for(int ch=0;ch<4;ch++) {
		int lvl=vu[ch];
		int old=shownVu[ch];
		if(lvl!=old) {
			int a=old;
			int b=lvl;
			if(lvl<old) {
				a=lvl;
				b=old;
			}
			nat base=0x1E80+(nat)(14+ch*2)*80+32;
			paintMeter(base,a,b,lvl>old);
			shownVu[ch]=lvl;
		}
		if(t%2==0 && vu[ch]>0) vu[ch]--;
	}
	if(t%2==1) stars(t/2);
}

// ------------------------------------------------------------------ main
setupSound();
drawStatic();
rstrInt(true);
rstrCmp(480,&list);
bar=song[0];
int t=0;
int key=getKeyDwn();
while(key!=0) key=getKeyDwn();          // the key that started the program (ENTER, ESC) must not be taken for a quit
while(key!=12) {
	tick();
	drawFrame(t);
	// the bar is moved late in the frame (on the machine around line 200, below it) and before the vSync, so the
	// raster IRQ at line 480 starts the next frame from the new positions, every band together
	moveBar(t);
	key=getKeyDwn();
	t++;
	if(t>=7680) t=0;                  // an int would turn negative after 9 minutes (and 7680 = 64 * 120: the sines keep their phase)
	synNoteOff(1);                    // arp gate low for the rest of the frame: the next frame's pitch change happens in silence
	vSync();
}
rstrInt(false);
poke(backR,5);
poke(backG,5);
poke(backB,5);
poke(0x2F00,0x11);
poke(0x2F0B,peek(0x2F0B)|0x80);
ymNoteOff(0);
ymNoteOff(1);
synNoteOff(0);
synNoteOff(1);
memSet(0x1200,3200,' ');
curPos(0,0);
print("Bye.");
